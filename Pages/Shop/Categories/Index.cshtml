@page "{id:int?}"
@model MCBusiness.Pages.Shop.Categories.IndexModel
@{
    ViewData["Title"] = Model.ParentCategory?.Name ?? "Catégories";
    var hasProducts = Model.Categories?.Any(c => c.Products?.Any() == true) == true;
}

<section class="category-hero">
    <div class="container">
        <nav class="shop-breadcrumb" aria-label="breadcrumb">
            <a asp-page="/Shop/Index">Boutique</a>
            <span>/</span>
            <span>@(Model.ParentCategory?.Name ?? "Catégorie")</span>
        </nav>
        <div class="category-title-row">
            <div>
                <h1>@(Model.ParentCategory?.Name ?? "Catégorie introuvable")</h1>
                <p>Parcourez les rayons disponibles et trouvez rapidement les produits proposés par nos vendeurs.</p>
            </div>
            <a asp-page="/Shop/Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left me-1"></i> Toutes les catégories
            </a>
        </div>
    </div>
</section>

@if (!hasProducts)
{
    <div class="container py-5">
        <div class="shop-empty">
            <i class="bi bi-folder-x"></i>
            <h2>Aucun produit disponible</h2>
            <p>Cette catégorie ne contient pas encore de produits actifs.</p>
            <a asp-page="/Shop/Index" class="btn btn-primary">Explorer la boutique</a>
        </div>
    </div>
}
else
{
    <main class="container category-content">
        @foreach (var category in Model.Categories)
        {
            var products = (category.Products ?? Enumerable.Empty<MCBusiness.Models.Product>())
                .Where(p => p.Variants?.Any() == true)
                .Take(10)
                .ToList();

            if (!products.Any())
            {
                continue;
            }

            <section class="product-row-section">
                <div class="section-header">
                    <div>
                        <span class="section-kicker">Rayon</span>
                        <h2>@category.Name</h2>
                    </div>
                    <a class="btn btn-outline-primary" asp-page="/Shop/Categories/Products/Index" asp-route-id="@category.Id">
                        Voir tous les produits <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="product-strip" data-product-strip>
                    @foreach (var product in products)
                    {
                        var variant = product.Variants.FirstOrDefault(v => v.IsAvailable && !v.IsDeleted);
                        if (variant == null)
                        {
                            continue;
                        }

                        var image = Model.Images.FirstOrDefault(img => img.ProductVariantId == variant.Id);

                        <article class="shop-product-card">
                            <a asp-page="/Shop/Categories/Products/Details/Index" asp-route-id="@product.Id">
                                <div class="product-media">
                                    <img src="@(image?.Url ?? "/image/NoProduct.jpg")" alt="@product.Name" loading="lazy">
                                </div>
                                <div class="product-body">
                                    <h3>@product.Name</h3>
                                    <div class="product-price">
                                        @if (variant.PriceSnapshot != null && variant.PriceSnapshot != variant.Price)
                                        {
                                            <span class="old-price">@variant.PriceSnapshot?.ToString("N0") @(variant.Currency?.Symbol ?? "HTG")</span>
                                        }
                                        <strong>@variant.Price.ToString("N0") @(variant.Currency?.Symbol ?? "HTG")</strong>
                                    </div>
                                    <span class="details-link">Voir détails <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            </section>
        }
    </main>
}

<style>
    .category-hero {
        background: #005fac;
        color: #fff;
        padding: 2.5rem 0;
        margin-bottom: 2rem;
    }

    .shop-breadcrumb {
        display: flex;
        gap: .5rem;
        align-items: center;
        margin-bottom: 1rem;
        color: rgba(255,255,255,.8);
    }

    .shop-breadcrumb a {
        color: #fff;
        font-weight: 700;
        text-decoration: none;
    }

    .category-title-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: end;
    }

    .category-title-row h1 {
        margin: 0 0 .5rem;
        font-weight: 800;
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: 0;
    }

    .category-title-row p {
        max-width: 720px;
        margin: 0;
        color: rgba(255,255,255,.86);
    }

    .category-content {
        padding-bottom: 3rem;
    }

    .product-row-section {
        padding: 1.75rem 0;
        border-bottom: 1px solid #edf0f2;
    }

    .section-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .section-kicker {
        color: #005fac;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .section-header h2 {
        margin: .1rem 0 0;
        font-size: 1.55rem;
        font-weight: 800;
    }

    .product-strip {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 1rem;
    }

    .shop-product-card {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        background: #fff;
        overflow: hidden;
        transition: transform .18s ease, box-shadow .18s ease;
    }

    .shop-product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
    }

    .shop-product-card a {
        color: inherit;
        text-decoration: none;
        display: block;
        height: 100%;
    }

    .product-media {
        background: #f8f9fa;
        aspect-ratio: 1 / .82;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: .75rem;
    }

    .product-media img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-body {
        padding: .9rem;
    }

    .product-body h3 {
        font-size: .98rem;
        font-weight: 800;
        min-height: 2.4rem;
        margin-bottom: .65rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-price {
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .old-price {
        color: #dc3545;
        text-decoration: line-through;
        font-size: .88rem;
    }

    .product-price strong {
        color: #005fac;
        font-size: 1.05rem;
    }

    .details-link {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        margin-top: .7rem;
        color: #495057;
        font-size: .9rem;
        font-weight: 700;
    }

    .shop-empty {
        text-align: center;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 4rem 1rem;
    }

    .shop-empty i {
        color: #005fac;
        font-size: 3rem;
    }

    @@media (max-width: 767.98px) {
        .category-hero {
            padding: 1.75rem 0;
            margin-bottom: 1rem;
        }

        .category-title-row h1 {
            font-size: 1.8rem;
            line-height: 1.12;
        }

        .category-title-row,
        .section-header {
            flex-direction: column;
            align-items: start;
        }

        .category-title-row .btn,
        .section-header .btn {
            width: 100%;
        }

        .product-row-section {
            padding: 1.25rem 0;
        }

        .product-strip {
            display: flex;
            gap: .75rem;
            overflow-x: auto;
            padding-bottom: .35rem;
            scroll-snap-type: x proximity;
        }

        .shop-product-card {
            flex: 0 0 72%;
            min-width: 220px;
            scroll-snap-align: start;
        }

        .product-body {
            padding: .8rem;
        }
    }

    @@media (max-width: 420px) {
        .shop-product-card {
            flex-basis: 84%;
        }
    }
</style>
