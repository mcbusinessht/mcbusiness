@page "{id:int?}"
@model MCBusiness.Pages.Shop.Categories.Products.IndexModel
@{
    ViewData["Title"] = Model.Category?.Name ?? "Produits";
    var visibleProducts = Model.Products
        .Where(p => p.Variants?.Any(v => v.IsAvailable && !v.IsDeleted) == true)
        .ToList();
}

<section class="products-hero">
    <div class="container">
        <nav class="shop-breadcrumb" aria-label="breadcrumb">
            <a asp-page="/Shop/Index">Boutique</a>
            <span>/</span>
            <span>@(Model.Category?.Name ?? "Produits")</span>
        </nav>
        <div class="products-heading">
            <div>
                <h1>@Model.Category.Name</h1>
                <p>@visibleProducts.Count produit(s) disponible(s) dans ce rayon.</p>
            </div>
            <a asp-page="/Shop/Index" class="btn btn-outline-light">
                <i class="bi bi-grid me-1"></i> Toutes les catégories
            </a>
        </div>
    </div>
</section>

<main class="container products-page">
    @if (visibleProducts.Any())
    {
        <div class="toolbar">
            <div>
                <strong>@visibleProducts.Count</strong>
                <span>résultat(s)</span>
            </div>
            <form method="get" action="/Search" class="toolbar-search">
                <input type="search" name="query" class="form-control" placeholder="Rechercher dans la boutique">
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
            </form>
        </div>

        <div class="products-grid">
            @foreach (var product in visibleProducts)
            {
                var firstVariant = product.Variants.First(v => v.IsAvailable && !v.IsDeleted);
                var hasImage = Model.VariantImages.TryGetValue(firstVariant.Id, out var image);

                <article class="product-card">
                    <a asp-page="/Shop/Categories/Products/Details/Index" asp-route-id="@product.Id">
                        <div class="product-image-wrap">
                            <img src="@(hasImage ? image.Url : "/image/NoProduct.jpg")"
                                 alt="@product.Name"
                                 loading="lazy">
                        </div>
                        <div class="product-info">
                            <h2>@product.Name</h2>
                            @if (firstVariant.Currency != null)
                            {
                                <div class="price-line">
                                    @if (firstVariant.PriceSnapshot != null && firstVariant.PriceSnapshot != firstVariant.Price)
                                    {
                                        <span>@firstVariant.PriceSnapshot?.ToString("N0") @firstVariant.Currency.Symbol</span>
                                    }
                                    <strong>@firstVariant.Price.ToString("N0") @firstVariant.Currency.Symbol</strong>
                                </div>
                            }
                            <div class="product-meta">
                                <span><i class="bi bi-box-seam"></i> Disponible</span>
                                <span><i class="bi bi-arrow-right"></i> Détails</span>
                            </div>
                        </div>
                    </a>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-bag-x"></i>
            <h2>Aucun produit disponible</h2>
            <p>Ce rayon ne contient pas encore de produit actif.</p>
            <a asp-page="/Shop/Index" class="btn btn-primary">Retour à la boutique</a>
        </div>
    }
</main>

<style>
    .products-hero {
        background: #005fac;
        color: #fff;
        padding: 2.5rem 0;
        margin-bottom: 1.5rem;
    }

    .shop-breadcrumb {
        display: flex;
        align-items: center;
        gap: .5rem;
        color: rgba(255,255,255,.78);
        margin-bottom: 1rem;
    }

    .shop-breadcrumb a {
        color: #fff;
        text-decoration: none;
        font-weight: 700;
    }

    .products-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 1rem;
    }

    .products-heading h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        margin: 0 0 .4rem;
        letter-spacing: 0;
    }

    .products-heading p {
        margin: 0;
        color: rgba(255,255,255,.85);
    }

    .products-page {
        padding-bottom: 3rem;
    }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: .9rem 0;
        border-bottom: 1px solid #e9ecef;
    }

    .toolbar span {
        color: #6c757d;
    }

    .toolbar-search {
        display: flex;
        gap: .5rem;
        max-width: 420px;
        width: 100%;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
    }

    .product-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        overflow: hidden;
        transition: transform .18s ease, box-shadow .18s ease;
    }

    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
    }

    .product-card a {
        display: block;
        color: inherit;
        text-decoration: none;
        height: 100%;
    }

    .product-image-wrap {
        aspect-ratio: 1 / .86;
        background: #f8f9fa;
        padding: .85rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image-wrap img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-info {
        padding: 1rem;
    }

    .product-info h2 {
        font-size: 1rem;
        font-weight: 800;
        min-height: 2.5rem;
        margin-bottom: .75rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .price-line {
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .price-line span {
        color: #dc3545;
        text-decoration: line-through;
        font-size: .88rem;
    }

    .price-line strong {
        color: #005fac;
        font-size: 1.12rem;
    }

    .product-meta {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        margin-top: .85rem;
        color: #6c757d;
        font-size: .85rem;
        font-weight: 700;
    }

    .empty-state {
        text-align: center;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 4rem 1rem;
    }

    .empty-state i {
        color: #005fac;
        font-size: 3rem;
    }

    @@media (max-width: 767.98px) {
        .products-hero {
            padding: 1.75rem 0;
            margin-bottom: 1rem;
        }

        .products-heading,
        .toolbar {
            flex-direction: column;
            align-items: start;
        }

        .products-heading h1 {
            font-size: 1.8rem;
            line-height: 1.12;
        }

        .products-heading .btn,
        .toolbar-search,
        .toolbar-search .form-control {
            width: 100%;
        }

        .toolbar {
            padding: .75rem 0;
        }

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .75rem;
        }

        .product-image-wrap {
            padding: .6rem;
        }

        .product-info {
            padding: .75rem;
        }

        .product-info h2 {
            font-size: .92rem;
            min-height: 2.35rem;
        }

        .price-line strong {
            font-size: 1rem;
        }

        .product-meta {
            flex-direction: column;
            gap: .25rem;
            margin-top: .6rem;
        }
    }

    @@media (max-width: 360px) {
        .products-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
