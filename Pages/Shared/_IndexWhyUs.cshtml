@model IndexModel

<!-- Pourquoi nous choisir Section -->
<section class="why-choose-us-section py-5 bg-white">
    <div class="container">
        <div class="section-header text-center mb-5">
            <h6 class="section-subtitle">POURQUOI MC Business</h6>
            <h2 class="section-title">Votre succès, notre priorité</h2>
            <p class="section-description">Découvrez ce qui fait de MC Business votre partenaire de confiance</p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="why-card text-center">
                    <div class="why-icon">
                        <i class="bi bi-shield-check text-success"></i>
                    </div>
                    <h4 class="why-title">Sécurité Garantie</h4>
                    <p class="why-text">Paiements sécurisés et protection des données personnelles</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="why-card text-center">
                    <div class="why-icon">
                        <i class="bi bi-lightning-charge text-warning"></i>
                    </div>
                    <h4 class="why-title">Livraison Rapide</h4>
                    <p class="why-text">Expédition sous 24h partout en Haïti</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="why-card text-center">
                    <div class="why-icon">
                        <i class="bi bi-cash-coin text-success"></i>
                    </div>
                    <h4 class="why-title">Revenus Passifs</h4>
                    <p class="why-text">Gagnez des commissions en tant qu'ambassadeur</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="why-card text-center">
                    <div class="why-icon">
                        <i class="bi bi-headset text-primary"></i>
                    </div>
                    <h4 class="why-title">Support 24/7</h4>
                    <p class="why-text">Équipe dédiée pour vous accompagner</p>
                </div>
            </div>
        </div>
    </div>
</section>
