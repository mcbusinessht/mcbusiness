@* _Layout.cshtml *@
@using MCBusiness.Services
@using MCBusiness.Models
@using Microsoft.AspNetCore.Identity
@inject NoticeService NoticeService
@inject SignInManager<ApplicationUser> signIn
@inject UserManager<ApplicationUser> userManager

@{
    var annonce = await NoticeService.GetAnnonceAsync();
    var cartItemsCount = 0;  
    var messagesCount =0;
    var notificationsCount =0;
    DateTimeOffset? lastVisit = null;
    
    if (signIn.IsSignedIn(User))
    {
        var userId = userManager.GetUserId(User);
        lastVisit = await NoticeService.GetLastVisitAsync(userId);
        cartItemsCount = await NoticeService.GetCartCountAsync(userId);
        messagesCount = await NoticeService.GetMessageCountAsync(userId);
        notificationsCount = await NoticeService.GetNotificationCountAsync(userId);
    }
}


