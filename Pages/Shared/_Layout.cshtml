<script>
    
    //Pour le formulaire de recherche
    document.getElementById('searchInput').addEventListener('input', async function(e) {
        const query = e.target.value;
        if(query.length < 2) return;
        
        const response = await fetch(`/api/search/suggestions?query=${encodeURIComponent(query)}`);
        const suggestions = await response.json();
        
        const container = document.getElementById('searchSuggestions');
        container.innerHTML = suggestions.map(s => `
            <a href="/Search?query=${encodeURIComponent(s)}" 
            class="d-block p-2 text-decoration-none text-dark">
                ${s}
            </a>
        `).join('');
        
        container.classList.toggle('d-none', suggestions.length === 0);
    });

        // Géolocalisation améliorée                           
    
</script>
<script>  
    
    // Géolocalisation améliorée
function updateAddress(position) {
    const addressElement = document.querySelector('.address-text');
    const addressElement2 = document.querySelector('.address-text-2');
    
    if (!position) { 
        addressElement.textContent = 'Haïti';
        addressElement2.textContent = 'Haïti';
        return;
    }

    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${position.coords.latitude}&lon=${position.coords.longitude}`, {
        headers: {
            'User-Agent': 'MCBusiness/1.0 (contact@MCBusinessht.com)' // Nécessaire pour l'API Nominatim
        }
    })
    .then(response => {
        if (!response.ok) throw new Error('Erreur réseau');
        return response.json();
    })
    .then(data => {
        const address = data.address || {};
        const ville = address.city || address.town || address.village || address.county;
        const pays = address.country || 'Haïti';
        
        const texteAdresse = ville ? `${ville}, ${pays}` : pays;
        
        addressElement.textContent = texteAdresse;
        addressElement2.textContent = texteAdresse;
    })
    .catch(error => {
        console.error('Erreur:', error);
        addressElement.textContent = 'Haïti';
        addressElement2.textContent = 'Haïti';
    });
}

function handleLocationError(error) {
    console.error('Erreur de géolocalisation:', error);
    const message = error.code === error.PERMISSION_DENIED 
        ? 'Géolocalisation désactivée' 
        : 'Haiti';
    
    document.querySelectorAll('.address-text, .address-text-2').forEach(el => {
        el.textContent = message;
    });
}

if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
        position => updateAddress(position),
        handleLocationError,
        { 
            timeout: 10000, // Augmentation du timeout
            maximumAge: 600000, // 10 minutes
            enableHighAccuracy: true
        }
    );
} else {
    handleLocationError(new Error('Géolocalisation non supportée'));
}                                                                                          
    // Gestion de la recherche
    document.querySelectorAll('form[action="/Search"]').forEach(form => {
        form.addEventListener('submit', function(e) {
            const query = this.querySelector('input').value.trim();
            if (!query) e.preventDefault();                           
        });
    });

    // Dans _Layout.cshtml
    //alert(getLocation());
    // Marquer l'onglet actif selon la page actuelle
    document.addEventListener('DOMContentLoaded', () => {
        const currentPage = window.location.pathname.split('/').pop();
        const links = document.querySelectorAll('.nav-link');
        links.forEach(link => {
            if (link.getAttribute('href') === currentPage) {
                link.classList.add('active');
            }
        });
    });

