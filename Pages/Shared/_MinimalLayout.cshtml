<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="@ViewData["Keywords"]" />
    
    <!-- Balises Open Graph pour le partage sur les réseaux sociaux -->
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:type" content="website" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MC Business</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode-mcbusiness-premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MCBusiness_Beta1._0.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="icon" href="@Url.Content("~/favicon.png")"   sizes="32x32" style="width: 100%;">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Creepster&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="path/to/font-awesome/css/font-awesome.min.css">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init();
    </script>
    <meta property="og:image" content="https://MCBusinessht.com/favicon.ico">
    <meta name="theme-color" content="#ffffff">
    <meta name="google-site-verification" content="UL7E4hfVVIw5lY27JxiQ926CggGOZFi0_x_0gNybRr4" />
    <!-- other head elements -->
    @RenderSection("Styles", required: false)
    @await RenderSectionAsync("Head", required: false)
    <style>
        *
        {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        header{
            box-shadow: 0 10px 10px rgba(0, 0, 0, 0.3);
            z-index: 1000;

        }
        html, body {
            height: 100%;
            }
            .wrapper {
            min-height: 100%;
            display: flex;
            flex-direction: column;
            }
            .content {
            flex: 1;
            }
        .nav-1{
            background-color: #8e8a8a ;
        }
        .nav-item{
            margin-right: 20px !important;
        }
        .top-icon{
            margin: 10px 40px 10px 0;
            color: #5dab31 !important;

        }
        .top-icon:hover{
            color: #005fac !important;
        }
        .nav-linkF:hover{
            color: #5dab31 !important;
        }
        .btn-yello{
            background-color: #5dab31 !important;
            border-radius: 10px;
            color: #8e8a8a !important;
            padding: 5px !important;
        }
        .btn-yello:hover{
            box-shadow: 5px 5px 3px rgba(0, 0, 0, 0.3);
            background-color: #8e8a8a !important;
            color: #5dab31 !important;
            margin-bottom: 5px !important;

        }
        .btn-bleu{
            background-color: #005fac;
            border-radius: 10px;
            color: #8e8a8a !important;
            padding: 5px !important;
        }
        .btn-bleu:hover{
            box-shadow: 3px 3px 2px rgba(0, 0, 0, 0.3);
            background-color: #8e8a8a;
            color: #005fac !important;
        }
        .footer{
            background-color: #005fac !important;
            min-height: 30vh;
            display: flex;
            text-align: center;
            padding-top: 30px;
            padding-bottom: 20px;

        }
        .dropdown-item:hover{
            background-color:#005fac !important;
            color: #fff;
        }
        .dropdown-menu {
            left: 50%;
            transform: translateX(-25%);
        }
    </style>
</head>
<body class="wrapper m-0 p-0 w-100">
    <a href="/Index" style="width: 120px" class="flex-start btn btn-primary m-3"><i class="bi bi-arrow-return-left"></i> Acceuil</a>
    
    <div class="container-fluid pt-3 ml-auto content">  
        @RenderBody()
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dark-mode.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
  
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>