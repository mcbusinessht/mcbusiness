@model IndexModel

<section class="seller-cta-section py-5">
    <div class="container">
        <div class="seller-cta">
            <div>
                <h2>Vous vendez déjà ? Ouvrez votre boutique sur MC Business.</h2>
                <p>Publiez vos produits, recevez des commandes et profitez d'une plateforme qui gère paiement, visibilité et suivi.</p>
            </div>
            <div class="seller-cta-actions">
                <a asp-page="/Users/Seller/Index" class="btn btn-warning btn-lg">
                    <i class="bi bi-bag-plus me-2"></i>Commencer à vendre
                </a>
                <a asp-page="/Companies/Index" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-shop-window me-2"></i>Voir les boutiques
                </a>
            </div>
        </div>
    </div>
</section>
