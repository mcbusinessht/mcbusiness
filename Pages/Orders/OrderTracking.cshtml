@page
@model MCBusiness.Pages.Orders.OrderTrackingModel
@{
    ViewData["Title"] = "Suivi de commande";
}

<div class="container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            

            @if (Model.Order != null)
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0">
                        <i class="bi bi-receipt me-2"></i>Commande #@Model.Order.Id
                    </h1>
                    <span class="badge bg-@Model.GetStatusBadgeClass(Model.Order.Status)">
                        @Model.Order.Status
                    </span>
                </div>

                @if (Model.CanConfirmReceipt())
                {
                    <div class="alert alert-success border-success d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" role="alert">
                        <div>
                            <h2 class="h5 mb-1">
                                <i class="bi bi-check2-circle me-2"></i>Confirmer la reception de votre commande
                            </h2>
                            <p class="mb-0">
                                Cette commande est marquee comme livree. Confirmez la reception si vous avez bien recu tous les produits.
                            </p>
                        </div>
                        <form method="post" asp-page-handler="ConfirmDelivery" asp-route-id="@Model.Order.Id"
                              onsubmit="return confirm('Confirmer la reception de cette commande ?');">
                            <button type="submit" class="btn btn-success btn-lg text-nowrap">
                                <i class="bi bi-check-circle me-2"></i>J'ai recu ma commande
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Order.IsReceived)
                {
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Reception de la commande deja confirmee.</span>
                    </div>
                }
            }
        </div>
    </div>

    @if (Model.Order == null)
    {
        <div class="alert alert-warning">
            Commande introuvable ou vous n'avez pas l'autorisation de la consulter.
        </div>
    }
    else
    {
        <div class="row">
            <!-- Détails de la commande -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h2 class="h5 mb-0">
                            <i class="bi bi-box-seam me-2"></i>Produits commandés
                        </h2>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @using MCBusiness.Models;

                            @foreach (var item in Model.Order.Products ?? Enumerable.Empty<OrderProduct>())
                            {
                                var canReturn = item.Status == OrderProductStatus.Delivered && 
                                              item.Shipment?.DeliveryDate != null &&
                                              (DateTimeOffset.UtcNow - item.Shipment.DeliveryDate.Value.ToUniversalTime()).TotalDays <= 7;
                                
                                <div class="list-group-item">
                                    <div class="row align-items-center">
                                        <div class="col-md-2">
                                            @{
                                                var imageUrl = "/images/placeholder.png";
                                                if (item.ProductVariant?.Images?.Any() == true)
                                                {
                                                    imageUrl = item.ProductVariant.Images.First().Url ?? imageUrl;
                                                }
                                            }
                                            <img src="@imageUrl" 
                                                 class="img-fluid rounded" 
                                                 alt="@item.ProductVariant?.Product?.Name">
                                        </div>
                                        <div class="col-md-6">
                                            <h5 class="mb-1">@item.ProductVariant?.Product?.Name</h5>
                                            <small class="text-muted">SKU: @item.ProductVariant?.Sku</small>
                                            <div class="mt-2">
                                                @if (item.Status != null)
                                                {
                                                    <span class="badge bg-@Model.GetProductStatusBadgeClass(item.Status)">
                                                        @item.Status
                                                    </span>
                                                }
                                                @if (item.Shipment != null)
                                                {
                                                    <span class="badge bg-light text-dark ms-2">
                                                        <i class="bi bi-truck"></i> @item.Shipment.Status
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <span class="d-block">@item.Quantity × @item.PriceAtOrder.ToString("C")</span>
                                            <strong>@((item.Quantity * item.PriceAtOrder).ToString("C"))</strong>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            @if (canReturn)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#returnModal"
                                                        data-product-id="@item.Id"
                                                        data-product-name="@item.ProductVariant?.Product?.Name">
                                                    <i class="bi bi-arrow-return-left"></i> Retour
                                                </button>
                                            }
                                            else if (item.Status == OrderProductStatus.Delivered)
                                            {
                                                <small class="text-muted">Délai de retour expiré</small>
                                            }
                                        </div>
                                    </div>
                                    
                                    @if (item.Shipment != null)
                                    {
                                        <div class="mt-3 pt-3 border-top">
                                            <h6 class="mb-2">
                                                <i class="bi bi-truck"></i> Suivi de livraison
                                            </h6>
                                            <div class="tracking-progress">
                                                <div class="steps">
                                                    <div class="step @(item.Shipment.Status >= ShipmentStatus.Pending ? "active" : "")">
                                                        <span class="step-icon"><i class="bi bi-cart"></i></span>
                                                        <span class="step-text">Commandé</span>
                                                        <span class="step-date">@LocalTime.Format(Model.Order.OrderDate, "dd MMM yyyy")</span>
                                                    </div>
                                                    <div class="step @(item.Shipment.Status >= ShipmentStatus.InTransit ? "active" : "")">
                                                        <span class="step-icon"><i class="bi bi-truck"></i></span>
                                                        <span class="step-text">Expédié</span>
                                                        <span class="step-date">@LocalTime.Format(item.Shipment.ShippingDate, "dd MMM yyyy")</span>
                                                    </div>
                                                    <div class="step @(item.Shipment.Status >= ShipmentStatus.Delivered ? "active" : "")">
                                                        <span class="step-icon"><i class="bi bi-check-circle"></i></span>
                                                        <span class="step-text">Livré</span>
                                                        @if (item.Shipment.DeliveryDate != null)
                                                        {
                                                            <span class="step-date">@LocalTime.Format(item.Shipment.DeliveryDate.Value, "dd MMM yyyy")</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            @if (!string.IsNullOrEmpty(item.Shipment.TrackingNumber))
                                            {
                                                <div class="mt-2">
                                                    <strong>Numéro de suivi :</strong> 
                                                    <a href="https://tracking.carrier.com/@item.Shipment.TrackingNumber" target="_blank">
                                                        @item.Shipment.TrackingNumber <i class="bi bi-box-arrow-up-right"></i>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Résumé de la commande -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h2 class="h5 mb-0">
                            <i class="bi bi-info-circle me-2"></i>Résumé de la commande
                        </h2>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-6">Date de commande</dt>
                            <dd class="col-sm-6">@LocalTime.Format(Model.Order.OrderDate, "f")</dd>
                            
                            <dt class="col-sm-6">Statut</dt>
                            <dd class="col-sm-6">
                                <span class="badge bg-@Model.GetStatusBadgeClass(Model.Order.Status)">
                                    @Model.Order.Status
                                </span>
                            </dd>
                            
                            @if (Model.Order.Payment != null)
                            {
                                <dt class="col-sm-6">Méthode de paiement</dt>
                                <dd class="col-sm-6">@Model.Order.Payment.PaymentMethod</dd>
                            }
                        </dl>
                        
                        <hr>
                        
                        <h5 class="mb-3">Adresse de livraison</h5>
                        @if (Model.Order.Address != null)
                        {
                            <address>
                                @if (!string.IsNullOrEmpty(Model.Order.Address?.FullAddress))
                                {
                                    @Model.Order.Address.FullAddress<br>
                                }
                            </address>
                        }
                        else
                        {
                            <p class="text-muted">Adresse non disponible</p>
                        }
                        
                        <hr>
                        
                        <h5 class="mb-3">Total</h5>
                        <dl class="row">
                            <dt class="col-sm-6">Sous-total</dt>
                            <dd class="col-sm-6">@Model.Order.Products.Sum(p => p.Quantity * p.PriceAtOrder).ToString("N0") HTG</dd>
                            
                            <dt class="col-sm-6">Livraison</dt>
                            <dd class="col-sm-6">@Model.Order.ShippingTotal.ToString("N0") HTG</dd>
                            <dt class="col-sm-6">Total</dt>
                            <dd class="col-sm-6 fw-bold">@Model.Order.GrandTotal.ToString("N0") HTG</dd>
                        </dl>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-header bg-light">
                        <h2 class="h5 mb-0">
                            <i class="bi bi-headset me-2"></i>Aide
                        </h2>
                    </div>
                    <div class="card-body">
                        <p>Pour toute question concernant votre commande, contactez notre service client.</p>
                        <a href="mailto:support@MCBusiness.com" class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-envelope me-2"></i>Envoyer un email
                        </a>
                        <a href="tel:+@Model.PhoneNumber" class="btn btn-outline-primary w-100">
                            <i class="bi bi-telephone me-2"></i>Appeler le support
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal de retour -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="returnModalLabel">Demande de retour</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="RequestReturn">
                <input type="hidden" id="returnProductId" name="ProductId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="returnReason" class="form-label">Raison du retour</label>
                        <select class="form-select" id="returnReason" name="Reason" required>
                            <option value="">Sélectionnez une raison</option>
                            <option value="Defective">Produit défectueux</option>
                            <option value="WrongItem">Mauvais produit reçu</option>
                            <option value="NotAsDescribed">Ne correspond pas à la description</option>
                            <option value="Other">Autre raison</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="returnDetails" class="form-label">Détails supplémentaires</label>
                        <textarea class="form-control" id="returnDetails" name="Details" rows="3"></textarea>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Notre équipe vous contactera pour organiser le retour.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">Soumettre la demande</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .tracking-progress {
            position: relative;
            padding-left: 45px;
        }
        
        .tracking-progress .steps {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .tracking-progress .step {
            position: relative;
            padding-bottom: 20px;
        }
        
        .tracking-progress .step:not(:last-child):before {
            content: "";
            position: absolute;
            left: -30px;
            top: 15px;
            height: calc(100% - 15px);
            width: 2px;
            background-color: #dee2e6;
        }
        
        .tracking-progress .step.active:not(:last-child):before {
            background-color: #0d6efd;
        }
        
        .tracking-progress .step-icon {
            position: absolute;
            left: -40px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background-color: #dee2e6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: white;
        }
        
        .tracking-progress .step.active .step-icon {
            background-color: #0d6efd;
        }
        
        .tracking-progress .step-text {
            font-weight: 500;
        }
        
        .tracking-progress .step-date {
            display: block;
            font-size: 0.8rem;
            color: #6c757d;
        }

        @@media (max-width: 767.98px) {
            .container {
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .card {
                border-radius: .5rem;
            }

            .card-body .row.align-items-center {
                gap: .75rem;
            }

            .card-body .row.align-items-center > [class*="col-md-"] {
                text-align: left !important;
            }

            .card-body .row.align-items-center img {
                max-height: 120px;
                object-fit: contain;
                background: #f8f9fa;
            }

            dl.row dt,
            dl.row dd {
                width: 50%;
                margin-bottom: .5rem;
            }

            .modal-footer {
                display: grid;
                grid-template-columns: 1fr;
            }

            .modal-footer .btn {
                width: 100%;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var returnModal = document.getElementById('returnModal');
            if (returnModal) {
                returnModal.addEventListener('show.bs.modal', function(event) {
                    var button = event.relatedTarget;
                    var productId = button.getAttribute('data-product-id');
                    var productName = button.getAttribute('data-product-name');
                    
                    document.getElementById('returnProductId').value = productId;
                    document.getElementById('returnModalLabel').textContent = 
                        'Demande de retour - ' + productName;
                });
            }
        });
    </script>
}
