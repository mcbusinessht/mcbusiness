@page "{id:int?}"
@model MCBusiness.Pages.Orders.OrderDetailsModel
@using MCBusiness.Models
@{
    ViewData["Title"] = "Détails de la commande";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Commande #@Model.Order.Id</h2>
        <span class="badge @GetStatusBadgeClass(Model.Order.Status)">
            @Model.Order.Status
        </span>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary">
                    <h5 class="mb-0">Articles</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.Order.Products)
                    {
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                            <div>
                                <h6>@item.ProductVariant.Product.Name</h6>
                                <small class="text-muted">
                                    @foreach (var ch in item.ProductVariant.ProductVariantCharacteristics)
                                    {
                                        @ch.Characteristic.Name<text>: </text>@ch.CharacteristicValue.Value<text> </text>
                                    }
                                </small>
                                <div>Quantité : @item.Quantity</div>
                            </div>
                            <div class="text-end">
                                <div>@(item.Quantity * item.PriceAtOrder) HTG</div>
                                <small class="text-muted">@item.PriceAtOrder HTG/unité</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4 sticky-top">
            <div class="card mb-4 ">
                <div class="card-header bg-primary">
                    <h5 class="mb-0">Récapitulatif</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Adresse de livraison</h6>
                        <p>
                            @Model.Order.Address.Line1<br>
                            @Model.Order.Address.City, @Model.Order.Address.State<br>
                            @Model.Order.Address.Country<br>
                            @Model.Order.Address.ZipCode
                        </p>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Sous-total</span>
                        <span>@Model.Order.Products.Sum(p => p.Quantity * p.PriceAtOrder) HTG</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Livraison</span>
                        <span>Gratuite</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total</span>
                        <span>@Model.Order.TotalAmount HTG</span>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                @if (Model.Order.Status == OrderStatus.Pending)
                {
                    <a asp-page="/Payments/Payment" asp-route-type="order" asp-route-id="@Model.Order.Id" class="btn btn-success">
                        <i class="bi bi-credit-card"></i> Payer la commande
                    </a>
                }

                @if (Model.Order.Status == OrderStatus.Pending || Model.Order.Status == OrderStatus.Paid)
                {
                    <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Annuler cette commande ?');">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-x-circle"></i> Annuler la commande
                        </button>
                    </form>
                }

                <a asp-page="/Orders/MyOrders" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour aux commandes
                </a>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Paid => "bg-info text-white",
            OrderStatus.Shipped => "bg-primary text-white",
            OrderStatus.Delivered => "bg-success text-white",
            OrderStatus.Cancelled => "bg-secondary text-white",
            _ => "bg-light text-dark"
        };
    }
}