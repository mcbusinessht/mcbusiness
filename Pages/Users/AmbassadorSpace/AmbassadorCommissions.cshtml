@page
@using MCBusiness.Models
@model MCBusiness.Pages.Users.AmbassadorSpace.AmbassadorCommissionsModel
@{
    ViewData["Title"] = "Mes Commissions Ambassadeur";
}
<div class="container-fluid px-4">
    <div class="row">
        <div class="col-lg-3 d-none d-lg-block">
            <div class="bg-white shadow-sm rounded-3 p-3 sticky-top" style="top:1rem">
                <partial name="_AmbassadorSidebarPartial" />
            </div>
        </div>
        <div class="col-lg-9">
    @* <partial name="_AmbassadorSidebarPartial" /> *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-success fw-bold">
                <i class="bi bi-cash-coin me-2"></i>Mes Commissions Ambassadeur
            </h1>
            <p class="text-muted">Suivez vos commissions en temps réel</p>
        </div>
        <div>
            <a class="btn btn-outline-secondary" href="/Users/AmbassadorSpace/Dashboard">
                <i class="bi bi-arrow-left me-2"></i>Retour au Dashboard
            </a>
        </div>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-primary">
                <div class="card-body text-center">
                    <div class="text-muted">Total</div>
                    <div class="h4 text-primary" id="statTotal">--</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body text-center">
                    <div class="text-muted">En attente</div>
                    <div class="h4 text-warning" id="statPending">--</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-info">
                <div class="card-body text-center">
                    <div class="text-muted">Disponibles</div>
                    <div class="h4 text-info" id="statApproved">--</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm border-success">
                <div class="card-body text-center">
                    <div class="text-muted">Payées</div>
                    <div class="h4 text-success" id="statPaid">--</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Évolution mensuelle (12 mois)</h6>
                    <small class="text-muted" id="lastUpdated">--</small>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" height="90"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and list -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex gap-2 align-items-center">
                    <h6 class="mb-0"><i class="bi bi-list-check me-2"></i>Détails des commissions</h6>
                    <select class="form-select form-select-sm w-auto ms-auto" id="filterStatus">
                        <option value="">Tous statuts</option>
                        <option value="Pending">En attente</option>
                        <option value="Available">Disponible</option>
                        <option value="Paid">Payée</option>
                        <option value="Rejected">Rejetée</option>
                    </select>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Commande</th>
                                    <th>Niveau</th>
                                    <th>Montant</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody id="commissionsBody">
                                <tr><td colspan="5" class="text-center text-muted">Chargement...</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <nav class="mt-2 d-flex justify-content-center">
                        <ul class="pagination pagination-sm" id="pager"></ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
        </div>
    </div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
let monthlyChart;
let currentPage = 1;
let currentStatus = '';

function fmt(n){ return (n||0).toLocaleString('fr-HT',{maximumFractionDigits:2}); }

async function loadSummary(){
    const res = await fetch(window.location.pathname + '?handler=Summary');
    if(!res.ok) return;
    const data = await res.json();
    document.getElementById('statTotal').textContent = fmt(data.total) + ' HTG';
    document.getElementById('statPending').textContent = fmt(data.pending) + ' HTG';
    document.getElementById('statApproved').textContent = fmt(data.approved) + ' HTG';
    document.getElementById('statPaid').textContent = fmt(data.paid) + ' HTG';
    document.getElementById('lastUpdated').textContent = 'MAJ: ' + new Date().toLocaleString();

    const labels = data.months.map(m => m.label);
    const values = data.months.map(m => m.amount);
    const ctx = document.getElementById('monthlyChart');
    if(monthlyChart){ monthlyChart.destroy(); }
    monthlyChart = new Chart(ctx, {
        type: 'line',
        data: { labels, datasets: [{ label: 'HTG', data: values, borderColor:'#198754', backgroundColor:'rgba(25,135,84,0.15)', tension: .3, fill:true }]},
        options: { responsive: true, maintainAspectRatio:false, scales:{ y:{ beginAtZero:true }}}
    });
}

async function loadList(page=1){
    const url = new URL(window.location.origin + window.location.pathname);
    url.searchParams.set('handler','List');
    url.searchParams.set('page', page);
    if(currentStatus) url.searchParams.set('status', currentStatus);

    const res = await fetch(url, { cache:'no-cache' });
    const data = await res.json();

    const tbody = document.getElementById('commissionsBody');
    if(!data.items || data.items.length === 0){
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Aucune commission</td></tr>';
    } else {
        tbody.innerHTML = data.items.map(x => `
            <tr>
                <td>${new Date(x.createdAt).toLocaleString()}</td>
                <td>#${x.orderId ?? '-'} </td>
                <td>${x.level ?? 1}</td>
                <td class="text-end fw-semibold text-success">${fmt(x.amount)} HTG</td>
                <td><span class="badge ${badge(x.status)}">${x.status}</span></td>
            </tr>`).join('');
    }

    // pager
    const pager = document.getElementById('pager');
    let html = '';
    for(let p=1;p<=data.totalPages;p++){
        html += `<li class="page-item ${p===data.page?'active':''}"><a class="page-link" href="#" onclick="currentPage=${p}; loadList(${p}); return false;">${p}</a></li>`;
    }
    pager.innerHTML = html;
}

function badge(s){
    switch((s||'').toLowerCase()){
        case 'pending': return 'bg-warning-subtle text-warning border';
        case 'approved': return 'bg-info-subtle text-info border';
        case 'available': return 'bg-info-subtle text-info border';
        case 'paid': return 'bg-success';
        case 'rejected': return 'bg-danger';
        default: return 'bg-secondary';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    loadSummary();
    loadList(1);
    document.getElementById('filterStatus').addEventListener('change', (e)=>{ currentStatus = e.target.value; loadList(1); });
    // rafraîchissement léger
    setInterval(loadSummary, 30000);
});
</script>
