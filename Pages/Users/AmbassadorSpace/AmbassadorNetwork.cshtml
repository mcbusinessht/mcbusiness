@page
@model MCBusiness.Pages.Users.AmbassadorSpace.AmbassadorNetworkModel
@{
    ViewData["Title"] = "Mon Réseau";
}
<div class="container-fluid px-4">
    <div class="row">
        <div class="col-lg-3 d-none d-lg-block">
            <div class="bg-white shadow-sm rounded-3 p-3 sticky-top" style="top:1rem">
                <partial name="_AmbassadorSidebarPartial" />
            </div>
        </div>
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h4 text-success mb-0"><i class="bi bi-people me-2"></i>Mon Réseau</h1>
                @* <partial name="_AmbassadorSidebarPartial" /> *@
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-primary h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-person-plus text-primary display-6"></i>
                            <div class="text-muted mt-2">Génération 1</div>
                            <div class="h4 text-primary">@Model.Generation1Count</div>
                            <small class="text-muted">Filleuls directs</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-info h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-people text-info display-6"></i>
                            <div class="text-muted mt-2">Génération 2</div>
                            <div class="h4 text-info">@Model.Generation2Count</div>
                            <small class="text-muted">Filleuls de niveau 2</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-diagram-3 text-success display-6"></i>
                            <div class="text-muted mt-2">Génération 3</div>
                            <div class="h4 text-success">@Model.Generation3Count</div>
                            <small class="text-muted">Filleuls de niveau 3</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Génération 1 -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-people me-2"></i>Filleuls directs (Génération 1)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Generation1Users.Any())
                    {
                        <div class="row g-3">
                            @foreach (var user in Model.Generation1Users)
                            {
                                <div class="col-lg-6">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                                    <i class="bi bi-person text-primary"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold">@user.DisplayName</div>
                                                    <div class="small text-muted">@user.Email</div>
                                                    <div class="small">Inscrit: @user.JoinDate.ToString("dd/MM/yyyy")</div>
                                                    @if (user.OrderCount > 0)
                                                    {
                                                        <div class="small text-success">@user.OrderCount commande(s)</div>
                                                    }
                                                </div>
                                                <span class="badge @(user.IsAmbassador ? "bg-success" : "bg-secondary")">
                                                    @(user.IsAmbassador ? "Ambassadeur" : "Utilisateur")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-people text-muted display-4"></i>
                            <p class="text-muted mt-3">Aucun filleul direct pour le moment.</p>
                            <p class="small">Partagez votre code de parrainage pour commencer à construire votre réseau !</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Génération 2 -->
            @if (Model.Generation2Users.Any())
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-diagram-2 me-2"></i>Réseau Génération 2 (@Model.Generation2Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var user in Model.Generation2Users.Take(6))
                            {
                                <div class="col-lg-4 col-md-6">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body p-2">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-info bg-opacity-10 rounded p-1 me-2">
                                                    <i class="bi bi-person text-info small"></i>
                                                </div>
                                                <div>
                                                    <div class="small fw-semibold">@user.DisplayName</div>
                                                    <div class="small text-muted">@user.JoinDate.ToString("MM/yyyy")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (Model.Generation2Users.Count > 6)
                            {
                                <div class="col-12 text-center">
                                    <small class="text-muted">Et @(Model.Generation2Users.Count - 6) autres...</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Génération 3 -->
            @if (Model.Generation3Users.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Réseau Génération 3 (@Model.Generation3Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center">
                            <i class="bi bi-diagram-3 text-success display-4"></i>
                            <p class="mt-3 mb-1"><strong>@Model.Generation3Count</strong> personnes dans votre réseau de 3ème génération</p>
                            <p class="text-muted small">Excellent travail ! Votre réseau se développe de manière exponentielle.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
