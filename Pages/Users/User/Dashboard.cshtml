@page
@model MCBusiness.Pages.Users.User.DashboardModel
@using MCBusiness.Models
@{
    ViewData["Title"] = "Mon tableau de bord";
    var latestOrder = Model.RecentOrders.FirstOrDefault();
}

@functions {
    private static string Money(decimal amount, string currencyCode = "HTG") => $"{amount:N2} {currencyCode}";

    private static string OrderStatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "En attente de paiement",
        OrderStatus.Paid => "Payée",
        OrderStatus.PartiallyShipped => "Partiellement expédiée",
        OrderStatus.Shipped => "Expédiée",
        OrderStatus.PartiallyDelivered => "Partiellement livrée",
        OrderStatus.Delivered => "Livrée",
        OrderStatus.PartiallyReturned => "Retour partiel",
        OrderStatus.Cancelled => "Annulée",
        OrderStatus.Refunded => "Remboursée",
        _ => status.ToString()
    };

    private static string OrderStatusBadge(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Paid => "bg-primary",
        OrderStatus.PartiallyShipped or OrderStatus.Shipped => "bg-info text-dark",
        OrderStatus.PartiallyDelivered or OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled or OrderStatus.Refunded => "bg-secondary",
        OrderStatus.PartiallyReturned => "bg-danger",
        _ => "bg-secondary"
    };

    private static string ProductsSummary(Order order)
    {
        if (order?.Products == null || order.Products.Count == 0)
        {
            return "Articles non détaillés";
        }

        var productNames = order.Products
            .Take(2)
            .Select(item => item.ProductVariant?.Product?.Name ?? "Produit")
            .ToList();

        var extraCount = order.Products.Count - productNames.Count;
        return extraCount > 0
            ? $"{string.Join(", ", productNames)} +{extraCount}"
            : string.Join(", ", productNames);
    }
}

<div class="container-fluid px-4">
    <div class="row">

        <!-- Sidebar Desktop -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class=" shadow-sm rounded-3 p-3 sticky-top" style="top:1rem">
                <partial name="_SideBarUser" />
            </div>
        </div>

        <!-- Sidebar Mobile (OFFCANVAS UNIQUE) -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="userSidebar">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title">Menu</h5>
                <button class="btn-close" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body p-0">
                <partial name="_SideBarUser" />
            </div>
        </div>

        <!-- Main -->
        <div class="col-lg-9">

            <!-- Header -->
            <div class="dashboard-header d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1 class="h3 text-primary fw-bold">
                        Bonjour @Model.CurrentUser.UserName
                    </h1>
                </div>

                <div class="dashboard-header-actions d-flex gap-2">

                    <!-- Bouton mobile -->
                    

                    <button class="btn btn-success" onclick="refreshEarnings()">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>


                    @if (Model.ActiveSubscription != null)               
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">
                            <i class="bi bi-star me-1"></i>@Model.PlanUser?.Name
                        </span>
                    }
                    else
                    {
                        <a asp-page="/Plans/Index" class="btn btn-warning">
                            <i class="bi bi-star me-1"></i>Souscrire Plan
                        </a>
                    }
                </div>
            </div>

            <!-- Aperçu e-commerce -->
            <section class="mb-4">
                <div class="mobile-section-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">Achat et commandes</h2>
                        <p class="text-muted mb-0">Suivez vos achats, vos paiements et votre adresse de livraison.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-page="/Shop/Index" class="btn btn-primary">
                            <i class="bi bi-shop me-1"></i>Explorer la boutique
                        </a>
                        <a asp-page="/Orders/MyOrders" class="btn btn-outline-primary">
                            <i class="bi bi-receipt me-1"></i>Mes commandes
                        </a>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-xl-3 col-md-6">
                        <div class="card dashboard-metric h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="text-muted small">Commandes</div>
                                        <div class="h3 fw-bold mb-0">@Model.TotalOrders</div>
                                    </div>
                                    <span class="metric-icon bg-primary-subtle text-primary">
                                        <i class="bi bi-bag-check"></i>
                                    </span>
                                </div>
                                <div class="small text-muted mt-2">@Model.ActiveOrders commande(s) en cours</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card dashboard-metric h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="text-muted small">À payer</div>
                                        <div class="h3 fw-bold mb-0">@Model.PendingPaymentOrders</div>
                                    </div>
                                    <span class="metric-icon bg-warning-subtle text-warning-emphasis">
                                        <i class="bi bi-credit-card"></i>
                                    </span>
                                </div>
                                <div class="small text-muted mt-2">Commande(s) encore en attente</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card dashboard-metric h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="text-muted small">Dernier total</div>
                                        <div class="h4 fw-bold mb-0">@(latestOrder != null ? Money(latestOrder.GrandTotal) : "0.00 HTG")</div>
                                    </div>
                                    <span class="metric-icon bg-success-subtle text-success">
                                        <i class="bi bi-cash-stack"></i>
                                    </span>
                                </div>
                                <div class="small text-muted mt-2">Produits + livraison</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="card dashboard-metric h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="min-width-0">
                                        <div class="text-muted small">Adresse principale</div>
                                        <div class="fw-semibold text-truncate" title="@(Model.PrimaryAddress?.FullAddress ?? "Aucune adresse")">
                                            @(Model.PrimaryAddress?.City?.Name ?? "Non définie")
                                        </div>
                                    </div>
                                    <span class="metric-icon bg-info-subtle text-info">
                                        <i class="bi bi-geo-alt"></i>
                                    </span>
                                </div>
                                <a asp-page="/Users/User/Addresses" class="small text-decoration-none">Gérer mes adresses</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h3 class="h6 mb-0">
                            <i class="bi bi-clock-history me-2"></i>Dernières commandes
                        </h3>
                        <a asp-page="/Orders/MyOrders" class="btn btn-sm btn-outline-primary">Voir tout</a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.RecentOrders.Any())
                        {
                            <div class="table-responsive orders-table-desktop">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Commande</th>
                                            <th>Articles</th>
                                            <th>Total</th>
                                            <th>Statut</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in Model.RecentOrders)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">#@order.Id</div>
                                                    <small class="text-muted">@LocalTime.Format(order.OrderDate, "dd/MM/yyyy HH:mm")</small>
                                                </td>
                                                <td>@ProductsSummary(order)</td>
                                                <td class="fw-semibold">@Money(order.GrandTotal)</td>
                                                <td>
                                                    <span class="badge @OrderStatusBadge(order.Status)">
                                                        @OrderStatusLabel(order.Status)
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <div class="btn-group btn-group-sm">
                                                        <a asp-page="/Orders/OrderTracking" asp-route-id="@order.Id" class="btn btn-outline-primary">
                                                            Suivre
                                                        </a>
                                                        @if (order.Status == OrderStatus.Pending)
                                                        {
                                                            <a asp-page="/Payments/Payment" asp-route-type="order" asp-route-id="@order.Id" class="btn btn-primary">
                                                                Payer
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a asp-page="/Orders/Receipt" asp-route-id="@order.Id" class="btn btn-outline-secondary">
                                                                Reçu
                                                            </a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="orders-mobile-list">
                                @foreach (var order in Model.RecentOrders)
                                {
                                    <article class="order-mobile-card">
                                        <div class="d-flex justify-content-between gap-2">
                                            <div>
                                                <div class="fw-bold">Commande #@order.Id</div>
                                                <small class="text-muted">@LocalTime.Format(order.OrderDate, "dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <span class="badge @OrderStatusBadge(order.Status)">
                                                @OrderStatusLabel(order.Status)
                                            </span>
                                        </div>

                                        <div class="mt-3">
                                            <div class="text-muted small">Articles</div>
                                            <div class="fw-semibold">@ProductsSummary(order)</div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="text-muted small">Total payé ou à payer</span>
                                            <span class="h5 mb-0">@Money(order.GrandTotal)</span>
                                        </div>

                                        <div class="mobile-action-grid mt-3">
                                            <a asp-page="/Orders/OrderTracking" asp-route-id="@order.Id" class="btn btn-outline-primary">
                                                <i class="bi bi-truck me-1"></i>Suivre
                                            </a>
                                            @if (order.Status == OrderStatus.Pending)
                                            {
                                                <a asp-page="/Payments/Payment" asp-route-type="order" asp-route-id="@order.Id" class="btn btn-primary">
                                                    <i class="bi bi-credit-card me-1"></i>Payer
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-page="/Orders/Receipt" asp-route-id="@order.Id" class="btn btn-outline-secondary">
                                                    <i class="bi bi-file-earmark-text me-1"></i>Reçu
                                                </a>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-bag display-6 d-block mb-2"></i>
                                Aucune commande pour le moment.
                                <div class="mt-2">
                                    <a asp-page="/Shop/Index" class="btn btn-sm btn-primary">Découvrir les produits</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h2 class="h5 fw-bold mb-1">Portefeuille et affiliation</h2>
                    <p class="text-muted mb-0">Vos soldes, points et avantages ambassadeur.</p>
                </div>
            </div>

            <!-- KPI Commissions Principales (USER SEULEMENT) -->
            <div class="row mb-4">
                <div class="col-xl-4 col-md-12 mb-3">
                    <div class="card wallet-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-1">Solde disponible</h6>
                                    <h2 class="mb-1" id="totalEarnings">
                                        @Money(Model.CurrentWallet?.Balance ?? 0m)
                                    </h2>
                                    <small class="text-muted">
                                        <i class="bi bi-wallet me-1"></i>Prêt à retirer
                                    </small>
                                </div>
                                <div class="metric-icon bg-primary-subtle text-primary">
                                    <i class="bi bi-gem display-4"></i>
                                </div>
                            </div>
                            <div class="row text-center mt-3">
                                <div class="col-4">
                                    <small class="text-muted">Disponible</small>
                                    <div class="fw-bold">@Money((decimal)(ViewData["AvailableBalance"] ?? 0m))</div>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">En attente</small>
                                    <div class="fw-bold">@Money((decimal)(ViewData["PendingBalance"] ?? 0m))</div>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Points</small>
                                    <div class="fw-bold">@Model.TotalPoints <i class="bi bi-star-fill"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- TOTAL GAINS - Protégé par subscription -->
                @if (Model.CanViewCommissions)
                {
                    <div class="col-xl-4 col-md-6 mb-3">
                        <div class="card wallet-card h-100 ambassador-feature">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1">Total des gains</h6>
                                        <h2 class="mb-1" id="salesCommissions">
                                            @Money(Model.TotalGains)
                                        </h2>
                                        <small class="text-muted">
                                            <i class="bi bi-arrow-up"></i> Tous vos gains
                                        </small>
                                    </div>
                                    <div class="metric-icon bg-success-subtle text-success">
                                        <i class="bi bi-cart-check display-4"></i>
                                    </div>
                                </div>
                                <div class="progress mt-3" style="height: 6px;">
                                    <div class="progress-bar bg-success" style="width: @((ViewData["SalesProgress"] ?? 0))%"></div>
                                </div>
                                <small class="text-muted mt-1">Gains payés et crédités</small>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-xl-4 col-md-6 mb-3">
                        <div class="card wallet-card h-100 locked-section">
                            <div class="teaser-card">
                                <div class="lock-icon"><i class="bi bi-lock"></i></div>
                                <h5 class="mt-3">Gains verrouillés</h5>
                                <p class="text-muted small">Souscrivez un plan pour voir vos commissions</p>
                                <a asp-page="/Plans/Index" class="btn btn-sm btn-subscribe">
                                    <i class="bi bi-star me-1"></i>Voir les Plans
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- MES PARRAINAGES - Protégé par subscription -->
                @if (Model.CanViewCommissions)
                {
                    <div class="col-xl-4 col-md-6 mb-3">
                        <div class="card wallet-card h-100 ambassador-feature">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1">Mes parrainages</h6>
                                        <h2 class="mb-1" id="referralCommissions">
                                            @Model.Referrals.Count
                                        </h2>
                                        <small class="text-muted">
                                            Personnes parrainées
                                        </small>
                                    </div>
                                    <div class="metric-icon bg-warning-subtle text-warning-emphasis">
                                        <i class="bi bi-people-fill display-4"></i>
                                    </div>
                                </div>
                                <div class="progress mt-3" style="height: 6px;">
                                    <div class="progress-bar bg-warning" style="width: @((ViewData["ReferralProgress"] ?? 0))%"></div>
                                </div>
                                <small class="text-muted mt-1">Nouveaux ce mois: @(ViewData["NewReferrals"] ?? 0)</small>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-xl-4 col-md-6 mb-3">
                        <div class="card wallet-card h-100 locked-section">
                            <div class="teaser-card">
                                <div class="lock-icon"><i class="bi bi-lock"></i></div>
                                <h5 class="mt-3">Parrainages verrouillés</h5>
                                <p class="text-muted small">Accédez à votre réseau de parrainage</p>
                                <a asp-page="/Plans/Index" class="btn btn-sm btn-subscribe">
                                    <i class="bi bi-star me-1"></i>Voir les Plans
                                </a>
                            </div>
                        </div>
                    </div>
                }

                
            </div>

            <!-- Graphiques Commissions Détaillés -->
            @if (Model.CanViewAdvancedStats)
            {
                <div class="row mb-4">
                    <div class="col-lg-8">
                        <div class="card shadow-sm ambassador-feature">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="bi bi-graph-up me-2"></i>Évolution de mes Commissions
                                    <span class="badge bg-info ms-2">DERNIERS 6 MOIS</span>
                                </h6>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-success" onclick="toggleCommissionChart('sales')">Ventes</button>
                                    <button class="btn btn-sm btn-warning" onclick="toggleCommissionChart('referrals')">Parrainages</button>
                                    <button class="btn btn-sm btn-primary" onclick="toggleCommissionChart('both')">Les deux</button>
                                </div>
                            </div>
                            <div class="card-body">
                                <canvas id="commissionsChart" height="100"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card shadow-sm h-100 ambassador-feature">
                            <div class="card-header bg-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-target me-2"></i>Objectifs du Mois
                                </h6>
                            </div>
                            <div class="card-body">
                                <!-- Objectif Ventes -->
                                <div class="mb-4">
                                    @if ((decimal)(ViewData["SalesTarget"] ?? 0m) > 0m)
                                    {
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Ventes</span>
                                            <span class="fw-bold">@((ViewBag.SalesProgress ?? 0))%</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-success" style="width: @((ViewBag.SalesProgress ?? 0))%"></div>
                                        </div>
                                        <small class="text-muted">
                                            @Money((decimal)(ViewData["SalesCommissions"] ?? 0m)) / @Money((decimal)(ViewData["SalesTarget"] ?? 0m))
                                        </small>
                                    }
                                    else
                                    {
                                        <div class="border rounded p-3 bg-light">
                                            <div class="fw-semibold">Objectif de ventes</div>
                                            <small class="text-muted">Aucun objectif actif pour ce mois.</small>
                                        </div>
                                    }
                                </div>

                                <!-- Objectif Parrainages -->
                                <div class="mb-4">
                                    @if ((int)(ViewData["ReferralTarget"] ?? 0) > 0)
                                    {
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Parrainages</span>
                                            <span class="fw-bold">@((ViewBag.ReferralProgress ?? 0))%</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-warning" style="width: @((ViewBag.ReferralProgress ?? 0))%"></div>
                                        </div>
                                        <small class="text-muted">
                                            @(ViewBag.ActiveReferrals ?? 0) / @(ViewBag.ReferralTarget ?? 0) parrains actifs
                                        </small>
                                    }
                                    else
                                    {
                                        <div class="border rounded p-3 bg-light">
                                            <div class="fw-semibold">Objectif de parrainage</div>
                                            <small class="text-muted">Aucun objectif actif pour ce mois.</small>
                                        </div>
                                    }
                                </div>

                                <!-- Bonus Potentiel -->
                                @if (ViewBag.HasActiveSubscription ?? false)
                                {
                                    <div class="alert alert-success" role="alert">
                                        <i class="bi bi-gift me-1"></i>
                                        <strong>Bonus Plan :</strong> +@((ViewBag.PlanBonus ?? 0))% sur toutes les commissions !
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning" role="alert">
                                        <i class="bi bi-star me-1"></i>
                                        Souscrivez un plan pour augmenter vos commissions !
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row mb-4">
                    <div class="col-lg-8">
                        <div class="card shadow-sm locked-section">
                            <div class="teaser-card">
                                <div class="lock-icon"><i class="bi bi-lock"></i></div>
                                <h5 class="mt-3">Statistiques avancées verrouillées</h5>
                                <p class="text-muted small">Découvrez vos données détaillées en souscrivant à un plan</p>
                                <a asp-page="/Plans/Index" class="btn btn-sm btn-subscribe">
                                    <i class="bi bi-star me-1"></i>Choisir un Plan
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <!-- Activités Récentes et Actions Rapides -->
            <div class="row mb-4">
                <div class="col-lg-8">
                    @if (Model.CanViewCommissions)
                    {
                        <div class="card shadow-sm ambassador-feature">
                            <div class="card-header bg-white d-flex justify-content-between">
                                <h6 class="mb-0">
                                    <i class="bi bi-clock-history me-2"></i>Mes Dernières Transactions
                                </h6>
                                <a asp-page="./Transaction" class="btn btn-sm btn-outline-primary">
                                    Voir tout l'historique
                                </a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Type</th>
                                                <th>Description</th>
                                                <th>Montant</th>
                                                <th>Date</th>
                                                <th>Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.DashboardData?.RecentTransactions != null && Model.DashboardData.RecentTransactions.Count > 0)
                                            {
                                                @foreach (var transaction in Model.DashboardData.RecentTransactions)
                                                {
                                                    <tr>
                                                        <td>
                                                            @if (transaction.Type == TransactionType.Deposit)
                                                            {
                                                                <span class="badge bg-success">Dépôt</span>
                                                            }
                                                            else if (transaction.Type == TransactionType.Withdrawal)
                                                            {
                                                                <span class="badge bg-danger">Retrait</span>
                                                            }
                                                            else if (transaction.Type == TransactionType.Bonus)
                                                            {
                                                                <span class="badge bg-warning">Bonus</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Autre</span>
                                                            }
                                                        </td>
                                                        <td>@(transaction.Description ?? "Transaction")</td>
                                                        <td class="fw-bold" style="color: @(transaction.Type == TransactionType.Withdrawal ? "#dc3545" : "#198754")">
                                                            @(transaction.Type == TransactionType.Withdrawal ? "-" : "+")@Money(transaction.Amount, transaction.Currency?.Code ?? "HTG")
                                                        </td>
                                                        <td>@LocalTime.Format(transaction.CreatedAt, "dd/MM HH:mm")</td>
                                                        <td>
                                                            @if (transaction.Status == TransactionStatus.Completed)
                                                            {
                                                                <span class="badge bg-success">Complétée</span>
                                                            }
                                                            else if (transaction.Status == TransactionStatus.Pending)
                                                            {
                                                                <span class="badge bg-warning">En attente</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-danger">Échouée</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
