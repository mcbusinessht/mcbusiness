            data-bs-target="#userSidebar"
            aria-label="Ouvrir le menu">
        <i class="bi bi-list"></i>
    </button>

</div>

@section Scripts {
    <script>
        document.addEventListener('shown.bs.modal', function () {
            const sidebar = bootstrap.Offcanvas.getInstance(
                document.getElementById('userSidebar')
            );
            sidebar?.hide();
        });

        // Gestion de la soumission du formulaire de désactivation du plan
        document.addEventListener('DOMContentLoaded', function() {
            const cancelPlanForm = document.getElementById('cancelPlanForm');
            if (cancelPlanForm) {
                cancelPlanForm.addEventListener('submit', function(e) {
                    // Le formulaire est soumis normalement via le tag <form>
                    // Pas besoin d'intervention JavaScript
                    console.log('Formulaire CancelPlan soumis');
                });
            }
        });
        </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let commissionsChart;

        document.addEventListener('DOMContentLoaded', function() {
            initializeCommissionsChart();
        });

        function initializeCommissionsChart() {
            const chartCanvas = document.getElementById('commissionsChart');
            if (!chartCanvas || typeof Chart === 'undefined') {
                return;
            }

            const ctx = chartCanvas.getContext('2d');
            
            // Données du service
            const commissionLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData?.CommissionLabels ?? new List<string>()));
            const commissionValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData?.CommissionValues ?? new List<decimal>()));
            const referralLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData?.ReferralLabels ?? new List<string>()));
            const referralValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData?.ReferralValues ?? new List<int>()));
            
            commissionsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: commissionLabels.length > 0 ? commissionLabels : ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jun'],
                    datasets: [{
                        label: 'Commissions Ventes (HTG)',
                        data: commissionValues.length > 0 ? commissionValues : [0, 0, 0, 0, 0, 0],
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.1)',
                        tension: 0.4,
                        fill: true
                    }, {
                        label: 'Parrainages',
                        data: referralValues.length > 0 ? referralValues : [0, 0, 0, 0, 0, 0],
                        borderColor: '#ffc107',
                        backgroundColor: 'rgba(255, 193, 7, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        function toggleCommissionChart(type) {
            if (!commissionsChart) {
                return;
            }

            // Données du service
            const commissionValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData?.CommissionValues ?? new List<decimal>()));
            const referralValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData?.ReferralValues ?? new List<int>()));
            
            if (type === 'sales') {
                commissionsChart.data.datasets = [{
                    label: 'Commissions Ventes (HTG)',
                    data: commissionValues.length > 0 ? commissionValues : [0, 0, 0, 0, 0, 0],
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    tension: 0.4,
                    fill: true
                }];
            } else if (type === 'referrals') {
                commissionsChart.data.datasets = [{
                    label: 'Parrainages',
                    data: referralValues.length > 0 ? referralValues : [0, 0, 0, 0, 0, 0],
                    borderColor: '#ffc107',
                    backgroundColor: 'rgba(255, 193, 7, 0.1)',
                    tension: 0.4,
                    fill: true
                }];
            } else {
                commissionsChart.data.datasets = [{
                    label: 'Commissions Ventes (HTG)',
                    data: commissionValues.length > 0 ? commissionValues : [0, 0, 0, 0, 0, 0],
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    tension: 0.4,
                    fill: true
                }, {
                    label: 'Parrainages',
                    data: referralValues.length > 0 ? referralValues : [0, 0, 0, 0, 0, 0],
                    borderColor: '#ffc107',
                    backgroundColor: 'rgba(255, 193, 7, 0.1)',
                    tension: 0.4,
                    fill: true
                }];
            }
            
            commissionsChart.update();
        }

        function refreshEarnings() {
            // Effet visuel de rafraîchissement
            const cards = document.querySelectorAll('.card');
            cards.forEach(card => {
                card.style.opacity = '0.7';
                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'scale(1.02)';
                    setTimeout(() => {
                        card.style.transform = 'scale(1)';
                    }, 200);
                }, 100);
            });
            
            setTimeout(() => {
                location.reload();
            }, 1500);
        }

        function shareReferralLink() {
            const referralLink = `@Model.Link`;
            
            if (navigator.share) {
                navigator.share({
                    title: 'Rejoins MCBusiness avec mon lien de parrainage !',
                    text: 'Découvre MCBusiness et commence à gagner de l\'argent avec moi !',
                    url: referralLink
                });
            } else {
                // Fallback pour copier le lien
                navigator.clipboard.writeText(referralLink).then(() => {
                    alert('Lien de parrainage copié ! Partage-le pour gagner des commissions.');
                });
            }
        }
    </script>
}

