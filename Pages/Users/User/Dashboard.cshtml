                                            <small class="text-muted">Gains ce mois</small>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <div class="border rounded p-3 h-100">
                                            <i class="bi bi-graph-up text-info display-6"></i>
                                            <h4 class="mt-2 mb-1">@((ViewBag.ReferralGrowth ?? 0).ToString("F1"))%</h4>
                                            <small class="text-muted">Croissance</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
