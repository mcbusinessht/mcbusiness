@page
@model MCBusiness.Pages.Users.User.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<!-- Bouton menu mobile -->
<button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
        style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
        data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
    <i class="bi bi-list fs-4"></i>
</button>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar version desktop -->
        <div class="col-lg-3 col-xl-3 d-none d-lg-block">
            <div class=" border-end shadow-sm h-100 position-sticky" style="top: 1rem;">
                <partial name="_SideBarUser"/>
            </div>
        </div>

        <!-- Main Content -->
        <main class="col-lg-9 col-xl-9 p-4 bg-light">
            <!-- Header moderne -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
                <div class="d-flex align-items-center mb-3 mb-md-0">
                    <div class="bg-primary bg-gradient rounded-circle p-3 me-3">
                        <i class="bi bi-bell-fill text-white fs-4"></i>
                    </div>
                    <div>
                        <h1 class="h2 text-primary mb-1">Notifications</h1>
                        <p class="text-muted mb-0">
                            @Model.Notifications.Count(n => !n.IsRead) non lues sur @Model.Notifications.Count total
                        </p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center" id="markAllAsRead">
                        <i class="bi bi-check-all me-2"></i>
                        Tout marquer comme lu
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm d-flex align-items-center" id="refreshNotifications">
                        <i class="bi bi-arrow-clockwise me-2"></i>
                        Actualiser
                    </button>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="row g-3 mb-4">
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="card border-0 bg-primary bg-gradient text-white h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="bi bi-bell-fill fs-1"></i>
                            <div>
                                <h5 class="mb-0">@Model.Notifications.Count</h5>
                                <small class="opacity-75">Total notifications</small>
                            </div>
                        </div>     
                    </div>
                </div>  

                <div class="col-lg-3 col-md-6 col-12">
                    <div class="card border-0 bg-warning bg-gradient text-white h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="bi bi-exclamation-circle-fill fs-1"></i>
                            <div>
                                <h5 class="mb-0">@Model.Notifications.Count(n => !n.IsRead)</h5>
                                <small class="opacity-75">Non lues</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <div class="card border-0 bg-success bg-gradient text-white h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="bi bi-check-circle-fill fs-1"></i>
                            <div>
                                <h5 class="mb-0">@Model.Notifications.Count(n => n.IsRead)</h5>
                                <small class="opacity-75">Lues</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <div class="card border-0 bg-info bg-gradient text-white h-100">
                        <div class="card-body d-flex align-items-center gap-3">
                            <i class="bi bi-clock-fill fs-1"></i>
                            <div>
                                <h5 class="mb-0">
                                    @{
                                        var localToday = LocalTime.ToLocal(DateTimeOffset.UtcNow).Date;
                                    }
                                    @Model.Notifications.Count(n => LocalTime.ToLocal(n.CreatedAt).Date >= localToday)
                                </h5>
                                <small class="opacity-75">Aujourd'hui</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Filtres -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="btn-group" role="group" aria-label="Filtres">
                                <input type="radio" class="btn-check" name="filter" id="filter-all" autocomplete="off" checked>
                                <label class="btn btn-outline-primary" for="filter-all">
                                    <i class="bi bi-list me-1"></i>Toutes
                                </label>
                                
                                <input type="radio" class="btn-check" name="filter" id="filter-unread" autocomplete="off">
                                <label class="btn btn-outline-warning" for="filter-unread">
                                    <i class="bi bi-exclamation-circle me-1"></i>Non lues
                                </label>
                                
                                <input type="radio" class="btn-check" name="filter" id="filter-read" autocomplete="off">
                                <label class="btn btn-outline-success" for="filter-read">
                                    <i class="bi bi-check-circle me-1"></i>Lues
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" class="form-control border-start-0" 
                                       placeholder="Rechercher..." id="searchNotifications">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Liste des notifications -->
            <div class="row">
                <div class="col-12">
                    @if (Model.Notifications.Any())
                    {
                        <div id="notifications-container">
                            @foreach (var notification in Model.Notifications)
                            {
                                <div class="notification-item card border-0 shadow-sm mb-3 @(!notification.IsRead ? "border-start border-warning border-4" : "")" 
                                     data-notification-id="@notification.Id"
                                     data-read="@notification.IsRead.ToString().ToLower()"
                                     data-type="@(notification.NotificationType ?? "general")"
                                     style="cursor: pointer; transition: all 0.3s ease;">
                                    <div class="card-body">
                                        <div class="d-flex align-items-start">
                                            <!-- Icône selon le type -->
                                            <div class="flex-shrink-0 me-3">
                                                <div class="notification-icon @Model.GetNotificationIconColor(notification.NotificationType ?? "general")">
                                                    <i class="@Model.GetNotificationIcon(notification.NotificationType ?? "general") fs-4"></i>
                                                </div>
                                            </div>
                                            
                                            <!-- Contenu -->
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="mb-0 @(!notification.IsRead ? "fw-bold" : "")">
                                                        @Model.CleanText(notification.Title)
                                                        @if (!notification.IsRead)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-2">Nouveau</span>
                                                        }
                                                    </h6>
                                                    <div class="text-end">
                                                        <small class="text-muted">
                                                            <i class="bi bi-clock me-1"></i>
                                                            @Model.GetRelativeTime(notification.CreatedAt)
                                                        </small>
                                                    </div>
                                                </div>
                                                
                                                <p class="mb-2 text-muted">@Model.CleanText(notification.Message)</p>
                                                
                                                <!-- Actions -->
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="d-flex gap-2">
                                                        <span class="badge @Model.GetNotificationTypeBadge(notification.NotificationType ?? "general")">
                                                            @Model.GetNotificationTypeText(notification.NotificationType ?? "general")
                                                        </span>
                                                        <small class="text-muted">
                                                            @LocalTime.Format(notification.CreatedAt, "dd/MM/yyyy à HH:mm")
                                                        </small>
                                                    </div>
                                                    
                                                    @if (!notification.IsRead)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary mark-as-read" 
                                                                data-notification-id="@notification.Id">
                                                            <i class="bi bi-check me-1"></i>Marquer comme lu
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <!-- Pagination dynamique -->
                        <div class="d-flex justify-content-center mt-4" id="loadMoreContainer">
                            <button class="btn btn-outline-primary" id="loadMoreNotifications">
                                <i class="bi bi-arrow-down-circle me-2"></i>
                                Charger plus de notifications
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="card-body text-center py-5">
                                <div class="mb-4">
                                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                                        <i class="bi bi-bell-slash display-4 text-muted"></i>
                                    </div>
                                </div>
                                <h3 class="h4 text-muted mb-3">Aucune notification</h3>
                                <p class="text-muted mb-4">
                                    Vous n'avez aucune notification pour le moment.<br>
                                    Les nouvelles notifications apparaîtront ici.
                                </p>
                                <button class="btn btn-primary" id="refreshNotifications">
                                    <i class="bi bi-arrow-clockwise me-2"></i>
                                    Vérifier maintenant
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

<!-- La sidebar mobile est maintenant intégrée dans _SideBarUser_Fixed.cshtml -->

<!-- Modal pour afficher le détail des notifications -->
<div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary bg-gradient text-white border-0">
                <div class="d-flex align-items-center">
                    <div class="notification-modal-icon bg-white bg-opacity-20 rounded-circle p-2 me-3">
                        <i class="bi bi-bell-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="notificationModalLabel">Notification</h5>
                        <small class="opacity-75" id="notificationModalDate"></small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Contenu de la notification -->
                <div id="notificationModalContent">
                    <div class="d-flex justify-content-center align-items-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                    </div>
                </div>
                
                <!-- Type et badge -->
                <div class="border-top pt-3 mt-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div id="notificationModalBadge">
                            <!-- Badge sera ajouté dynamiquement -->
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-eye me-1"></i>
                            <span id="notificationModalStatus">Marquée comme lue</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-2"></i>Fermer
                </button>
                <button type="button" class="btn btn-primary" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise me-2"></i>Actualiser
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Marquer toutes comme lues
            document.getElementById('markAllAsRead')?.addEventListener('click', function() {
                if (confirm('Voulez-vous vraiment marquer toutes les notifications comme lues ?')) {
                    fetch('@Url.Page("/Users/User/Notifications", "MarkAllAsRead")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => {
                        if (response.ok) {
                            location.reload();
                        }
                    });
                }
            });

            // Marquer comme lu individuellement
            document.querySelectorAll('.mark-as-read').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const notificationId = this.dataset.notificationId;
                    
                    fetch(`@Url.Page("/Users/User/Notifications", "NotificationDetails")?id=${notificationId}`)
                    .then(response => response.json())
                    .then(data => {
                        const card = this.closest('.notification-item');
                        card.classList.remove('border-start', 'border-warning', 'border-4');
                        this.remove();
                        card.dataset.read = 'true';
                        
                        // Mettre à jour les compteurs
                        updateCounters();
                    });
                });
            });

            // Filtres
            document.querySelectorAll('input[name="filter"]').forEach(filter => {
                filter.addEventListener('change', function() {
                    const filterType = this.id.replace('filter-', '');
                    filterNotifications(filterType);
                });
            });

            // Recherche
            document.getElementById('searchNotifications')?.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                searchNotifications(searchTerm);
            });

            // Actualiser
            document.getElementById('refreshNotifications')?.addEventListener('click', function() {
                location.reload();
            });

            function filterNotifications(type) {
                const notifications = document.querySelectorAll('.notification-item');
                notifications.forEach(notification => {
                    switch(type) {
                        case 'all':
                            notification.style.display = 'block';
                            break;
                        case 'unread':
                            notification.style.display = notification.dataset.read === 'false' ? 'block' : 'none';
                            break;
                        case 'read':
                            notification.style.display = notification.dataset.read === 'true' ? 'block' : 'none';
                            break;
                    }
                });
            }

            function searchNotifications(searchTerm) {
                const notifications = document.querySelectorAll('.notification-item');
                notifications.forEach(notification => {
                    const title = notification.querySelector('h6').textContent.toLowerCase();
                    const message = notification.querySelector('p').textContent.toLowerCase();
                    const matches = title.includes(searchTerm) || message.includes(searchTerm);
                    notification.style.display = matches ? 'block' : 'none';
                });
            }

            function updateCounters() {
                // Recompter les notifications
                const unreadCount = document.querySelectorAll('.notification-item[data-read="false"]').length;
                const readCount = document.querySelectorAll('.notification-item[data-read="true"]').length;
                
                // Mettre à jour l'affichage (nécessiterait une requête AJAX pour être parfait)
                setTimeout(() => location.reload(), 1000);
            }

            // Animation au survol
            document.querySelectorAll('.notification-item').forEach(item => {
                item.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.boxShadow = '0 0.5rem 1rem rgba(0,0,0,0.15)';
                });
                
                item.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '';
                });

                // Ajouter le clic pour ouvrir le modal
                item.addEventListener('click', function() {
                    const notificationId = this.dataset.notificationId;
                    if (notificationId) {
                        openNotificationModal(notificationId);
                    }
                });
            });
        });

        // Fonction pour ouvrir le modal de notification
        function openNotificationModal(notificationId) {
            const modal = new bootstrap.Modal(document.getElementById('notificationModal'));
            
            // Réinitialiser le contenu
            document.getElementById('notificationModalContent').innerHTML = `
                <div class="d-flex justify-content-center align-items-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                </div>
            `;
            
            // Ouvrir le modal
            modal.show();
            
            // Charger les détails de la notification
            fetch(`?handler=NotificationDetails&id=${notificationId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Erreur lors du chargement de la notification');
                    }
                    return response.json();
                })
                .then(data => {
                    // Mettre à jour le contenu du modal
                    updateModalContent(data, notificationId);
                    
                    // Marquer la notification comme lue visuellement
                    markNotificationAsReadVisually(notificationId);
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    document.getElementById('notificationModalContent').innerHTML = `
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Erreur lors du chargement de la notification.
                        </div>
                    `;
                });
        }

        // Fonction pour mettre à jour le contenu du modal
        function updateModalContent(data, notificationId) {
            const notificationElement = document.querySelector(`[data-notification-id="${notificationId}"]`);
            const type = notificationElement ? notificationElement.dataset.type : 'general';
            
            // Mettre à jour le titre et la date
            document.getElementById('notificationModalLabel').textContent = 
                notificationElement ? notificationElement.querySelector('h6').textContent : 'Notification';
            document.getElementById('notificationModalDate').textContent = data.createdAt;
            
            // Mettre à jour l'icône selon le type
            const iconClass = getNotificationIcon(type);
            const iconColorClass = getNotificationIconColor(type);
            document.querySelector('.notification-modal-icon').innerHTML = `<i class="${iconClass} fs-4"></i>`;
            document.querySelector('.notification-modal-icon').className = `notification-modal-icon bg-white bg-opacity-20 rounded-circle p-2 me-3 ${iconColorClass}`;
            
            // Mettre à jour le contenu
            document.getElementById('notificationModalContent').innerHTML = `
                <div class="notification-message">
                    <p class="fs-6 lh-lg mb-0">${data.message}</p>
                </div>
            `;
            
            // Mettre à jour le badge
            const badgeClass = getNotificationTypeBadge(type);
            const typeText = getNotificationTypeText(type);
            document.getElementById('notificationModalBadge').innerHTML = `
                <span class="badge ${badgeClass} rounded-pill px-3 py-2">
                    <i class="${iconClass} me-2"></i>${typeText}
                </span>
            `;
        }

        // Fonction pour marquer visuellement comme lu
        function markNotificationAsReadVisually(notificationId) {
            const notificationElement = document.querySelector(`[data-notification-id="${notificationId}"]`);
            if (notificationElement && notificationElement.dataset.read === 'false') {
                // Supprimer la bordure de warning
                notificationElement.classList.remove('border-start', 'border-warning', 'border-4');
                
                // Mettre à jour le dataset
                notificationElement.dataset.read = 'true';
                
                // Supprimer le bouton "marquer comme lu" s'il existe
                const markAsReadBtn = notificationElement.querySelector('.mark-as-read');
                if (markAsReadBtn) {
                    markAsReadBtn.remove();
                }
                
                // Supprimer le badge "non lu" s'il existe
                const unreadBadge = notificationElement.querySelector('.badge.bg-warning');
                if (unreadBadge) {
                    unreadBadge.remove();
                }
                
                // Mettre à jour le titre pour qu'il ne soit plus en gras
                const title = notificationElement.querySelector('h6');
                if (title) {
                    title.classList.remove('fw-bold');
                }
            }
            
            // Mettre à jour les compteurs après un délai
            setTimeout(() => {
                updateCounters();
            }, 500);
        }

        // Fonction pour marquer comme lu seulement (sans ouvrir le modal)
        function markAsReadOnly(notificationId) {
            fetch(`?handler=NotificationDetails&id=${notificationId}`)
                .then(response => {
                    if (response.ok) {
                        markNotificationAsReadVisually(notificationId);
                    }
                })
                .catch(error => {
                    console.error('Erreur lors du marquage comme lu:', error);
                });
        }

        // Fonctions utilitaires pour les icônes et badges
        function getNotificationIcon(type) {
            const icons = {
                'order': 'bi-cart-check-fill',
                'payment': 'bi-credit-card-fill',
                'commission': 'bi-currency-dollar',
                'referral': 'bi-people-fill',
                'system': 'bi-gear-fill',
                'security': 'bi-shield-exclamation',
                'promotion': 'bi-gift-fill',
                'message': 'bi-envelope-fill'
            };
            return icons[type] || 'bi-bell-fill';
        }

        function getNotificationIconColor(type) {
            const colors = {
                'order': 'text-success',
                'payment': 'text-primary',
                'commission': 'text-warning',
                'referral': 'text-info',
                'system': 'text-secondary',
                'security': 'text-danger',
                'promotion': 'text-purple',
                'message': 'text-primary'
            };
            return colors[type] || 'text-muted';
        }

        function getNotificationTypeBadge(type) {
            const badges = {
                'order': 'bg-success bg-opacity-10 text-success',
                'payment': 'bg-primary bg-opacity-10 text-primary',
                'commission': 'bg-warning bg-opacity-10 text-warning',
                'referral': 'bg-info bg-opacity-10 text-info',
                'system': 'bg-secondary bg-opacity-10 text-secondary',
                'security': 'bg-danger bg-opacity-10 text-danger',
                'promotion': 'bg-purple bg-opacity-10 text-purple',
                'message': 'bg-primary bg-opacity-10 text-primary'
            };
            return badges[type] || 'bg-light text-muted';
        }

        function getNotificationTypeText(type) {
            const texts = {
                'order': 'Commande',
                'payment': 'Paiement',
                'commission': 'Commission',
                'referral': 'Parrainage',
                'system': 'Système',
                'security': 'Sécurité',
                'promotion': 'Promotion',
                'message': 'Message'
            };
            return texts[type] || 'Notification';
        }
    </script>

    <style>
        /* Styles pour les notifications et le modal */
        .notification-item {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .notification-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
        }

        .notification-item:active {
            transform: translateY(0);
        }

        .notification-message {
            font-size: 1rem;
            line-height: 1.6;
            color: #495057;
        }

        .notification-modal-icon {
            transition: all 0.3s ease;
        }

        .modal-content {
            border-radius: 1rem;
            overflow: hidden;
        }

        .modal-header {
            border-bottom: none;
            padding: 1.5rem;
        }

        .modal-body {
            padding: 2rem;
        }

        .modal-footer {
            border-top: none;
            padding: 1.5rem;
        }

        /* Badge personnalisé pour purple */
        .text-purple {
            color: #6f42c1 !important;
        }

        .bg-purple {
            background-color: #6f42c1 !important;
        }

        /* Animation pour le spinner */
        .spinner-border {
            width: 3rem;
            height: 3rem;
        }

        /* Style pour les notifications lues vs non lues */
        .notification-item[data-read="false"] {
            background: linear-gradient(145deg, #fff, #f8f9fa);
            border-left: 4px solid #ffc107 !important;
        }

        .notification-item[data-read="true"] {
            opacity: 0.85;
        }

        .notification-item[data-read="false"] h6 {
            font-weight: 700 !important;
        }

        .notification-item[data-read="true"] h6 {
            font-weight: 500 !important;
        }

        /* Amélioration visuelle des badges */
        .badge.rounded-pill {
            font-weight: 500;
            letter-spacing: 0.025em;
        }

        /* Animation de pulse pour les nouvelles notifications */
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .notification-item[data-read="false"]:hover {
            animation: pulse 0.3s ease-in-out;
        }
    </style>

    <script>
    // Pagination dynamique pour les notifications
    let currentSkipNotif = @Model.Notifications.Count;
    const loadMoreBtnNotif = document.getElementById('loadMoreNotifications');

    if (loadMoreBtnNotif) {
        loadMoreBtnNotif.addEventListener('click', async function() {
            loadMoreBtnNotif.disabled = true;
            loadMoreBtnNotif.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Chargement...';
            
            try {
                const response = await fetch(`/Users/User/Notifications?handler=LoadMoreNotifications&skip=${currentSkipNotif}&take=20`);
                const notifications = await response.json();
                
                if (notifications && notifications.length > 0) {
                    const notifContainer = document.querySelector('.notification-list .row');
                    
                    notifications.forEach(n => {
                        const card = `
                            <div class="col-12">
                                <div class="notification-item border rounded-3 p-3 mb-3 shadow-sm" data-read="${n.isRead}">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <div class="${n.iconColor}">
                                                <i class="bi ${n.icon} fs-4"></i>
                                            </div>
                                        </div>
                                        <div class="col">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="mb-0">${n.message}</h6>
                                                <span class="badge ${n.typeBadge} rounded-pill">${n.typeText}</span>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <i class="bi bi-clock me-1"></i>${n.relativeTime}
                                                </small>
                                                ${!n.isRead ? '<span class="badge bg-warning text-dark">Nouveau</span>' : ''}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        
                        notifContainer.insertAdjacentHTML('beforeend', card);
                    });
                    
                    currentSkipNotif += notifications.length;
                    
                    if (notifications.length < 20) {
                        loadMoreBtnNotif.style.display = 'none';
                    }
                } else {
                    loadMoreBtnNotif.style.display = 'none';
                }
            } catch (error) {
                console.error('Erreur:', error);
                alert('Erreur lors du chargement des notifications');
            } finally {
                loadMoreBtnNotif.disabled = false;
                loadMoreBtnNotif.innerHTML = '<i class="bi bi-arrow-down-circle me-2"></i>Charger plus de notifications';
            }
        });
    }
    </script>
}
