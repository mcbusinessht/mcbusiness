@page
@model MCBusiness.Pages.Users.User.ProfilModel
@{
    ViewData["Title"] = "Mon Profil";
}

<div class="profile-container">
    <div class="container">
        @if (TempData["TwoFactorError"] is string twoFactorError)
        {
            <div class="alert alert-danger">@twoFactorError</div>
        }

        <div class="row justify-content-center">
            <!-- Colonne Photo de profil -->
            <div class="col-md-5 mb-4 mb-md-0">
                <div class="profile-card">
                    <div class="profile-section text-center">
                        @if (!string.IsNullOrEmpty(Model.CurrentUser.ProfilePictureUrl))
                        {
                            <img src="@Model.CurrentUser.ProfilePictureUrl" alt="Photo de profil" class="profile-pic mb-3">
                        }
                        else
                        {
                            <img src="~/image/vector-illustration-depicting-ma.png" alt="Photo de profil" class="profile-pic mb-3">
                        }

                        <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="mt-4">
                            <div class="file-upload btn-profile mb-3 btn-primary">
                                <span class=""><i class="bi bi-cloud-arrow-up me-2"></i>Changer la photo</span>
                                <input type="file" class="file-upload-input" id="profilePicture" name="UploadedImage" accept="image/*">
                            </div>
                            <button type="submit" class="btn-profile btn-primary w-100"><i class="bi bi-save me-2"></i>Enregistrer</button>
                            
                            @if (ModelState.ContainsKey("UploadedErrorKey"))
                            {
                                <div class="alert alert-danger mt-3">
                                    @ModelState["UploadedErrorKey"].Errors[0].ErrorMessage
                                </div>
                            }
                        </form>
                    </div>

                    <div class="profile-section">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="form-label">Mot de passe</span>
                            </div>
                            <div>
                                <a asp-page="../../Account/ForgotPassword" class="link-action">
                                    Modifier <i class="bi bi-pencil-square ms-1"></i>
                                </a>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="form-label">Authentification à deux facteurs</span>
                            </div>
                            <div>
                                @if (Model.IsTwoFactorEnabled)
                                {
                                    <form method="post" asp-page-handler="Disable" class="two-factor-toggle">
                                        <button type="submit" class="btn btn-sm link-action">
                                            Désactiver <i class="bi bi-toggle-on text-success ms-1"></i>
                                        </button>
                                    </form>
                                    <div class="two-factor-status">
                                        <i class="bi bi-x-circle text-danger"></i>
                                        <span class="status-not-recommended status-badge">Non recommandé</span>
                                    </div>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Enable" class="two-factor-toggle">
                                        <button type="submit" class="btn btn-sm link-action">
                                            Activer <i class="bi bi-toggle-off text-secondary ms-1"></i>
                                        </button>
                                    </form>
                                    <div class="two-factor-status">
                                        <i class="bi bi-check2-circle text-success"></i>
                                        <span class="status-recommended status-badge">Recommandé</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colonne Informations personnelles -->
            <div class="col-md-7">
                <div class="profile-card">
                    <h3 class="profile-title text-primary" >Informations Personnelles</h3>
                    
                    <form>
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Prénom</label>
                                <input type="text" class="form-control" value="@Model.CurrentUser.FirstName" readonly>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nom</label>
                                <input type="text" class="form-control" value="@Model.CurrentUser.LastName" readonly>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Téléphone</label>
                            <div class="d-flex align-items-center">
                                <input type="text" class="form-control me-2" style="flex: 1;" 
                                       value="@(Model.CurrentUser.PhoneNumber ?? "Non renseigné")" readonly>
                                <span class="status-unverified status-badge">
                                    <i class="bi bi-x-circle me-1"></i>Non vérifié
                                </span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Email</label>
                            <div class="d-flex align-items-center mb-2">
                                <input type="text" class="form-control me-2" style="flex: 1;" 
                                       value="@Model.CurrentUser.Email" readonly>
                                @if (Model.CurrentUser.EmailConfirmed)
                                {
                                    <span class="status-verified status-badge">
                                        <i class="bi bi-check-circle me-1"></i>Vérifié
                                    </span>
                                }
                            </div>
                            @if (!Model.CurrentUser.EmailConfirmed && Model.CurrentUser.Email != null)
                            {
                                <div class="d-flex align-items-center">
                                    <a asp-page="../../Account/VerifyEmail" class="btn-profile me-3">
                                        <i class="bi bi-envelope-check me-2"></i>Vérifier l'email
                                    </a>
                                    <span class="text-danger small">
                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                        Vérifiez votre email pour sécuriser votre compte
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="text-center mt-4">
                            <a asp-page="./Addresses" class="link-action">
                                <i class="bi bi-geo-alt me-2"></i>Paramètres d'adresse
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --light-bg: #f8f9fa;
            --dark-text: #212529;
            --border-radius: 12px;
            --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .profile-container {
            background-color: #f5f7fb;
            min-height: 100vh;
            padding: 2rem 0;
        }

        .profile-card {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            padding: 2rem;
            margin-bottom: 1.5rem;
        }

        .profile-pic {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid white;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
            margin: 0 auto;
            display: block;
        }

        .profile-section {
            margin-bottom: 2rem;
        }

        .profile-title {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .form-label {
            font-weight: 500;
            color: var(--dark-text);
            margin-bottom: 0.5rem;
        }

        .form-control {
            border-radius: var(--border-radius);
            padding: 0.75rem;
            border: 1px solid #e0e0e0;
        }

        .form-control:read-only {
            background-color: #f8f9fa;
            border-color: #e0e0e0;
        }

        .btn-profile {
            background-color: var(--primary-color);
            color: white;
            border-radius: var(--border-radius);
            padding: 0.5rem 1.5rem;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-profile:hover {
            background-color: var(--secondary-color);
            transform: translateY(-2px);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .status-verified {
            background-color: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }

        .status-unverified {
            background-color: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .status-recommended {
            background-color: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }

        .status-not-recommended {
            background-color: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .link-action {
            color: var(--primary-color);
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
        }

        .link-action:hover {
            color: var(--secondary-color);
            text-decoration: underline;
        }

        .file-upload {
            position: relative;
            overflow: hidden;
            display: inline-block;
        }

        .file-upload-input {
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

        .two-factor-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .two-factor-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* MODE SOMBRE */
        [data-theme="dark"] .profile-container {
            background: #0a0e14;
        }

        [data-theme="dark"] .profile-card {
            background: rgba(30, 39, 52, 0.8) !important;
            border: 1px solid rgba(26, 140, 255, 0.15);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
            color: #f0f4f8 !important;
        }

        [data-theme="dark"] .profile-section h5,
        [data-theme="dark"] .profile-section h6,
        [data-theme="dark"] .profile-card h3,
        [data-theme="dark"] .profile-card h4,
        [data-theme="dark"] .profile-card h5,
        [data-theme="dark"] .profile-card h6 {
            color: #f0f4f8 !important;
        }

        [data-theme="dark"] .form-label {
            color: #f0f4f8 !important;
        }

        [data-theme="dark"] .form-control {
            background: rgba(15, 20, 28, 0.6) !important;
            border: 1px solid rgba(26, 140, 255, 0.2);
            color: #f0f4f8 !important;
        }

        [data-theme="dark"] .form-control:focus {
            background: rgba(15, 20, 28, 0.8) !important;
            border-color: rgba(26, 140, 255, 0.5);
            color: #f0f4f8 !important;
        }

        [data-theme="dark"] .form-control::placeholder {
            color: #94a3b8 !important;
        }

        [data-theme="dark"] .text-muted {
            color: #94a3b8 !important;
        }

        [data-theme="dark"] .link-action {
            color: #1a8cff !important;
        }

        [data-theme="dark"] .link-action:hover {
            color: #3b9eff !important;
        }

        [data-theme="dark"] .profile-pic {
            border-color: rgba(26, 140, 255, 0.2) !important;
        }

        [data-theme="dark"] .profile-section {
            border-color: rgba(26, 140, 255, 0.15) !important;
        }

        [data-theme="dark"] .btn-profile {
            background: rgba(26, 140, 255, 0.2) !important;
            border: 1px solid rgba(26, 140, 255, 0.3);
            color: #1a8cff !important;
        }

        [data-theme="dark"] .btn-profile:hover {
            background: rgba(26, 140, 255, 0.3) !important;
            border-color: rgba(26, 140, 255, 0.5);
            color: #3b9eff !important;
        }

        [data-theme="dark"] .alert-danger {
            background: rgba(248, 113, 113, 0.15) !important;
            border-color: rgba(248, 113, 113, 0.3);
            color: #fca5a5 !important;
        }

        [data-theme="dark"] .alert-success {
            background: rgba(74, 222, 128, 0.15) !important;
            border-color: rgba(74, 222, 128, 0.3);
            color: #86efac !important;
        }

        [data-theme="dark"] .status-recommended {
            background-color: rgba(74, 222, 128, 0.15) !important;
            color: #4ade80 !important;
        }

        [data-theme="dark"] .status-not-recommended {
            background-color: rgba(248, 113, 113, 0.15) !important;
            color: #f87171 !important;
        }
    </style>
}
