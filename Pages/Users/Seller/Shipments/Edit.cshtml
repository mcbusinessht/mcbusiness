@page 
@model MCBusiness.Pages.Users.Seller.Shipments.EditModel
@using MCBusiness.Models;
@{
    ViewData["Title"] = "Modifier Livraison";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-3 d-none d-lg-block border-end">
            <partial name="_SideBarPartial"/>
        </div>
         <button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
                    style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
                    data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                <i class="bi bi-list fs-4"></i>
            </button>

            
        <div class="col-lg-9">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="h5 mb-0">
                        <i class="bi bi-pencil me-2"></i>@ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Shipment.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label">Commande</label>
                            <input type="hidden" asp-for="Shipment.OrderProductId" />  
                            <input class="form-control" value="@Model.Shipment.OrderProduct?.OrderId" readonly />
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Shipment.TrackingNumber" class="form-label">Numéro de suivi</label>
                            <input asp-for="Shipment.TrackingNumber" class="form-control" readonly/>
                            <span asp-validation-for="Shipment.TrackingNumber" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Shipment.DeliveryPersonId" class="form-label">Livreur</label>
                            <select asp-for="Shipment.DeliveryPersonId" class="form-select" 
                                    asp-items="ViewBag.DeliveryPersonId">
                            </select>
                            <span asp-validation-for="Shipment.DeliveryPersonId" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Shipment.ShippingDate" class="form-label">Date d'expédition</label>
                            <input asp-for="Shipment.ShippingDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Shipment.ShippingDate" class="text-danger"></span>
                        </div>    
                        
                        <div class="mb-3">
                            <label asp-for="Shipment.DeliveryDate" class="form-label">Date de livraison</label>
                            <input asp-for="Shipment.DeliveryDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="Shipment.DeliveryDate" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Statut</label>
                            <input class="form-control" value="@Model.Shipment.Status" readonly />
                            <div class="form-text">Le statut se change depuis la liste des livraisons avec confirmation.</div>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-page="Index" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Offcanvas Sidebar Mobile -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="_SideBarPartial"/>
        </div>
    </div>
    <!-- Bouton menu mobile -->
    <button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
            style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
            data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
        <i class="bi bi-list fs-4"></i>
    </button>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle sidebar groups
        document.querySelectorAll('.sidebar-group').forEach(group => {
            const item = group.querySelector('.sidebar-item');
            const submenu = group.querySelector('.sidebar-submenu');
            
            // Open if contains active item
            if (submenu.querySelector('.active')) {
                group.classList.add('active');
            }
            
            item.addEventListener('click', function(e) {
                if (e.target.tagName === 'A') return;
                group.classList.toggle('active');
            });
        });
        
        // Toggle sidebar subgroups
        document.querySelectorAll('.sidebar-subgroup').forEach(group => {
            const item = group.querySelector('.sidebar-subitem');
            const submenu = group.querySelector('.sidebar-subsubmenu');
            
            // Open if contains active item
            if (submenu.querySelector('.active')) {
                group.classList.add('active');
            }
            
            item.addEventListener('click', function(e) {
                if (e.target.tagName === 'A') return;
                group.classList.toggle('active');
            });
        });
    });
</script>
