@page
@model             MCBusiness.Pages.Users.Seller.Products.CreateModel

@{
    ViewData["Title"] = "Créer un nouveau produit";
}

<div class="container-fluid px-0">
    <div class="row g-0">
        <!-- Sidebar -->
        <div class="col-lg-3 d-none d-lg-block border-end">
            <partial name="_SideBarPartial"/>
        </div>
        
        <!-- Main Content -->
        <div class="col-lg-9 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 fw-bold text-primary">
                    <i class="bi bi-plus-circle me-2"></i>@ViewData["Title"]
                </h2>
                <a asp-page="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Retour à la liste
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-box-seam me-2"></i>Détails du produit
                    </h5>
                </div>
                
                <div class="card-body">
                    <form method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="row g-3">
                            <!-- Nom du produit -->
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="Product.Name" class="form-control" maxlength="40" placeholder=" " required />
                                    <label asp-for="Product.Name" class="form-label required">
                                        <i class="bi bi-tag me-1"></i>Nom du produit
                                    </label>
                                    <span asp-validation-for="Product.Name" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating">
                                   <label asp-for="Product.Description" class="form-label fw-bold">
                                        <i class="bi bi-card-text me-1"></i>Description
                                    </label>
                                    <textarea asp-for="Product.Description" maxlength="500" class="form-control" rows="3"></textarea>
                                    <span asp-validation-for="Product.Description" class="text-danger small"></span>
                                </div>
                            </div>
                       
                            <!-- Catégorie -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Product.CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                        <option value="">Sélectionnez une catégorie</option>
                                    </select>
                                    <label asp-for="Product.CategoryId" class="form-label">
                                        <i class="bi bi-grid me-1"></i>Catégorie
                                    </label>
                                    <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <!-- Entreprise -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Product.CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
                                        <option value="">Sélectionnez une entreprise</option>
                                    </select>
                                    <label asp-for="Product.CompanyId" class="form-label">
                                        <i class="bi bi-building me-1"></i>Entreprise
                                    </label>
                                    <span asp-validation-for="Product.CompanyId" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <!-- Boutons -->
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-primary px-4">
                                        <i class="bi bi-save me-1"></i>Enregistrer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Offcanvas Sidebar Mobile -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="_SideBarPartial"/>
        </div>
    </div>
    <!-- Bouton menu mobile -->
    <button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
            style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
            data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
        <i class="bi bi-list fs-4"></i>
    </button>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle sidebar groups
            document.querySelectorAll('.sidebar-group').forEach(group => {
                const item = group.querySelector('.sidebar-item');
                const submenu = group.querySelector('.sidebar-submenu');
                
                // Open if contains active item
                if (submenu.querySelector('.active')) {
                    group.classList.add('active');
                }
                
                item.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    group.classList.toggle('active');
                });
            });
            
            // Toggle sidebar subgroups
            document.querySelectorAll('.sidebar-subgroup').forEach(group => {
                const item = group.querySelector('.sidebar-subitem');
                const submenu = group.querySelector('.sidebar-subsubmenu');
                
                // Open if contains active item
                if (submenu.querySelector('.active')) {
                    group.classList.add('active');
                }
                
                item.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    group.classList.toggle('active');
                });
            });
        });
    </script>
    <script>
        // Validation Bootstrap native
        (function () {
            'use strict'
            
            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            const forms = document.querySelectorAll('.needs-validation')
            
            // Loop over them and prevent submission
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    
                    form.classList.add('was-validated')
                }, false)
            })
        })()
        
        // Ajout des astérisques pour les champs requis
        document.querySelectorAll('.required').forEach(label => {
            if (!label.innerHTML.includes('*')) {
                label.innerHTML += ' <span class="text-danger">*</span>';
            }
        });
    </script>
    
    <style>
        /* Style minimal pour les labels requis */
        .form-label.required::after {
            content: " *";
            color: #dc3545;
        }
    </style>
}