@page
@model MCBusiness.Pages.Users.Seller.Products.ProductVariants.EditModel

@{
    ViewData["Title"] = "Modifier Variante de Produit";
}



<!-- Bouton menu mobile -->
<button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
        style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
        data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
    <i class="bi bi-list fs-4"></i>
</button>

<!-- Offcanvas Sidebar Mobile -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <partial name="_SideBarPartial"/>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar version desktop -->
        <div class="col-lg-3 col-md-3 col-xl-3 d-none d-lg-block bg-white border-end vh-100 sticky-top">
            <partial name="_SideBarPartial"/>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>Modifier la variante @Model.ProductVariant.Sku
                    </h4>
                </div>
                
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="ProductVariant.Id" />
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ProductVariant.ProductId" class="form-select" asp-items="ViewBag.ProductId">
                                        <option value="">Sélectionnez un produit</option>
                                    </select>
                                    <label asp-for="ProductVariant.ProductId" class="form-label"></label>
                                    <span asp-validation-for="ProductVariant.ProductId" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ProductVariant.Sku" class="form-control" placeholder=" " />
                                    <label asp-for="ProductVariant.Sku" class="form-label required"></label>
                                    <span asp-validation-for="ProductVariant.Sku" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ProductVariant.Price" type="number"  class="form-control" placeholder=" " />
                                    <label asp-for="ProductVariant.Price" class="form-label required"></label>
                                    <span asp-validation-for="ProductVariant.Price" class="text-danger small"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ProductVariant.Quantity" class="form-control" placeholder=" " />
                                    <label asp-for="ProductVariant.Quantity" class="form-label required"></label>
                                    <span asp-validation-for="ProductVariant.Quantity" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="card border-0 bg-light">
                                    <div class="card-body">
                                        <h5 class="mb-3">
                                            <i class="bi bi-truck me-2"></i>Livraison
                                        </h5>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <select asp-for="ProductVariant.ShippingPackageType" class="form-select" asp-items="Html.GetEnumSelectList<MCBusiness.Models.ShippingPackageType>()"></select>
                                                    <label asp-for="ProductVariant.ShippingPackageType">Type de colis</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <input asp-for="ProductVariant.WeightKg" type="number" step="0.01" min="0" class="form-control" placeholder=" " />
                                                    <label asp-for="ProductVariant.WeightKg">Poids optionnel (kg)</label>
                                                    <span asp-validation-for="ProductVariant.WeightKg" class="text-danger small"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="ProductVariant.RequiresSpecialHandling">
                                                    <label class="form-check-label" asp-for="ProductVariant.RequiresSpecialHandling">Fragile ou manutention spéciale</label>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="ProductVariant.ShippingQuoteRequired">
                                                    <label class="form-check-label" asp-for="ProductVariant.ShippingQuoteRequired">Livraison sur devis</label>
                                                </div>
                                            </div>
                                        </div>
                                        <small class="text-muted d-block mt-2">Ces informations servent au calcul automatique des frais au checkout.</small>
                                    </div>
                                </div>
                            </div>
                            

                            
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckChecked" asp-for="ProductVariant.IsAvailable">
                                    <label class="form-check-label" for="flexSwitchCheckChecked">
                                        @Html.DisplayNameFor(model => model.ProductVariant.IsAvailable)
                                    </label>
                                </div>
                            </div>
                            
                            <div class="col-12 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a asp-page="./Index" class="btn btn-outline-secondary me-md-2">
                                        <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-1"></i> Enregistrer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Offcanvas Sidebar Mobile -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="_SideBarPartial"/>
        </div>
    </div>
    <!-- Bouton menu mobile -->
    <button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
            style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
            data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
        <i class="bi bi-list fs-4"></i>
    </button>

<!-- Ajout des icônes Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle sidebar groups
            document.querySelectorAll('.sidebar-group').forEach(group => {
                const item = group.querySelector('.sidebar-item');
                const submenu = group.querySelector('.sidebar-submenu');
                
                // Open if contains active item
                if (submenu.querySelector('.active')) {
                    group.classList.add('active');
                }
                
                item.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    group.classList.toggle('active');
                });
            });
            
            // Toggle sidebar subgroups
            document.querySelectorAll('.sidebar-subgroup').forEach(group => {
                const item = group.querySelector('.sidebar-subitem');
                const submenu = group.querySelector('.sidebar-subsubmenu');
                
                // Open if contains active item
                if (submenu.querySelector('.active')) {
                    group.classList.add('active');
                }
                
                item.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    group.classList.toggle('active');
                });
            });
        });
    </script>
    <script>
        // Ajout des astérisques pour les champs requis
        document.querySelectorAll('.required').forEach(label => {
            label.innerHTML += ' <span class="text-danger">*</span>';
        });
    </script>
    
    <style>
        /* Style minimal pour les labels requis */
        .form-label.required::after {
            content: " *";
            color: #dc3545;
        }
    </style>
}
