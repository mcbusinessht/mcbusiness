@page
@model             MCBusiness.Pages.Users.Seller.Products.ProductImages.IndexModel

@{
    ViewData["Title"] = $"Images du produit - {Model.ProductVariant.Product.Name}";
}



<!-- Bouton menu mobile -->
<button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
        style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
        data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
    <i class="bi bi-list fs-4"></i>
</button>

<!-- Offcanvas Sidebar Mobile -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <partial name="_SideBarPartial"/>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar version desktop -->
        <div class="col-lg-3 col-md-3 col-xl-3 d-none d-lg-block bg-white border-end vh-100 sticky-top">
            <partial name="_SideBarPartial"/>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">
                            <i class="bi bi-images me-2"></i>@Model.ProductVariant.Product.Name
                        </h4>
                        <a asp-page="../ProductImages/Create" asp-route-id="@Model.ProductVariant.Id" 
                           class="btn btn-light btn-sm">
                            <i class="bi bi-plus-circle me-1"></i>Ajouter une photo
                        </a>
                    </div>
                </div>
                
                <div class="card-body">
                    <!-- Galerie d'images -->
                    @if(Model.ProductImage.Count > 0)
                    {
                        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                            @foreach(var img in Model.ProductImage)
                            {
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <img src="@img.Url" class="card-img-top object-fit-cover" 
                                             alt="Image du produit" style="height: 150px;">
                                        <div class="card-body text-center p-2">
                                            <a asp-page="./Delete" asp-route-id="@img.Id" 
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash me-1"></i>Supprimer
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            <h5 class="mt-3">Aucune image disponible</h5>
                            <p class="text-muted">Aucune image n'a été ajoutée pour ce produit</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Caractéristiques du variant -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-tags me-2"></i>Caractéristiques du variant
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach(var ch in Model.ProductVariantCharacteristic)
                        {
                            <div class="col-md-6 mb-2">
                                <div class="d-flex align-items-center bg-light p-2 rounded">
                                    <span class="fw-bold me-2">@ch.Characteristic.Name :</span>
                                    <span>@ch.CharacteristicValue.Value</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Offcanvas Sidebar Mobile -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="_SideBarPartial"/>
        </div>
    </div>

<style>
    .object-fit-cover {
        object-fit: cover;
        object-position: center;
    }
</style>

    
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle sidebar groups
        document.querySelectorAll('.sidebar-group').forEach(group => {
            const item = group.querySelector('.sidebar-item');
            const submenu = group.querySelector('.sidebar-submenu');
            
            // Open if contains active item
            if (submenu.querySelector('.active')) {
                group.classList.add('active');
            }
            
            item.addEventListener('click', function(e) {
                if (e.target.tagName === 'A') return;
                group.classList.toggle('active');
            });
        });
        
        // Toggle sidebar subgroups
        document.querySelectorAll('.sidebar-subgroup').forEach(group => {
            const item = group.querySelector('.sidebar-subitem');
            const submenu = group.querySelector('.sidebar-subsubmenu');
            
            // Open if contains active item
            if (submenu.querySelector('.active')) {
                group.classList.add('active');
            }
            
            item.addEventListener('click', function(e) {
                if (e.target.tagName === 'A') return;
                group.classList.toggle('active');
            });
        });
    });
</script>