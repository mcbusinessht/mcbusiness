@page
@model MCBusiness.Pages.Users.Seller.Products.DeleteModel
@{
    ViewData["Title"] = "Supprimer le Produit";
}

@if (Model.Product == null)
{
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Produit non trouvé</h4>
        <p>Le produit que vous essayez de supprimer n'existe pas ou a déjà été supprimé.</p>
        <hr>
        <a asp-page="./Index" class="btn btn-outline-primary">Retour à la liste</a>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-3 d-none d-lg-block border-end">
                <partial name="_SideBarPartial"/>
            </div>
            
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-4">    
                    <div>
                        <h1 class="display-6 fw-bold text-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>@ViewData["Title"]
                        </h1>
                        <p class="text-muted mb-0">Confirmez la suppression définitive de ce produit</p>
                    </div>
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                    </a>
                </div>

                <div class="card border-danger border-2 shadow-sm">
                    <div class="card-header bg-danger text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-trash me-2"></i>Confirmation de suppression
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger" role="alert">
                            <h4 class="alert-heading">
                                <i class="bi bi-exclamation-octagon me-2"></i>Attention !
                            </h4>
                            <p>La suppression de ce produit entraînera également la suppression de toutes ses variantes et données associées.</p>
                            <hr>
                            <p class="mb-0">Cette action ne peut être annulée une fois confirmée.</p>
                        </div>

                        <div class="row">
                            <!-- Détails du produit -->
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="text-primary mb-3">
                                        <i class="bi bi-box-seam me-2"></i>Informations Produit
                                    </h5>
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="bg-light bg-opacity-10 p-2 rounded me-3">
                                            <i class="bi bi-tag text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0">@Model.Product.Name</h6>
                                            @if (!string.IsNullOrEmpty(Model.Product.Description))
                                            {
                                                <small class="text-muted">@Model.Product.Description</small>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="text-primary mb-3">
                                        <i class="bi bi-calendar me-2"></i>Historique
                                    </h5>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="bg-light p-3 rounded">
                                                <small class="text-muted">Création</small>
                                                <div class="fw-bold">@LocalTime.Format(Model.Product.CreatedAt, "dd/MM/yyyy")</div>
                                            </div>
                                        </div>
                                    </div>          
                                </div>
                            </div>

                            <!-- Liens associés -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="bi bi-diagram-3 me-2"></i>Relations
                                </h5>
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-2">
                                                <i class="bi bi-building me-2 text-primary"></i>
                                                <strong>Compagnie :</strong> 
                                                @(Model.Product.Company?.Name ?? "Non spécifié")
                                            </li>
                                            <li class="mb-2">
                                                <i class="bi bi-bookmarks me-2 text-primary"></i>
                                                <strong>Catégorie :</strong> 
                                                @(Model.Product.Category?.Name ?? "Non spécifié")
                                            </li>
                                            <li>
                                                <i class="bi bi-collection me-2 text-primary"></i>
                                                <strong>Variantes :</strong> 
                                                @(Model.Product.Variants?.Count ?? 0)
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light border-top">
                        <form method="post" class="d-flex justify-content-between">
                            <input type="hidden" asp-for="Product.Id" />
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Annuler
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2"></i>Confirmer la suppression
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Menu mobile -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <partial name="_SideBarPartial"/>
    </div>
</div>

<button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
        style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
        data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
    <i class="bi bi-list fs-4"></i>
</button>

@section Styles {
    <style>
        .card {
            box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.05);
        }
        .list-unstyled li {
            padding: 0.5rem 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        .list-unstyled li:last-child {
            border-bottom: none;
        }
        .border-danger {
            border-color: #dc3545 !important;
        }
        .bg-light {
            background-color: #f8f9fa!important;
        }
    </style>
}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle sidebar groups
            document.querySelectorAll('.sidebar-group').forEach(group => {
                const item = group.querySelector('.sidebar-item');
                const submenu = group.querySelector('.sidebar-submenu');
                
                // Open if contains active item
                if (submenu.querySelector('.active')) {
                    group.classList.add('active');
                }
                
                item.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    group.classList.toggle('active');
                });
            });
            
            // Toggle sidebar subgroups
            document.querySelectorAll('.sidebar-subgroup').forEach(group => {
                const item = group.querySelector('.sidebar-subitem');
                const submenu = group.querySelector('.sidebar-subsubmenu');
                
                // Open if contains active item
                if (submenu.querySelector('.active')) {
                    group.classList.add('active');
                }
                
                item.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    group.classList.toggle('active');
                });
            });
        });
    </script>
