@using MCBusiness.Services;
@using MCBusiness.Models;
@using Microsoft.AspNetCore.Identity;
@inject NoticeService NoticeService;
@inject UserManager<ApplicationUser> userManager;

@{
    var ordercount = 0;
    var userId = userManager.GetUserId(User) ; 
    var currentUrl = Context.Request.Path.Value ?? string.Empty;
    var pathComparison = StringComparison.OrdinalIgnoreCase;
    Func<string, bool> isActive = path =>
        currentUrl.Equals(path, pathComparison) || currentUrl.StartsWith(path + "/", pathComparison);
    ordercount = await NoticeService.GetNewCommandeAsync(userId); 
}

