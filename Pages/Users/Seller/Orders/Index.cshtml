@page
@model             MCBusiness.Pages.Users.Seller.Orders.IndexModel

@{
    ViewData["Title"] = "Gestion des Commandes";
}


<!-- Bouton menu mobile -->
<button type="button" class="btn btn-primary rounded-circle position-fixed d-lg-none" 
        style="bottom: 2rem; right: 2rem; width: 56px; height: 56px; z-index: 1030;"
        data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
    <i class="bi bi-list fs-4"></i>
</button>

<!-- Offcanvas Sidebar Mobile -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <partial name="_SideBarPartial"/>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar version desktop -->
        <div class="col-lg-3 col-md-3 col-xl-3 d-none d-lg-block bg-white border-end vh-100 sticky-top">
            <partial name="_SideBarPartial"/>
        </div>


        <!-- Main Content -->
        <div class="col-lg-9 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 fw-bold text-primary">
                    <i class="bi bi-cart me-2"></i>Liste des Commandes
                </h2>
                
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-primary text-white">
                                <tr>
                                    <th class="ps-3">Date</th>
                                    <th># Commande</th>
                                    <th>Client</th>
                                    <th>Montant</th>
                                    <th>Adresse</th>
                                    <th>Statut</th>
                                    <th class="text-end pe-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if(Model.Order == null || !Model.Order.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <i class="bi bi-cart text-muted" style="font-size: 2rem;"></i>
                                            <h5 class="mt-3">Aucune commande trouvée</h5>
                                            <p class="text-muted">Commencez par créer votre première commande</p>
                                            
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Order)
                                    {
                                        <tr>
                                            <td class="ps-3">@LocalTime.Format(item.OrderDate, "dd/MM/yyyy HH:mm")</td>
                                            <td>#@item.Id</td>
                                            <td>@item.User?.UserName</td>
                                            <td>@item.TotalAmount.ToString("C")</td>
                                            <td>
                                                <div class="d-inline-block text-truncate" style="max-width: 150px;">
                                                    @item.Address?.FullAddress
                                                </div>
                                            </td>
                                            <td>
                                                @{
                                                    @using MCBusiness.Models;
                                                    var statusClass = "bg-secondary";
                                                    switch(item.Status)
                                                    {
                                                        case OrderStatus.Pending:
                                                            statusClass = "bg-info";
                                                            break;
                                                        case OrderStatus.Paid:
                                                            statusClass = "bg-primary";
                                                            break;
                                                        case OrderStatus.Delivered:
                                                            statusClass = "bg-success";
                                                            break;
                                                        case OrderStatus.Cancelled:
                                                            statusClass = "bg-danger";
                                                            break;
                                                    }
                                                }
                                                <span class="badge @statusClass rounded-pill">
                                                    @item.Status
                                                </span>
                                            </td>
                                            <td class="text-end pe-3">
                                                <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.Id">
                                                    <i class="bi bi-eye me-2"></i>Détails
                                                </a>
                                                @* <a class="dropdown-item" asp-page="./UpdateOrderProductStatus" asp-route-id="@item.Id">
                                                    <i class="bi bi-eye me-2"></i>Update
                                                </a> *@
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
                @if (Model.Order != null && Model.Order.Any())
                {
                    <div class="card-footer bg-light">
                        <div class="row">
                            <div class="col-6">
                                <small class="text-muted">Total: @Model.Order.Count() commandes</small>
                            </div>
                            <div class="col-6 text-end">
                                <small class="text-muted">Montant total: @Model.Order.Sum(o => o.TotalAmount).ToString("C")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

    

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle sidebar groups
        document.querySelectorAll('.sidebar-group').forEach(group => {
            const item = group.querySelector('.sidebar-item');
            const submenu = group.querySelector('.sidebar-submenu');
            
            // Open if contains active item
            if (submenu.querySelector('.active')) {
                group.classList.add('active');
            }
            
            item.addEventListener('click', function(e) {
                if (e.target.tagName === 'A') return;
                group.classList.toggle('active');
            });
        });
        
        // Toggle sidebar subgroups
        document.querySelectorAll('.sidebar-subgroup').forEach(group => {
            const item = group.querySelector('.sidebar-subitem');
            const submenu = group.querySelector('.sidebar-subsubmenu');
            
            // Open if contains active item
            if (submenu.querySelector('.active')) {
                group.classList.add('active');
            }
            
            item.addEventListener('click', function(e) {
                if (e.target.tagName === 'A') return;
                group.classList.toggle('active');
            });
        });
    });
</script>
