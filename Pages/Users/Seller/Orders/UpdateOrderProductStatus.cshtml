@page
@model MCBusiness.Pages.Users.Seller.Orders.UpdateOrderProductStatusModel
@using MCBusiness.Models;
@{
    ViewData["Title"] = "Mettre à jour le statut du produit";
}

<h1>Mettre à jour le statut</h1>

<h4>Produit de commande #@Model.OrderProduct.Id</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OrderProduct.Id" />

            <div class="form-group">
                <label class="control-label">Produit</label>
                <input class="form-control" value="@Model.OrderProduct.ProductVariant?.Sku" readonly />
            </div>

            <div class="form-group">
                <label class="control-label">Statut actuel</label>
                <input class="form-control" value="@Model.OrderProduct.Status" readonly />
            </div>

            <div class="form-group">
                <label asp-for="NewStatus" class="control-label">Nouveau statut</label>
                <select asp-for="NewStatus" class="form-control" asp-items="Html.GetEnumSelectList<OrderProductStatus>()"></select>
                <span asp-validation-for="NewStatus" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Enregistrer" class="btn btn-primary" />
                <a asp-page="./Details" asp-route-id="@Model.OrderProduct.OrderId" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
    
