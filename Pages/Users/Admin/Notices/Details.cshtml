@page
@model MCBusiness.Pages.Users.Admin.Notices.DetailsModel

@{
    ViewData["Title"] = "Détails de l'annonce";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-megaphone me-2"></i>Détails de l'annonce
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                Informations générales
                            </h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-3">
                                    <i class="bi bi-card-heading me-1"></i> @Html.DisplayNameFor(model => model.Notice.Name)
                                </dt>
                                <dd class="col-sm-9">
                                    <strong>@Html.DisplayFor(model => model.Notice.Name)</strong>
                                </dd>

                                <dt class="col-sm-3">
                                    <i class="bi bi-tag me-1"></i> Type d'annonce
                                </dt>
                                <dd class="col-sm-9">
                                    <span class="badge bg-secondary">
                                        @Html.DisplayFor(model => model.Notice.Type)
                                    </span>
                                </dd>

                                <dt class="col-sm-3">
                                    <i class="bi bi-calendar-range me-1"></i> Période
                                </dt>
                                <dd class="col-sm-9">
                                    <div>
                                        <strong>Début :</strong> @Model.Notice.StartDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    <div>
                                        <strong>Fin :</strong> @Model.Notice.EndDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-card-text me-2"></i>
                                Contenu détaillé
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="p-3 bg-light rounded">
                                @Html.Raw(Model.Notice.Content.Replace("\n", "<br />"))
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-page="./Edit" asp-route-id="@Model.Notice.Id" class="btn btn-primary px-4">
                            <i class="bi bi-pencil-square me-1"></i> Modifier
                        </a>
                        <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-list-ul me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
        }
        .card-header {
            font-weight: 500;
        }
        dt {
            font-weight: 500;
            color: #6c757d;
        }
        .bg-light {
            background-color: #f8f9fa !important;
        }
    </style>
}