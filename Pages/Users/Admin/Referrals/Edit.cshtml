@page
@model MCBusiness.Pages.Users.Admin.Referrals.EditModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@{
    ViewData["Title"] = "Modifier Parrainage";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                <input type="hidden" asp-for="Referral.Id" />

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-person-plus me-2"></i>Parrain
                                    </h5>
                                    <div class="form-group mb-3">
                                        <label asp-for="Referral.ReferrerId" class="form-label fw-semibold"></label>
                                        <select asp-for="Referral.ReferrerId" class="form-select" asp-items="ViewBag.ReferrerId">
                                            <option value="">-- Sélectionner un parrain --</option>
                                        </select>
                                        <span asp-validation-for="Referral.ReferrerId" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-person-check me-2"></i>Filleul
                                    </h5>
                                    <div class="form-group mb-3">
                                        <label asp-for="Referral.ReferredId" class="form-label fw-semibold"></label>
                                        <select asp-for="Referral.ReferredId" class="form-select" asp-items="ViewBag.ReferredId">
                                            <option value="">-- Sélectionner un filleul --</option>
                                        </select>
                                        <span asp-validation-for="Referral.ReferredId" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-calendar-date me-2"></i>Détails
                                    </h5>
                                    <div class="form-group mb-3">
                                        <label asp-for="Referral.ReferredDate" class="form-label fw-semibold"></label>
                                        <input asp-for="Referral.ReferredDate" class="form-control" type="DateTimeOffset-local" />
                                        <span asp-validation-for="Referral.ReferredDate" class="text-danger small"></span>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label disabled value="0.00" class="form-label fw-semibold"></label>
                                        <div class="input-group">
                                            <input disabled value="0.00" class="form-control" type="number" step="0.01" />
                                            <span class="input-group-text">�</span>
                                        </div>
                                        <span style="display:none" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="form-group mt-4 text-center">
                                    <button type="submit" class="btn btn-primary px-4 me-2">
                                        <i class="bi bi-save me-1"></i> Enregistrer
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Formatage de la date pour l'input DateTimeOffset-local
            if ($('#Referral_ReferredDate').val()) {
                const date = new Date($('#Referral_ReferredDate').val());
                const formatted = date.toISOString().slice(0, 16);
                $('#Referral_ReferredDate').val(formatted);
            }

            // Validation améliorée
            $('.needs-validation').on('submit', function(event) {
                if (!this.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                $(this).addClass('was-validated');
            });
        });
    </script>
}

@section Styles {
    <style>
        .form-label {
            margin-bottom: 0.5rem;
        }
        .form-select, .form-control {
            padding: 0.5rem 0.75rem;
            border-radius: 0.375rem;
        }
        .fw-semibold {
            font-weight: 600;
        }
        .border-bottom {
            border-bottom: 2px solid #dee2e6 !important;
        }
        .needs-validation .form-control:invalid,
        .needs-validation .form-select:invalid {
            border-color: #dc3545;
        }
        .was-validated .form-control:invalid,
        .was-validated .form-select:invalid {
            border-color: #dc3545;
        }
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
}
