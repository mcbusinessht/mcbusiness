@page
@model MCBusiness.Pages.Users.Admin.Referrals.DetailsModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@{
    ViewData["Title"] = "Détails du Parrainage";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-person-plus me-2"></i>Informations du Parrain
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom :</span> 
                                        @Model.Referral.Referrer?.FirstName @Model.Referral.Referrer?.LastName
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Email :</span> 
                                        @Model.Referral.Referrer?.Email
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom d'utilisateur :</span> 
                                        @Model.Referral.Referrer?.UserName
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-person-check me-2"></i>Informations du Filleul
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom :</span> 
                                        @Model.Referral.Referred?.FirstName @Model.Referral.Referred?.LastName
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Email :</span> 
                                        @Model.Referral.Referred?.Email
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom d'utilisateur :</span> 
                                        @Model.Referral.Referred?.UserName
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-calendar-date me-2"></i>Détails du Parrainage
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Date du parrainage :</span> 
                                        @Model.Referral.ReferredDate.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Montant du bonus :</span> 
                                        <span class="badge bg-warning text-dark">@@(0.00m).ToString("C")</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-page="./Edit" asp-route-id="@Model.Referral.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                        }
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-list-ul me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fw-semibold {
            font-weight: 600;
        }
        .badge {
            font-size: 0.9em;
            padding: 0.4em 0.75em;
        }
        
        .bg-warning {
            background-color: #ffc107 !important;
            color: #212529 !important;
        }
        .border-bottom {
            border-bottom: 2px solid #dee2e6 !important;
        }
    </style>
}
