@page
@model MCBusiness.Pages.Users.Admin.Referrals.DeleteModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@{
    ViewData["Title"] = "Supprimer Parrainage";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill"></i> Attention !
                        </h5>
                        <p>Vous êtes sur le point de supprimer définitivement ce parrainage. Cette action est irréversible.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-person-plus me-2"></i>Parrain
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom :</span> 
                                        @Model.Referral.Referrer?.FirstName @Model.Referral.Referrer?.LastName
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Email :</span> 
                                        @Model.Referral.Referrer?.Email
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-person-check me-2"></i>Filleul
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom :</span> 
                                        @Model.Referral.Referred?.FirstName @Model.Referral.Referred?.LastName
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Email :</span> 
                                        @Model.Referral.Referred?.Email
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-calendar-date me-2"></i>Détails
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Date :</span> 
                                        @Model.Referral.ReferredDate.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Bonus :</span> 
                                        <span class="badge bg-warning text-dark">@@(0.00m).ToString("C")</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form method="post" class="mt-4">
                        <input type="hidden" asp-for="Referral.Id" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-1"></i> Confirmer la suppression
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fw-semibold {
            font-weight: 600;
        }
        .badge {
            font-size: 0.9em;
            padding: 0.4em 0.75em;
        }
        .bg-primary {
            background-color: #0d6efd !important;
        }
        .bg-warning {
            background-color: #ffc107 !important;
            color: #212529 !important;
        }
        .border-bottom {
            border-bottom: 2px solid #dee2e6 !important;
        }
        .alert-warning {
            border-left: 4px solid #ffc107;
        }
    </style>
}
