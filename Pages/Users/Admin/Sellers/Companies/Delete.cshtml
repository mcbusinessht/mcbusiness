@page
@model MCBusiness.Pages.Users.Admin.Sellers.Companies.DeleteModel
@{
    ViewData["Title"] = "Supprimer l'entreprise";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card mb-4 border-danger">
                <div class="card-header bg-danger text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash3 me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Details" asp-route-id="@Model.Company.Id" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill"></i> Attention !
                        </h4>
                        <p>Vous êtes sur le point de supprimer définitivement cette entreprise. Cette action est irréversible.</p>
                        <hr>
                        <p class="mb-0">Veuillez confirmer que vous souhaitez supprimer l'entreprise ci-dessous :</p>
                    </div>

                    <div class="row">
                        <!-- Colonne de gauche - Informations principales -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="border-bottom pb-2 mb-3">Informations générales</h5>
                                <dl class="row">
                                    <dt class="col-sm-4">Fournisseur</dt>
                                    <dd class="col-sm-8">@Model.Company.Seller?.FullName</dd>

                                    <dt class="col-sm-4">Nom</dt>
                                    <dd class="col-sm-8 fw-bold">@Model.Company.Name</dd>

                                    <dt class="col-sm-4">Secteur</dt>
                                    <dd class="col-sm-8">
                                        <span class="badge bg-primary">@Model.Company.Sector</span>
                                    </dd>

                                    <dt class="col-sm-4">Date création</dt>
                                    <dd class="col-sm-8">@Model.Company.CreationDate.ToString("dd/MM/yyyy")</dd>
                                </dl>
                            </div>
                        </div>

                        <!-- Colonne de droite - Coordonnées -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="border-bottom pb-2 mb-3">Coordonnées</h5>
                                <dl class="row">
                                    <dt class="col-sm-4">Adresse</dt>
                                    <dd class="col-sm-8">
                                        @if (Model.Company.PrimaryAddress != null)
                                        {
                                            @Model.Company.PrimaryAddress.Line1
                                        }
                                        else
                                        {
                                            <span class="text-muted">Aucune adresse</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-4">Ville</dt>
                                    <dd class="col-sm-8">@Model.Company.PrimaryAddress?.City?.Name</dd>

                                    <dt class="col-sm-4">Département</dt>
                                    <dd class="col-sm-8">@Model.Company.PrimaryAddress?.State?.Name</dd>

                                    <dt class="col-sm-4">Pays</dt>
                                    <dd class="col-sm-8">@Model.Company.PrimaryAddress?.Country?.Name</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note :</strong> La suppression de cette entreprise affectera toutes les données associées.
                    </div>

                    <form method="post" class="mt-4">
                        <input type="hidden" asp-for="Company.Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash3 me-2"></i> Confirmer la suppression
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-header {
            padding: 1rem 1.5rem;
        }
        
        .border-danger {
            border: 1px solid var(--bs-danger);
        }
        
        dt {
            font-weight: 500;
            color: #6c757d;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .alert {
            border-radius: 0.5rem;
        }
    </style>
}