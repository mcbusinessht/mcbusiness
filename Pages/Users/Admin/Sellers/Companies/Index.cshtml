@page
@model MCBusiness.Pages.Users.Admin.Sellers.Companies.IndexModel

@{
    ViewData["Title"] = "Nos partenaires commerciaux";
}

<div class="container-fluid px-4">
    <div class="row">
        <partial name="_AdminSidebarPartial" />  

        <div class="col-lg-9">
             <div class="d-flex justify-content-between align-items-center mb-5">
                <h1 class="display-4">Nos partenaires</h1>
                <a href="https://docs.google.com/spreadsheets/d/1AC5BQGdaN2UkIRePz033BDcGIvXeyBWhQnYr6FvfXD0/edit?resourcekey=&gid=1479032666#gid=1479032666" class="btn btn-secondary">
                    <i class="bi bi-file-earmark-spreadsheet">        
                
                </i> Voir les Demandes de Partenariat    
                </a>
                <a asp-page="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Ajouter une entreprise
                </a>  
            </div>  
            <div class="row">                               
            @foreach (var item in Model.Company)
            {
                <div class="col-lg-4 col-md-6 mb-4">    
                    <div class="card h-100 shadow-sm">   
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                            @if (!string.IsNullOrEmpty(item.UrlLogo))
                            {
                                <img src="@item.UrlLogo" alt="@item.Name logo" class="img-fluid p-3" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                            }
                            else
                            {
                                <i class="bi bi-building" style="font-size: 3rem; color: #6c757d;"></i>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@item.Category?.Name</h6>
                            <p class="card-text text-truncate-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>
                        </div>
                        <ul class="list-group list-group-flush">
                            @if (item.City != null)
                            {
                                <li class="list-group-item">
                                    <i class="bi bi-geo-alt-fill text-primary me-2"></i>
                                    @item.City.Name, @item.Country?.Name
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(item.PhoneNumber))
                            {
                                <li class="list-group-item">
                                    <i class="bi bi-telephone-fill text-primary me-2"></i>
                                    @item.PhoneNumber
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <li class="list-group-item text-truncate">
                                    <i class="bi bi-envelope-fill text-primary me-2"></i>
                                    @item.Email
                                </li>
                            }
                        </ul>
                        <div class="card-footer bg-white d-flex justify-content-between">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye-fill"></i> Détails
                            </a>
                            <div>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        
        
        </div>
        </div>
    </div>     
</div>

@section Styles {
    <style>
        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-radius: 10px;
            overflow: hidden;
            opacity: 0;
            animation: fadeIn 0.5s forwards;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        
        .card-img-top {
            border-bottom: 1px solid rgba(0,0,0,0.1);
        }
        
        .text-truncate-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .list-group-item {
            padding: 0.75rem 1.25rem;
        }
        
        @@keyframes fadeIn {
            to { opacity: 1; }
        }
    </style>
}

@section Scripts {
    <script>
        // Animation d'apparition progressive
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
}