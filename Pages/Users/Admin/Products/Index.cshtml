@page
@model MCBusiness.Pages.Users.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Gestion des Produits";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-box-seam me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Choose" class="btn btn-sm btn-light">
                            <i class="bi bi-plus-circle me-1"></i> Nouveau produit
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-collection me-2"></i>Menu Produits
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="Choose" class="list-group-item list-group-item-action">
                                            <i class="bi bi-database-add me-2"></i>Ajouter un produit
                                        </a>
                                        <a asp-page="./Characteristics/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-tags me-2"></i>Caractéristiques
                                        </a>
                                        <a asp-page="./CharacteristicValues/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-card-list me-2"></i>Valeurs Caractéristiques
                                        </a>
                                        <a asp-page="./ProductVariants/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-boxes me-2"></i>Variants Produits
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tableau des produits -->
                        <div class="col-md-9">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Product[0].Name)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Product[0].Company)
                                            </th>
                                            <th>
                                                @Html.DisplayNameFor(model => model.Product[0].Category)
                                            </th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Product)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Company.Name)
                                                </td>
                                                <td>
                                                    <span class="badge bg-primary">@Html.DisplayFor(modelItem => item.Category.Name)</span>
                                                </td>
                                                <td class="text-end">
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                                                type="button" data-bs-toggle="dropdown">
                                                            Actions
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                            <li>
                                                                <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.Id">
                                                                    <i class="bi bi-eye me-2"></i>Détails
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" asp-page="./ProductVariants/Create" asp-route-id="@item.Id">
                                                                    <i class="bi bi-plus-circle me-2"></i>Ajouter Variant
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" asp-page="./ProductVariants/Index" asp-route-id="@item.Id">
                                                                    <i class="bi bi-list-ul me-2"></i>Liste Variants
                                                                </a>
                                                            </li>
                                                            @if (User.IsInRole("Admin"))
                                                            {
                                                                <li><hr class="dropdown-divider"></li>
                                                                <li>
                                                                    <a class="dropdown-item" asp-page="./Edit" asp-route-id="@item.Id">
                                                                        <i class="bi bi-pencil-square me-2"></i>Modifier
                                                                    </a>
                                                                </li>
                                                                <li>
                                                                    <a class="dropdown-item text-danger" asp-page="./Delete" asp-route-id="@item.Id">
                                                                        <i class="bi bi-trash me-2"></i>Supprimer
                                                                    </a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
        
        .dropdown-menu {
            min-width: 200px;
        }
    </style>
}