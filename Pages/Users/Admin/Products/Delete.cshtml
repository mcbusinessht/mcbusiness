@page
@model MCBusiness.Pages.Users.Admin.Products.DeleteModel
@{
    ViewData["Title"] = "Supprimer le Produit";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Produits -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-collection me-2"></i>Menu Produits
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="./Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-box-seam me-2"></i>Tous les produits
                                        </a>
                                        <a asp-page="./Choose" class="list-group-item list-group-item-action">
                                            <i class="bi bi-database-add me-2"></i>Ajouter un produit
                                        </a>
                                        <a asp-page="../Characteristics/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-tags me-2"></i>Caractéristiques
                                        </a>
                                        <a asp-page="../CharacteristicValues/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-card-list me-2"></i>Valeurs Caractéristiques
                                        </a>
                                        <a asp-page="../ProductVariants/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-boxes me-2"></i>Variants Produits
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Contenu de suppression -->
                        <div class="col-md-9">
                            <div class="alert alert-danger" role="alert">
                                <h4 class="alert-heading">
                                    <i class="bi bi-exclamation-octagon-fill me-2"></i>Attention !
                                </h4>
                                <p>Êtes-vous sûr de vouloir supprimer ce produit ? Cette action est irréversible.</p>
                                <hr>
                                <p class="mb-0">Toutes les variantes et associations liées à ce produit seront également supprimées.</p>
                            </div>

                            <div class="card border-danger mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-box-seam me-2"></i>Détails du produit
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">
                                            <i class="bi bi-tag me-2"></i>Nom du produit
                                        </dt>
                                        <dd class="col-sm-8">
                                            <strong>@Html.DisplayFor(model => model.Product.Name)</strong>
                                        </dd>

                                        <dt class="col-sm-4">
                                            <i class="bi bi-building me-2"></i>Entreprise
                                        </dt>
                                        <dd class="col-sm-8">
                                            @Html.DisplayFor(model => model.Product.Company.Address)
                                        </dd>

                                        <dt class="col-sm-4">
                                            <i class="bi bi-collection me-2"></i>Catégorie
                                        </dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-primary">@Html.DisplayFor(model => model.Product.Category.Name)</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- Avertissement variantes -->
                            @if (Model.Product.Variants.Any())
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    Ce produit contient <strong>@Model.Product.Variants.Count variante(s)</strong> qui seront également supprimées.
                                </div>
                            }

                            <form method="post">
                                <input type="hidden" asp-for="Product.Id" />
                                <div class="d-flex justify-content-between">
                                    <a asp-page="./Details" asp-route-id="@Model.Product.Id" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash-fill me-1"></i> Confirmer la suppression
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .card-border-danger {
            border-left: 4px solid #dc3545;
        }
        
        .btn-danger {
            transition: all 0.2s ease;
        }
        
        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
        }
        
        dt {
            color: #6c757d;
        }
    </style>
}