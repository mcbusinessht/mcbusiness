@page
@model MCBusiness.Pages.Users.Admin.Products.Characteristics.DeleteModel

@{
    ViewData["Title"] = "Supprimer la caractéristique";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-octagon me-2"></i>Confirmation requise
                        </h5>
                        <p class="mb-0">Êtes-vous certain de vouloir supprimer cette caractéristique ? Cette action est irréversible.</p>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th class="w-25 bg-light">@Html.DisplayNameFor(model => model.Characteristic.Name)</th>
                                    <td>@Html.DisplayFor(model => model.Characteristic.Name)</td>
                                </tr>
                                <tr>
                                    <th class="bg-light">@Html.DisplayNameFor(model => model.Characteristic.Category)</th>
                                    <td>
                                        @if (Model.Characteristic.Category != null)
                                        {
                                            <span class="badge bg-primary">@Model.Characteristic.Category.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Aucune catégorie</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <form method="post" class="mt-4 pt-3 border-top">
                        <input type="hidden" asp-for="Characteristic.Id" />
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i>Confirmer la suppression
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-2"></i>Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>