@page
@model MCBusiness.Pages.Users.Admin.Products.Characteristics.DetailsModel
@{
    ViewData["Title"] = "Détails de la caractéristique";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            @if (Model.Characteristic == null)
            {
                <div class="alert alert-danger">
                    La caractéristique demandée n'a pas été trouvée.
                </div>
            }
            else
            {
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">
                                <i class="bi bi-tag me-2"></i>@ViewData["Title"]
                            </h4>
                            <div>
                                <a asp-page="./Edit" asp-route-id="@Model.Characteristic.Id" class="btn btn-sm btn-light me-2">
                                    <i class="bi bi-pencil-square me-1"></i> Modifier
                                </a>
                                <a asp-page="./Index" class="btn btn-sm btn-outline-light">
                                    <i class="bi bi-arrow-left me-1"></i> Retour
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row">
                            <!-- Colonne de gauche - Informations principales -->
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3">Informations générales</h5>
                                    <dl class="row">
                                        <dt class="col-sm-4">Nom</dt>
                                        <dd class="col-sm-8 fw-bold">@Model.Characteristic.Name</dd>

                                        <dt class="col-sm-4">Catégorie</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.Characteristic.Category != null)
                                            {
                                                <span class="badge bg-primary">@Model.Characteristic.Category.Name</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune catégorie</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- Colonne de droite - Valeurs associées -->
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3">Valeurs associées</h5>
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <a asp-page="../CharacteristicValues/Index" asp-route-id="@Model.Characteristic.Id" 
                                               class="btn btn-outline-primary w-100 mb-3">
                                                <i class="bi bi-list-ul me-2"></i>Voir toutes les valeurs
                                            </a>
                                            <a asp-page="../CharacteristicValues/Create" asp-route-id="@Model.Characteristic.Id" 
                                               class="btn btn-primary w-100">
                                                <i class="bi bi-plus-circle me-2"></i>Ajouter une valeur
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between">
                            <small class="text-muted">
                                Dernière mise à jour : @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy HH:mm")
                            </small>
                            <div>
                                <a asp-page="./Edit" asp-route-id="@Model.Characteristic.Id" class="btn btn-outline-primary btn-sm me-2">
                                    <i class="bi bi-pencil-square me-1"></i> Modifier
                                </a>
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-list-ul me-1"></i> Liste complète
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-header {
            padding: 1rem 1.5rem;
        }
        
        dt {
            font-weight: 500;
            color: #6c757d;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .bg-light {
            background-color: #f8f9fa !important;
            border-radius: 0.5rem;
        }
        
        .w-100 {
            width: 100% !important;
        }
    </style>
}