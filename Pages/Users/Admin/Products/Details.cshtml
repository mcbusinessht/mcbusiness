@page
@model MCBusiness.Pages.Users.Admin.Products.DetailsModel
@{
    ViewData["Title"] = "Détails du Produit";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Produits -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-collection me-2"></i>Menu Produits
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="./Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-box-seam me-2"></i>Tous les produits
                                        </a>
                                        <a asp-page="./Choose" class="list-group-item list-group-item-action">
                                            <i class="bi bi-database-add me-2"></i>Ajouter un produit
                                        </a>
                                        <a asp-page="../Characteristics/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-tags me-2"></i>Caractéristiques
                                        </a>
                                        <a asp-page="../CharacteristicValues/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-card-list me-2"></i>Valeurs Caractéristiques
                                        </a>
                                        <a asp-page="../ProductVariants/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-boxes me-2"></i>Variants Produits
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Détails du produit -->
                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-box-seam me-2"></i>Informations générales
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">
                                            <i class="bi bi-tag me-2"></i>@Html.DisplayNameFor(model => model.Product.Name)
                                        </dt>
                                        <dd class="col-sm-8">
                                            <strong>@Html.DisplayFor(model => model.Product.Name)</strong>
                                        </dd>

                                        <dt class="col-sm-4">
                                            <i class="bi bi-building me-2"></i>@Html.DisplayNameFor(model => model.Product.Company)
                                        </dt>
                                        <dd class="col-sm-8">
                                            @Html.DisplayFor(model => model.Product.Company.Address)
                                        </dd>

                                        <dt class="col-sm-4">
                                            <i class="bi bi-collection me-2"></i>@Html.DisplayNameFor(model => model.Product.Category)
                                        </dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-primary">@Html.DisplayFor(model => model.Product.Category.Name)</span>
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <!-- Section Variantes -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-boxes me-2"></i>Variantes disponibles
                                    </h5>
                                </div>
                                <div class="card-body">
                                    @if (Model.Product.Variants.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>SKU</th>
                                                        <th>Prix</th>
                                                        <th>Stock</th>
                                                        <th>Statut</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var variant in Model.Product.Variants)
                                                    {
                                                        <tr>
                                                            <td>@variant.Sku</td>
                                                            <td>@variant.Price.ToString("C")</td>
                                                            <td>
                                                                @if(variant.Quantity > 0)
                                                                {
                                                                    <span class="badge bg-success">@variant.Quantity</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning text-dark">@variant.Quantity</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (variant.IsAvailable)
                                                                {
                                                                    <span class="badge bg-success">Disponible</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-danger">Indisponible</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">
                                                                <div class="btn-group" role="group">
                                                                    <a asp-page="../ProductVariants/Details" asp-route-id="@variant.Id" 
                                                                       class="btn btn-sm btn-outline-primary">
                                                                        <i class="bi bi-eye"></i>
                                                                    </a>
                                                                    @if (User.IsInRole("Admin"))
                                                                    {
                                                                        <a asp-page="../ProductVariants/Edit" asp-route-id="@variant.Id" 
                                                                           class="btn btn-sm btn-outline-secondary">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            <i class="bi bi-info-circle me-2"></i>Aucune variante disponible pour ce produit.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i> Modifier ce produit
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .btn-group .btn {
            transition: all 0.2s ease;
        }
        
        .btn-group .btn:hover {
            transform: translateY(-2px);
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        dt {
            color: #6c757d;
        }
    </style>
}