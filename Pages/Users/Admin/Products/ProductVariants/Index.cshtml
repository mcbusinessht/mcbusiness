@page
@model MCBusiness.Pages.Users.Admin.Products.ProductVariants.IndexModel
@{
    ViewData["Title"] = "Gestion des Variantes de Produits";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-boxes me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Create" class="btn btn-sm btn-light">
                            <i class="bi bi-plus-circle me-1"></i> Nouvelle variante
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Produits -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-collection me-2"></i>Menu Produits
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="../Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-box-seam me-2"></i>Tous les produits
                                        </a>
                                        <a asp-page="../Choose" class="list-group-item list-group-item-action">
                                            <i class="bi bi-database-add me-2"></i>Ajouter un produit
                                        </a>
                                        <a asp-page="../Characteristics/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-tags me-2"></i>Caractéristiques
                                        </a>
                                        <a asp-page="../CharacteristicValues/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-card-list me-2"></i>Valeurs Caractéristiques
                                        </a>
                                        <a asp-page="./Index" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-boxes me-2"></i>Variants Produits
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tableau des variantes -->
                        <div class="col-md-9">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>SKU</th>
                                            <th>Produit</th>
                                            <th>Catégorie</th>
                                            <th>Prix</th>
                                            <th>Stock</th>
                                            <th>Statut</th>
                                            <th>Caractéristiques</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ProductVariant)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="fw-bold">@item.Sku</span>
                                                </td>
                                                <td>@item.Product.Name</td>
                                                <td>
                                                    <span class="badge bg-primary">@item.Product.Category.Name</span>
                                                </td>
                                                <td class="fw-bold">@item.Price.ToString("C")</td>
                                                <td>
                                                    @if(item.Quantity > 0)
                                                    {
                                                        <span class="badge bg-success">@item.Quantity</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@item.Quantity</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.IsAvailable)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-check-circle me-1"></i>Disponible
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="bi bi-x-circle me-1"></i>Indisponible
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="characteristics-container" style="max-height: 120px; overflow-y: auto;">
                                                        @foreach (var characteristic in item.ProductVariantCharacteristics)
                                                        {
                                                            <div class="mb-1">
                                                                <span class="badge bg-light text-dark me-1">@characteristic.Characteristic.Name</span>
                                                                <span>@characteristic.CharacteristicValue.Value</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                                                type="button" id="dropdownMenuButton-@item.Id" 
                                                                data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class="bi bi-gear-fill"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton-@item.Id">
                                                            <li>
                                                                <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.Id">
                                                                    <i class="bi bi-eye me-2"></i>Détails
                                                                </a>
                                                            </li>
                                                            @if (User.IsInRole("Admin"))
                                                            {
                                                                <li>
                                                                    <a class="dropdown-item" asp-page="./Edit" asp-route-id="@item.Id">
                                                                        <i class="bi bi-pencil me-2"></i>Modifier
                                                                    </a>
                                                                </li>
                                                                <li>
                                                                    <a class="dropdown-item text-danger" asp-page="./Delete" asp-route-id="@item.Id">
                                                                        <i class="bi bi-trash me-2"></i>Supprimer
                                                                    </a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i> @Model.ProductVariant.Count variantes trouvées
                        </div>
                        <a asp-page="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Ajouter une variante
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .dropdown-menu {
            min-width: 200px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }
        
        .characteristics-container {
            scrollbar-width: thin;
            scrollbar-color: #dee2e6 #f8f9fa;
        }
        
        .characteristics-container::-webkit-scrollbar {
            width: 6px;
        }
        
        .characteristics-container::-webkit-scrollbar-track {
            background: #f8f9fa;
        }
        
        .characteristics-container::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 3px;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
    </style>
}