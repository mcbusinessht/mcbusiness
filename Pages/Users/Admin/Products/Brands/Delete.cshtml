@page
@model MCBusiness.Pages.Users.Admin.Products.Brands.DeleteModel
@{
    ViewData["Title"] = "Supprimer la Marque";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (Model.Brand == null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>Cette marque n'existe pas ou a déjà été supprimée.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <h5 class="alert-heading">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Action irréversible
                            </h5>
                            <p class="mb-0">
                                Vous êtes sur le point de supprimer définitivement la marque <strong>@Model.Brand.Name</strong>.
                                Cette action supprimera toutes les références à cette marque dans le système.
                            </p>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 me-4">
                                        @if (!string.IsNullOrEmpty(Model.Brand.UrlLogo))
                                        {
                                            <img src="@Model.Brand.UrlLogo" alt="@Model.Brand.Name" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white rounded-3 p-3 text-center" style="width: 100px; height: 100px; display: flex; align-items: center; justify-content: center;">
                                                <i class="bi bi-tag fs-2"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1">
                                        <h2 class="mb-1">@Model.Brand.Name</h2>
                                        @if (!string.IsNullOrEmpty(Model.Brand.Country))
                                        {
                                            <span class="badge bg-info">@Model.Brand.Country</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body p-3">
                                        @if (!string.IsNullOrEmpty(Model.Brand.WebSite))
                                        {
                                            <a href="@Model.Brand.WebSite" target="_blank" class="btn btn-sm btn-outline-primary w-100 mb-2">
                                                <i class="bi bi-link-45deg me-1"></i> Site web
                                            </a>
                                        }
                                        <div class="small text-muted">
                                            <i class="bi bi-calendar me-1"></i> Créé le: @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                <label class="form-check-label fw-bold" for="confirmDelete">
                                    Je confirme vouloir supprimer définitivement cette marque
                                </label>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i> Cette action ne peut pas être annulée.
                            </small>
                        </div>

                        <form method="post" class="needs-validation" novalidate>
                            <input type="hidden" asp-for="Brand.Id" />
                            <div class="d-flex justify-content-between">
                                <a asp-page="./Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                    <i class="bi bi-trash me-1"></i> Supprimer définitivement
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Activer le bouton de suppression seulement si la case est cochée
        document.getElementById('confirmDelete')?.addEventListener('change', function() {
            const deleteButton = document.getElementById('deleteButton');
            if (deleteButton) {
                deleteButton.disabled = !this.checked;
            }
        });

        // Validation du formulaire
        (function () {
            'use strict'

            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }
        
        .img-thumbnail {
            padding: 0.25rem;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-radius: 0.25rem;
        }
        
        .alert-warning {
            background-color: #fff3cd;
            border-color: #ffeeba;
        }
        
        .flex-shrink-0 {
            flex-shrink: 0;
        }
        
        .flex-grow-1 {
            flex-grow: 1;
        }
    </style>
}