@page
@model MCBusiness.Pages.Users.Admin.Products.Brands.DetailsModel
@{
    ViewData["Title"] = "Détails de la Marque";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-tag me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="./Index" class="btn btn-sm btn-outline-light me-2">
                                <i class="bi bi-arrow-left me-1"></i> Retour
                            </a>
                            <a asp-page="./Edit" asp-route-id="@Model.Brand.Id" class="btn btn-sm btn-light">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 me-4">
                                    @if (!string.IsNullOrEmpty(Model.Brand.UrlLogo))
                                    {
                                        <img src="@Model.Brand.UrlLogo" alt="@Model.Brand.Name" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white rounded-3 p-3 text-center" style="width: 100px; height: 100px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-tag fs-2"></i>
                                        </div>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <h2 class="mb-1">@Model.Brand.Name</h2>
                                    @if (!string.IsNullOrEmpty(Model.Brand.Country))
                                    {
                                        <span class="badge bg-info">@Model.Brand.Country</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    @if (!string.IsNullOrEmpty(Model.Brand.WebSite))
                                    {
                                        <a href="@Model.Brand.WebSite" target="_blank" class="btn btn-sm btn-outline-primary w-100 mb-2">
                                            <i class="bi bi-link-45deg me-1"></i> Visiter le site web
                                        </a>
                                    }
                                    <div class="small text-muted">
                                        <i class="bi bi-calendar me-1"></i> Créé le: @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Description</h5>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(Model.Brand.Description))
                                    {
                                        <p class="mb-0">@Model.Brand.Description</p>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Aucune description disponible</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-globe me-2"></i>Informations en ligne</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">URL du logo</dt>
                                        <dd class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.Brand.UrlLogo))
                                            {
                                                <a href="@Model.Brand.UrlLogo" target="_blank" class="text-break">@Model.Brand.UrlLogo</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Non spécifié</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-4">Site web</dt>
                                        <dd class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.Brand.WebSite))
                                            {
                                                <a href="@Model.Brand.WebSite" target="_blank" class="text-break">@Model.Brand.WebSite</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Non spécifié</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Localisation</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Pays d'origine</dt>
                                        <dd class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.Brand.Country))
                                            {
                                                @Model.Brand.Country
                                            }
                                            else
                                            {
                                                <span class="text-muted">Non spécifié</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.Brand.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }
        
        .img-thumbnail {
            padding: 0.25rem;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-radius: 0.25rem;
        }
        
        .text-break {
            word-break: break-all;
        }
        
        .flex-shrink-0 {
            flex-shrink: 0;
        }
        
        .flex-grow-1 {
            flex-grow: 1;
        }
    </style>
}