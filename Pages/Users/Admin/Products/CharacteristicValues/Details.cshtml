@page
@model MCBusiness.Pages.Users.Admin.Products.CharacteristicValues.DetailsModel

@{
    ViewData["Title"] = "Détails de la valeur";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-card-text me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Produits -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-collection me-2"></i>Menu Produits
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="../Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-box-seam me-2"></i>Tous les produits
                                        </a>
                                        <a asp-page="../Choose" class="list-group-item list-group-item-action">
                                            <i class="bi bi-database-add me-2"></i>Ajouter un produit
                                        </a>
                                        <a asp-page="../Characteristics/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-tags me-2"></i>Caractéristiques
                                        </a>
                                        <a asp-page="./Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-card-list me-2"></i>Valeurs Caractéristiques
                                        </a>
                                        <a asp-page="../ProductVariants/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-boxes me-2"></i>Variants Produits
                                        </a>
                                        
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Détails de la valeur -->
                        <div class="col-md-9">
                            <div class="card bg-light mb-4">
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4 text-md-end">
                                            @Html.DisplayNameFor(model => model.CharacteristicValue.Value)
                                        </dt>
                                        <dd class="col-sm-8">
                                            <span class="fw-bold">@Html.DisplayFor(model => model.CharacteristicValue.Value)</span>
                                        </dd>

                                        <dt class="col-sm-4 text-md-end">
                                            @Html.DisplayNameFor(model => model.CharacteristicValue.Characteristic)
                                        </dt>
                                        <dd class="col-sm-8">
                                            @if (Model.CharacteristicValue.Characteristic != null)
                                            {
                                                <span class="badge bg-primary">
                                                    @Html.DisplayFor(model => model.CharacteristicValue.Characteristic.Name)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune caractéristique associée</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-page="./Edit" asp-route-id="@Model.CharacteristicValue.Id" class="btn btn-primary me-2">
                                        <i class="bi bi-pencil-square me-1"></i> Modifier
                                    </a>
                                }
                                <a asp-page="./Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-list-ul me-1"></i> Retour à la liste
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .card.bg-light {
            background-color: #f8f9fa !important;
        }
        
        dt {
            font-weight: 500;
            color: #6c757d;
        }
    </style>
}