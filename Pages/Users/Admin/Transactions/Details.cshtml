@page
@model MCBusiness.Pages.Users.Admin.Transactions.DetailsModel
@using Microsoft.AspNetCore.Authorization

@{
    ViewData["Title"] = "Détails de la Transaction";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-person me-2"></i>Utilisateur
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom :</span> 
                                        @Model.Transaction.User?.FirstName @Model.Transaction.User?.LastName
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Email :</span> 
                                        @Model.Transaction.User?.Email
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Nom d'utilisateur :</span> 
                                        @Model.Transaction.User?.UserName
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-cash me-2"></i>Montant
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Montant :</span> 
                                        <span class="@(Model.Transaction.Type == MCBusiness.Models.TransactionType.Deposit ? "text-success" : "text-danger") fw-bold">
                                            @Model.Transaction.Amount.ToString("C")
                                        </span>
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Devise :</span> 
                                        @Model.Transaction.Currency?.CurrencyBase
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-tag me-2"></i>Type & Méthode
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Type :</span> 
                                        <span class="badge @(Model.Transaction.Type == MCBusiness.Models.TransactionType.Deposit ? "bg-success" : 
                                                          Model.Transaction.Type == MCBusiness.Models.TransactionType.Withdrawal ? "bg-danger" : "bg-info")">
                                            @Model.Transaction.Type
                                        </span>
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Méthode :</span> 
                                        @Model.Transaction.Method
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="bi bi-calendar me-2"></i>Date & Statut
                                </h5>
                                <div class="ps-4">
                                    <p class="mb-2">
                                        <span class="fw-semibold">Date :</span> 
                                        @LocalTime.Format(Model.Transaction.TransactionDate, "dd/MM/yyyy HH:mm")
                                    </p>
                                    <p class="mb-2">
                                        <span class="fw-semibold">Statut :</span> 
                                        @{
                                            var statusBadgeClass = Model.Transaction.Status switch
                                            {
                                                MCBusiness.Models.TransactionStatus.Completed => "bg-success",
                                                MCBusiness.Models.TransactionStatus.Pending => "bg-warning",
                                                MCBusiness.Models.TransactionStatus.Failed => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusBadgeClass">@Model.Transaction.Status</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                            <i class="bi bi-card-text me-2"></i>Description
                        </h5>
                        <div class="ps-4">
                            <p class="mb-2">
                                @Model.Transaction.Description
                            </p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-page="./Edit" asp-route-id="@Model.Transaction.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                        }
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-list-ul me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fw-semibold {
            font-weight: 600;
        }
        .badge {
            font-size: 0.9em;
            padding: 0.4em 0.75em;
        }
        .bg-success {
            background-color: #28a745 !important;
        }
        .bg-danger {
            background-color: #dc3545 !important;
        }
        .bg-warning {
            background-color: #ffc107 !important;
            color: #212529 !important;
        }
        .bg-info {
            background-color: #17a2b8 !important;
        }
        .bg-secondary {
            background-color: #6c757d !important;
        }
        .border-bottom {
            border-bottom: 2px solid #dee2e6 !important;
        }
        .text-success {
            color: #28a745 !important;
        }
        .text-danger {
            color: #dc3545 !important;
        }
    </style>
}
