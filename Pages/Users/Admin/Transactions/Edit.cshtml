@page
@model MCBusiness.Pages.Users.Admin.Transactions.EditModel
@using Microsoft.AspNetCore.Authorization

@{
    ViewData["Title"] = "Modifier Transaction";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                <input type="hidden" asp-for="Transaction.Id" />

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-person me-2"></i>Utilisateur
                                    </h5>
                                    <div class="form-group mb-3">
                                        <label asp-for="Transaction.UserId" class="form-label fw-semibold"></label>
                                        <select asp-for="Transaction.UserId" class="form-select" asp-items="ViewBag.UserId">
                                            <option value="">-- Sélectionner un utilisateur --</option>
                                        </select>
                                        <span asp-validation-for="Transaction.UserId" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-cash me-2"></i>Montant
                                    </h5>
                                    <div class="form-group mb-3">
                                        <label asp-for="Transaction.Amount" class="form-label fw-semibold"></label>
                                        <div class="input-group">
                                            <input asp-for="Transaction.Amount" class="form-control" type="number" step="0.01" min="0" />
                                            <span class="input-group-text">€</span>
                                        </div>
                                        <span asp-validation-for="Transaction.Amount" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-tag me-2"></i>Type & Méthode
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="Transaction.Type" class="form-label fw-semibold"></label>
                                                <select asp-for="Transaction.Type" class="form-select" asp-items="Html.GetEnumSelectList<MCBusiness.Models.TransactionType>()">
                                                    <option value="">-- Sélectionner --</option>
                                                </select>
                                                <span asp-validation-for="Transaction.Type" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="Transaction.Method" class="form-label fw-semibold"></label>
                                                <select asp-for="Transaction.Method" class="form-select" asp-items="Html.GetEnumSelectList<MCBusiness.Models.TransactionMethod>()">
                                                    <option value="">-- Sélectionner --</option>
                                                </select>
                                                <span asp-validation-for="Transaction.Method" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-info-circle me-2"></i>Statut & Date
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="Transaction.Status" class="form-label fw-semibold"></label>
                                                <select asp-for="Transaction.Status" class="form-select" asp-items="Html.GetEnumSelectList<MCBusiness.Models.TransactionStatus>()">
                                                    <option value="">-- Sélectionner --</option>
                                                </select>
                                                <span asp-validation-for="Transaction.Status" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="Transaction.TransactionDate" class="form-label fw-semibold"></label>
                                                <input asp-for="Transaction.TransactionDate" class="form-control" type="DateTimeOffset-local" />
                                                <span asp-validation-for="Transaction.TransactionDate" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="bi bi-card-text me-2"></i>Description
                                    </h5>
                                    <div class="form-group mb-3">
                                        <label asp-for="Transaction.Description" class="form-label fw-semibold"></label>
                                        <textarea asp-for="Transaction.Description" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Transaction.Description" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="form-group mt-4 text-center">
                                    <button type="submit" class="btn btn-primary px-4 me-2">
                                        <i class="bi bi-save me-1"></i> Enregistrer
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Formatage de la date pour l'input DateTimeOffset-local
            if ($('#Transaction_TransactionDate').val()) {
                const date = new Date($('#Transaction_TransactionDate').val());
                const formatted = date.toISOString().slice(0, 16);
                $('#Transaction_TransactionDate').val(formatted);
            }

            // Validation améliorée
            $('.needs-validation').on('submit', function(event) {
                if (!this.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                $(this).addClass('was-validated');
            });
        });
    </script>
}

@section Styles {
    <style>
        .form-label {
            margin-bottom: 0.5rem;
        }
        .form-select, .form-control, .form-textarea {
            padding: 0.5rem 0.75rem;
            border-radius: 0.375rem;
        }
        .fw-semibold {
            font-weight: 600;
        }
        .border-bottom {
            border-bottom: 2px solid #dee2e6 !important;
        }
        .needs-validation .form-control:invalid,
        .needs-validation .form-select:invalid {
            border-color: #dc3545;
        }
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
}