@page
@model MCBusiness.Pages_Users_Admin_Transactions_PlatformTransactions.IndexModel
@using MCBusiness.Models

@{
    ViewData["Title"] = "Transactions de la Plateforme";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-info text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-credit-card me-2"></i>@ViewData["Title"]
                        </h4>
                        <div class="d-flex gap-2">
                            <a asp-page="../Index" class="btn btn-sm btn-primary">
                                <i class="bi bi-arrow-left me-1"></i> Toutes les Transactions
                            </a>
                            <a asp-page="Create" class="btn btn-sm btn-light">
                                <i class="bi bi-plus-circle me-1"></i> Nouvelle Transaction
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Statistiques financières -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Revenus Totaux</h6>
                                            <h4 class="mb-0">
                                                @{
                                                    var totalRevenue = Model.PlatformTransaction
                                                        .Where(t => t.Type == PlatformTransactionType.Revenue && !t.IsDeleted)
                                                        .Sum(t => t.Amount);
                                                }
                                                @totalRevenue.ToString("C")
                                            </h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-arrow-up-circle fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Dépenses Totales</h6>
                                            <h4 class="mb-0">
                                                @{
                                                    var totalExpense = Model.PlatformTransaction
                                                        .Where(t => t.Type == PlatformTransactionType.Expense && !t.IsDeleted)
                                                        .Sum(t => Math.Abs(t.Amount));
                                                }
                                                @totalExpense.ToString("C")
                                            </h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-arrow-down-circle fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Balance Nette</h6>
                                            <h4 class="mb-0">
                                                @{
                                                    var netBalance = totalRevenue - totalExpense;
                                                }
                                                @netBalance.ToString("C")
                                            </h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-calculator fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Transactions Manuelles</h6>
                                            <h4 class="mb-0">@Model.PlatformTransaction.Count(t => t.IsManual && !t.IsDeleted)</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-hand-index fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filtres et recherche avancés -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Filtres et Recherche</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-search"></i>
                                        </span>
                                        <input type="text" class="form-control" id="searchInput" placeholder="Rechercher transactions..." onkeyup="searchTransactions()">
                                    </div>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <select class="form-select" id="typeFilter" onchange="filterTransactions()">
                                        <option value="">Tous types</option>
                                        <option value="Crédit">Crédit</option>
                                        <option value="Débit">Débit</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <select class="form-select" id="categoryFilter" onchange="filterTransactions()">
                                        <option value="">Toutes catégories</option>
                                        <option value="Commission">Commission</option>
                                        <option value="Service">Service</option>
                                        <option value="Abonnement">Abonnement</option>
                                        <option value="Autre">Autre</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <select class="form-select" id="manualFilter" onchange="filterTransactions()">
                                        <option value="">Manuel/Auto</option>
                                        <option value="true">Manuel</option>
                                        <option value="false">Automatique</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <select class="form-select" id="statusFilter" onchange="filterTransactions()">
                                        <option value="">Tous statuts</option>
                                        <option value="active">Actives</option>
                                        <option value="deleted">Supprimées</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tableau des transactions -->
                    <div class="table-responsive">
                        <table class="table table-hover" id="transactionsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="bi bi-hash me-1"></i>ID</th>
                                    <th><i class="bi bi-arrow-up-down me-1"></i>Type</th>
                                    <th><i class="bi bi-tag me-1"></i>Catégorie</th>
                                    <th><i class="bi bi-currency-dollar me-1"></i>Montant</th>
                                    <th><i class="bi bi-file-text me-1"></i>Description</th>
                                    <th><i class="bi bi-calendar me-1"></i>Date</th>
                                    <th><i class="bi bi-gear me-1"></i>Mode</th>
                                    <th><i class="bi bi-info-circle me-1"></i>Statut</th>
                                    <th class="text-center"><i class="bi bi-tools me-1"></i>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PlatformTransaction.OrderByDescending(t => t.CreatedAt)) {
                                    <tr class="transaction-row @(item.IsDeleted ? "table-warning" : "")" 
                                        data-type="@(item.Type == PlatformTransactionType.Revenue ? "Crédit" : "Débit")" 
                                        data-category="@item.Category" 
                                        data-manual="@item.IsManual.ToString().ToLower()"
                                        data-status="@(item.IsDeleted ? "deleted" : "active")">
                                        <td><strong>#@item.Id</strong></td>
                                        <td>
                                            @if (item.Type == PlatformTransactionType.Revenue)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-arrow-up me-1"></i>Crédit</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-arrow-down me-1"></i>Débit</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@item.Category</span>
                                        </td>
                                        <td>
                                            @{
                                                var displayAmount = item.Type == PlatformTransactionType.Expense
                                                    ? -Math.Abs(item.Amount)
                                                    : Math.Abs(item.Amount);
                                            }
                                            <strong class="@(item.Type == PlatformTransactionType.Revenue ? "text-success" : "text-danger")">
                                                @(displayAmount > 0 ? "+" : "")@displayAmount.ToString("C")
                                            </strong>
                                        </td>
                                        <td>
                                            <span title="@item.Description" class="text-truncate d-inline-block" style="max-width: 200px;">
                                                @(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                            </span>
                                        </td>
                                        <td>@LocalTime.Format(item.CreatedAt, "dd/MM/yyyy HH:mm")</td>
                                        <td> 
                                            @if (item.IsManual)
                                            {
                                                <span class="badge bg-warning"><i class="bi bi-hand-index me-1"></i>Manuel</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info"><i class="bi bi-cpu me-1"></i>Auto</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsDeleted)
                                            {
                                                <span class="badge bg-danger">Supprimée</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Voir détails">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.PlatformTransaction.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-credit-card-2-front display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">Aucune transaction trouvée</h5>
                            <p class="text-muted">Les transactions de la plateforme apparaîtront ici.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function searchTransactions() {
            filterTransactions();
        }

        function filterTransactions() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const typeFilter = document.getElementById('typeFilter').value;
            const categoryFilter = document.getElementById('categoryFilter').value;
            const manualFilter = document.getElementById('manualFilter').value;
            const statusFilter = document.getElementById('statusFilter').value;
            
            const rows = document.querySelectorAll('#transactionsTable .transaction-row');

            rows.forEach(row => {
                const cells = row.getElementsByTagName('td');
                const id = (cells[0] && cells[0].textContent) ? cells[0].textContent.toLowerCase() : '';
                const description = (cells[4] && cells[4].textContent) ? cells[4].textContent.toLowerCase() : '';
                const rowType = row.dataset.type || '';
                const rowCategory = row.dataset.category || '';
                const rowManual = row.dataset.manual || '';
                const rowStatus = row.dataset.status || '';

                let show = true;

                // Filtre de recherche textuelle
                if (searchTerm && !(
                    id.includes(searchTerm) ||
                    description.includes(searchTerm)
                )) {
                    show = false;
                }

                // Filtre par type
                if (typeFilter && rowType !== typeFilter) {
                    show = false;
                }

                // Filtre par catégorie
                if (categoryFilter && rowCategory !== categoryFilter) {
                    show = false;
                }

                // Filtre par manuel/automatique
                if (manualFilter && rowManual !== manualFilter) {
                    show = false;
                }

                // Filtre par statut
                if (statusFilter && rowStatus !== statusFilter) {
                    show = false;
                }

                row.style.display = show ? '' : 'none';
            });
        }

        // Animation d'entrée pour les cartes
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    card.style.transition = 'all 0.5s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });
        });

        // Fonction pour exporter les données
        function exportTransactions() {
            const visibleRows = document.querySelectorAll('#transactionsTable .transaction-row:not([style*="display: none"])');
            let csvContent = "ID,Type,Catégorie,Montant,Description,Date,Mode,Statut\n";
            
            visibleRows.forEach(row => {
                const cells = row.getElementsByTagName('td');
                const rowData = [
                    cells[0] ? cells[0].textContent.trim() : '',
                    cells[1] ? cells[1].textContent.trim() : '',
                    cells[2] ? cells[2].textContent.trim() : '',
                    cells[3] ? cells[3].textContent.trim() : '',
                    cells[4] ? cells[4].textContent.trim() : '',
                    cells[5] ? cells[5].textContent.trim() : '',
                    cells[6] ? cells[6].textContent.trim() : '',
                    cells[7] ? cells[7].textContent.trim() : ''
                ];
                csvContent += rowData.map(field => `"${field}"`).join(',') + '\n';
            });

            const blob = new Blob([csvContent], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            a.download = 'transactions_plateforme.csv';
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
        }
    </script>
}

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease-in-out;
        }
        
        .card:hover {
            transform: translateY(-2px);
        }
        
        .transaction-row:hover {
            background-color: #f8f9fa;
        }
        
        .table th {
            border-top: none;
            font-weight: 600;
            font-size: 0.9rem;
        }
        
        .btn-group .btn {
            margin: 0 1px;
        }
        
        .text-truncate {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
        
        .input-group-text {
            border-right: none;
        }
        
        .input-group .form-control {
            border-left: none;
        }
        
        .input-group .form-control:focus {
            border-left: none;
            box-shadow: none;
        }
        
        .badge {
            font-size: 0.8rem;
        }
        
        .bg-success { background-color: #28a745 !important; }
        .bg-danger { background-color: #dc3545 !important; }
        .bg-warning { background-color: #ffc107 !important; }
        .bg-info { background-color: #17a2b8 !important; }
        .bg-secondary { background-color: #6c757d !important; }
    </style>
}
