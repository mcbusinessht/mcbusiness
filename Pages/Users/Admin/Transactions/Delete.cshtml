@page
@model MCBusiness.Pages.Users.Admin.Transactions.DeleteModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@{
    ViewData["Title"] = "Supprimer Transaction";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Attention : Action irréversible
                        </h5>
                        <p class="mb-0">Vous êtes sur le point de supprimer définitivement cette transaction. Cette action ne peut pas être annulée.</p>
                    </div>

                    <div class="transaction-details">
                        <!-- Section Montant -->
                        <div class="detail-section">
                            <h5><i class="bi bi-cash-coin me-2"></i>Montant</h5>
                            <div class="detail-content">
                                <span class="@(Model.Transaction.Type == TransactionType.Deposit ? "text-success" : "text-danger") fw-bold">
                                    @Model.Transaction.Amount.ToString("C")
                                </span>
                            </div>
                        </div>

                        <!-- Section Type et Méthode -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-section">
                                    <h5><i class="bi bi-tag me-2"></i>Type</h5>
                                    <div class="detail-content">
                                        <span class="badge @GetTransactionTypeBadgeClass(Model.Transaction.Type)">
                                            @Model.Transaction.Type
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-section">
                                    <h5><i class="bi bi-credit-card me-2"></i>Méthode</h5>
                                    <div class="detail-content">
                                        @Model.Transaction.Method
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section Statut et Date -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-section">
                                    <h5><i class="bi bi-info-circle me-2"></i>Statut</h5>
                                    <div class="detail-content">
                                        <span class="badge @GetTransactionStatusBadgeClass(Model.Transaction.Status)">
                                            @Model.Transaction.Status
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-section">
                                    <h5><i class="bi bi-calendar-date me-2"></i>Date</h5>
                                    <div class="detail-content">
                                        @LocalTime.Format(Model.Transaction.TransactionDate, "dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section Description -->
                        <div class="detail-section">
                            <h5><i class="bi bi-card-text me-2"></i>Description</h5>
                            <div class="detail-content">
                                @Model.Transaction.Description
                            </div>
                        </div>
                    </div>

                    <!-- Formulaire de suppression -->
                    <form method="post" class="mt-4">
                        <input type="hidden" asp-for="Transaction.Id" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash-fill me-2"></i>Confirmer la suppression
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-2"></i>Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@using MCBusiness.Models;

@functions {
    public string GetTransactionTypeBadgeClass(TransactionType type)
    {
        return type switch
        {
            TransactionType.Deposit => "bg-success",
            TransactionType.Withdrawal => "bg-danger",
            _ => "bg-primary"
        };
    }

    public string GetTransactionStatusBadgeClass(TransactionStatus status)
    {
        return status switch
        {
            TransactionStatus.Completed => "bg-success",
            TransactionStatus.Pending => "bg-warning",
            TransactionStatus.Failed => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

@section Styles {
    <style>
        .detail-section {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }
        .detail-section h5 {
            color: #0d6efd;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        .detail-content {
            padding-left: 1.75rem;
        }
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        .alert-danger {
            border-left: 4px solid #dc3545;
        }
    </style>
}
