@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCodeUsages.DeleteModel
@{
    ViewData["Title"] = "Supprimer l'Utilisation";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (Model.PromoCodeUsage == null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>Cette utilisation de code promo n'existe pas ou a déjà été supprimée.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <h5 class="alert-heading">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Action irréversible
                            </h5>
                            <p class="mb-0">
                                Vous êtes sur le point de supprimer définitivement cette utilisation de code promo.
                                @if (Model.PromoCodeUsage.PromoCode != null)
                                {
                                    <span>Code : <strong>@Model.PromoCodeUsage.PromoCode.Code</strong></span>
                                }
                            </p>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0 me-4">
                                        <div class="@(Model.PromoCodeUsage.IsDeleted ? "bg-secondary" : "bg-danger") text-white rounded-3 p-3 text-center" style="width: 80px;">
                                            <i class="bi bi-percent fs-2"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h2 class="mb-1">Utilisation #@Model.PromoCodeUsage.Id</h2>
                                        <div class="d-flex flex-wrap gap-2">
                                            @if (Model.PromoCodeUsage.IsDeleted)
                                            {
                                                <span class="badge bg-secondary">Déjà annulée</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">À supprimer</span>
                                            }
                                            <span class="badge bg-primary">@Model.PromoCodeUsage.UsedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <small class="text-muted">Utilisateur</small>
                                                <h5 class="mb-0">
                                                    @if (Model.PromoCodeUsage.UsedByUser != null)
                                                    {
                                                        <span>@Model.PromoCodeUsage.UsedByUser.UserName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Inconnu</span>
                                                    }
                                                </h5>
                                            </div>
                                            <div class="text-end">
                                                <small class="text-muted">Montant</small>
                                                <h5 class="mb-0">@Model.PromoCodeUsage.DiscountApplied.ToString("C")</h5>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                <label class="form-check-label fw-bold" for="confirmDelete">
                                    Je confirme vouloir supprimer définitivement cette utilisation
                                </label>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i> Cette action ne peut pas être annulée et supprimera toutes les données associées.
                            </small>
                        </div>

                        <form method="post" class="needs-validation" novalidate>
                            <input type="hidden" asp-for="PromoCodeUsage.Id" />
                            <div class="d-flex justify-content-between">
                                <a asp-page="./Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Annuler
                                </a>
                                <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                    <i class="bi bi-trash me-1"></i> Supprimer définitivement
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Activer le bouton de suppression seulement si la case est cochée
        document.getElementById('confirmDelete')?.addEventListener('change', function() {
            const deleteButton = document.getElementById('deleteButton');
            if (deleteButton) {
                deleteButton.disabled = !this.checked;
            }
        });

        // Validation du formulaire
        (function () {
            'use strict'

            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }
        
        .flex-shrink-0 {
            flex-shrink: 0;
        }
        
        .flex-grow-1 {
            flex-grow: 1;
        }
        
        .alert-warning {
            background-color: #fff3cd;
            border-color: #ffeeba;
        }
    </style>
}