@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCodeUsages.DetailsModel
@{
    ViewData["Title"] = "Détails de l'Utilisation";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-receipt me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="./Index" class="btn btn-sm btn-outline-light me-2">
                                <i class="bi bi-arrow-left me-1"></i> Retour
                            </a>
                            <a asp-page="./Edit" asp-route-id="@Model.PromoCodeUsage.Id" class="btn btn-sm btn-light">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 me-4">
                                    <div class="@(Model.PromoCodeUsage.IsDeleted ? "bg-secondary" : "bg-success") text-white rounded-3 p-3 text-center" style="width: 80px;">
                                        <i class="bi bi-percent fs-2"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h2 class="mb-1">Utilisation #@Model.PromoCodeUsage.Id</h2>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (Model.PromoCodeUsage.IsDeleted)
                                        {
                                            <span class="badge bg-danger">Annulée</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Validée</span>
                                        }
                                        <span class="badge bg-primary">@Model.PromoCodeUsage.UsedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <small class="text-muted">Code promo</small>
                                            <h5 class="mb-0">
                                                <span class="badge bg-primary">@Model.PromoCodeUsage.PromoCode?.Code</span>
                                            </h5>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted">Campagne</small>
                                            <h5 class="mb-0">@Model.PromoCodeUsage.PromoCode?.PromoCampaign?.Name</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Utilisateur</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">ID Utilisateur</dt>
                                        <dd class="col-sm-8">@Model.PromoCodeUsage.UsedByUser?.Id</dd>

                                        <dt class="col-sm-4">Nom d'utilisateur</dt>
                                        <dd class="col-sm-8">@Model.PromoCodeUsage.UsedByUser?.UserName</dd>

                                        <dt class="col-sm-4">Date d'utilisation</dt>
                                        <dd class="col-sm-8">@Model.PromoCodeUsage.UsedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-currency-exchange me-2"></i>Avantages appliqués</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Réduction</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.PromoCodeUsage.DiscountApplied > 0)
                                            {
                                                <span class="badge bg-success">@Model.PromoCodeUsage.DiscountApplied.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-4">Récompense</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.PromoCodeUsage.RewardGiven > 0)
                                            {
                                                <span class="badge bg-info">@Model.PromoCodeUsage.RewardGiven.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-4">Statut</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.PromoCodeUsage.IsDeleted)
                                            {
                                                <span class="badge bg-danger">Annulée</span>
                                                <small class="text-muted d-block">Cette utilisation a été annulée</small>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.PromoCodeUsage.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                            <a href="../PromoCodes/Details?id=@Model.PromoCodeUsage.PromoCode.Id" class="btn btn-info">
                                <i class="bi bi-percent me-1"></i> Voir le code promo
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }
        
        .flex-shrink-0 {
            flex-shrink: 0;
        }
        
        .flex-grow-1 {
            flex-grow: 1;
        }
        
        .text-muted {
            font-size: 0.85rem;
        }
    </style>
}