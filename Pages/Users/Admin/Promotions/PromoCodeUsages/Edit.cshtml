@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCodeUsages.EditModel
@{
    ViewData["Title"] = "Modifier l'Utilisation";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <form method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="PromoCodeUsage.Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-percent me-2"></i>Code Promo</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCodeUsage.PromoCodeId" class="form-label">Code Promo</label>
                                        <select asp-for="PromoCodeUsage.PromoCodeId" class="form-select" asp-items="ViewBag.PromoCodeId">
                                            <option value="">-- Sélectionner un code --</option>
                                        </select>
                                        <span asp-validation-for="PromoCodeUsage.PromoCodeId" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCodeUsage.UsedByUserId" class="form-label">Utilisateur</label>
                                        <select asp-for="PromoCodeUsage.UsedByUserId" class="form-select" asp-items="ViewBag.UsedByUserId">
                                            <option value="">-- Sélectionner un utilisateur --</option>
                                        </select>
                                        <span asp-validation-for="PromoCodeUsage.UsedByUserId" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCodeUsage.UsedAt" class="form-label">Date d'utilisation</label>
                                        <input asp-for="PromoCodeUsage.UsedAt" class="form-control" type="DateTimeOffset-local" />
                                        <span asp-validation-for="PromoCodeUsage.UsedAt" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-currency-exchange me-2"></i>Avantages</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCodeUsage.DiscountApplied" class="form-label">Réduction appliquée</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="PromoCodeUsage.DiscountApplied" class="form-control" type="number" step="0.01" min="0" />
                                        </div>
                                        <span asp-validation-for="PromoCodeUsage.DiscountApplied" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCodeUsage.RewardGiven" class="form-label">Récompense offerte</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="PromoCodeUsage.RewardGiven" class="form-control" type="number" step="0.01" min="0" />
                                        </div>
                                        <span asp-validation-for="PromoCodeUsage.RewardGiven" class="text-danger small"></span>
                                    </div>

                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch" asp-for="PromoCodeUsage.IsDeleted" />
                                        <label class="form-check-label" asp-for="PromoCodeUsage.IsDeleted">Marquer comme annulée</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Activation du style de validation Bootstrap
        (function () {
            'use strict'

            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })();

        // Définir la date actuelle si le champ est vide
        document.addEventListener('DOMContentLoaded', function() {
            const usedAtField = document.getElementById('PromoCodeUsage_UsedAt');
            if (usedAtField && !usedAtField.value) {
                const now = new Date();
                const timezoneOffset = now.getTimezoneOffset() * 60000;
                const localISOTime = new Date(now - timezoneOffset).toISOString().slice(0, 16);
                usedAtField.value = localISOTime;
            }
        });
    </script>
}

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
}