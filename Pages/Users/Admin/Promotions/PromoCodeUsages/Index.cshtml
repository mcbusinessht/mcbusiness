@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCodeUsages.IndexModel
@{
    ViewData["Title"] = "Historique des Utilisations";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-list-check me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="Create" class="btn btn-sm btn-light">
                                <i class="bi bi-plus-circle me-1"></i> Nouvelle utilisation
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="d-flex mb-4">
                        <a asp-page="/Users/Admin/Promotions/PromoCodes/Index" class="btn btn-outline-secondary me-2">
                            <i class="bi bi-percent me-1"></i> Codes Promo
                        </a>
                        <a asp-page="/Users/Admin/Promotions/PromoCampaigns/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-megaphone me-1"></i> Campagnes
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Utilisateur</th>
                                    <th>Date</th>
                                    <th>Réduction</th>
                                    <th>Récompense</th>
                                    <th>Statut</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PromoCodeUsage)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary">@item.PromoCode?.Code</span>
                                            @if (item.PromoCode?.PromoCampaign != null)
                                            {
                                                <div class="small text-muted">@item.PromoCode.PromoCampaign.Name</div>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 me-2">
                                                    <i class="bi bi-person-circle"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    @item.UsedByUser?.UserName
                                                    <div class="small text-muted">ID: @item.UsedByUser?.Id</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @item.UsedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            @if (item.DiscountApplied > 0)
                                            {
                                                <span class="badge bg-success">@item.DiscountApplied.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.RewardGiven > 0)
                                            {
                                                <span class="badge bg-info">@item.RewardGiven.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsDeleted)
                                            {
                                                <span class="badge bg-danger">Annulée</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Validée</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                                        type="button" id="dropdownMenu-@item.Id" 
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu-@item.Id">
                                                    <li>
                                                        <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.Id">
                                                            <i class="bi bi-eye me-2"></i>Détails
                                                        </a>
                                                    </li>
                                                    @if (!item.IsDeleted)
                                                    {
                                                        @if(User.IsInRole("Admin")){

                                                        <li>
                                                            <a class="dropdown-item" asp-page="./Edit" asp-route-id="@item.Id">
                                                                <i class="bi bi-pencil me-2"></i>Modifier
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item text-danger" asp-page="./Delete" asp-route-id="@item.Id">
                                                                <i class="bi bi-x-circle me-2"></i>Annuler
                                                            </a>
                                                        </li>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <li>
                                                            <span class="dropdown-item text-muted">
                                                                <i class="bi bi-lock me-2"></i>Modifications désactivées
                                                            </span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i> @Model.PromoCodeUsage.Count utilisations enregistrées
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-secondary me-2">
                                <i class="bi bi-download me-1"></i> Exporter
                            </button>
                            <a asp-page="Create" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle me-1"></i> Ajouter
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .dropdown-menu {
            min-width: 200px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }
        
        .dropdown-item {
            padding: 0.5rem 1.5rem;
            transition: all 0.2s ease;
        }
        
        .dropdown-item:hover {
            background-color: #f8f9fa;
            transform: translateX(3px);
        }
        
        .dropdown-item.text-danger:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .card-header {
            border-radius: 0.375rem 0.375rem 0 0 !important;
        }
        
        .flex-shrink-0 {
            flex-shrink: 0;
        }
        
        .flex-grow-1 {
            flex-grow: 1;
        }
    </style>
}