@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCodes.CreateModel
@{
    ViewData["Title"] = "Nouveau Code Promo";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-plus-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <form method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-card-heading me-2"></i>Informations de base</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCode.Code" class="form-label">
                                            Code <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="PromoCode.Code" class="form-control" required />
                                        <small class="text-muted">Le code doit être unique</small>
                                        <span asp-validation-for="PromoCode.Code" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCode.PromoCampaignId" class="form-label">Campagne</label>
                                        <select asp-for="PromoCode.PromoCampaignId" class="form-select" asp-items="ViewBag.PromoCampaignId">
                                            <option value="">-- Sélectionner une campagne --</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCode.CreatedByUserId" class="form-label">Créé par</label>
                                        <select asp-for="PromoCode.CreatedByUserId" class="form-select" asp-items="ViewBag.CreatedByUserId">
                                            <option value="">-- Sélectionner un utilisateur --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-calendar me-2"></i>Dates</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCode.CreatedAt" class="form-label">Date de création</label>
                                        <input asp-for="PromoCode.CreatedAt" class="form-control" type="DateTimeOffset-local" 
                                               value="@LocalTime.Format(DateTimeOffset.UtcNow, "yyyy-MM-ddTHH:mm")" />
                                        <span asp-validation-for="PromoCode.CreatedAt" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCode.ExpiresAt" class="form-label">Date d'expiration</label>
                                        <input asp-for="PromoCode.ExpiresAt" class="form-control" type="DateTimeOffset-local" />
                                        <small class="text-muted">Laisser vide pour aucun expiration</small>
                                        <span asp-validation-for="PromoCode.ExpiresAt" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-percent me-2"></i>Avantages</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCode.DiscountPercentage" class="form-label">Pourcentage de réduction</label>
                                        <div class="input-group">
                                            <input asp-for="PromoCode.DiscountPercentage" class="form-control" min="0" max="100" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <small class="text-muted">0 pour désactiver</small>
                                        <span asp-validation-for="PromoCode.DiscountPercentage" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCode.RewardAmount" class="form-label">Montant de récompense</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="PromoCode.RewardAmount" class="form-control" min="0" />
                                        </div>
                                        <small class="text-muted">0 pour désactiver</small>
                                        <span asp-validation-for="PromoCode.RewardAmount" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-graph-up me-2"></i>Utilisation</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCode.UsageLimit" class="form-label">Limite d'utilisation</label>
                                        <input asp-for="PromoCode.UsageLimit" class="form-control" min="0" />
                                        <small class="text-muted">0 pour illimité</small>
                                        <span asp-validation-for="PromoCode.UsageLimit" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCode.UsageCount" class="form-label">Utilisations actuelles</label>
                                        <input asp-for="PromoCode.UsageCount" class="form-control" value="0" min="0" readonly />
                                    </div>

                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch" asp-for="PromoCode.IsActive" checked />
                                        <label class="form-check-label" asp-for="PromoCode.IsActive">Activer ce code</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-check2-circle me-2"></i>Disponibilité</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" role="switch" asp-for="PromoCode.IsOrderAvailable" checked />
                                            <label class="form-check-label" asp-for="PromoCode.IsOrderAvailable">Commandes</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" role="switch" asp-for="PromoCode.IsPlanAvailable" checked />
                                            <label class="form-check-label" asp-for="PromoCode.IsPlanAvailable">Plans</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" role="switch" asp-for="PromoCode.IsITServiceAvailable" checked />
                                            <label class="form-check-label" asp-for="PromoCode.IsITServiceAvailable">Services IT</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Créer le code
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Activation du style de validation Bootstrap
        (function () {
            'use strict'

            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation')

            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()
        
        // Générer un code promo aléatoire si le champ est vide
        document.getElementById('PromoCode_Code').addEventListener('focus', function() {
            if (!this.value) {
                this.value = 'PROMO-' + Math.random().toString(36).substr(2, 8).toUpperCase();
            }
        });
    </script>
}