@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCodes.DeleteModel
@{
    ViewData["Title"] = "Supprimer le Code Promo";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-danger">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmation requise
                        </h5>
                        <p class="mb-0">Êtes-vous sûr de vouloir supprimer définitivement ce code promo ? Cette action est irréversible.</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 me-4">
                                    <div class="bg-danger text-white rounded-3 p-3 text-center" style="width: 80px;">
                                        <i class="bi bi-percent fs-2"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h2 class="mb-1">@Model.PromoCode.Code</h2>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (Model.PromoCode.IsActive)
                                        {
                                            <span class="badge bg-success">Actif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactif</span>
                                        }
                                        @if (Model.PromoCode.ExpiresAt.HasValue && Model.PromoCode.ExpiresAt.Value.ToUniversalTime() < DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-danger">Expiré</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <small class="text-muted">Utilisations</small>
                                            <h5 class="mb-0">@Model.PromoCode.UsageCount/@(Model.PromoCode.UsageLimit == 0 ? "∞" : Model.PromoCode.UsageLimit.ToString())</h5>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted">Créé le</small>
                                            <h5 class="mb-0">@LocalTime.Format(Model.PromoCode.CreatedAt, "dd/MM/yyyy")</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Campagne</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.PromoCampaign != null)
                                            {
                                                @Model.PromoCode.PromoCampaign.Name
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Créé par</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.CreatedByUser != null)
                                            {
                                                <span>@Model.PromoCode.CreatedByUser.UserName</span>
                                                <small class="text-muted d-block">ID: @Model.PromoCode.CreatedByUser.Id</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Inconnu</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Date d'expiration</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.ExpiresAt.HasValue)
                                            {
                                                <span>@Model.PromoCode.ExpiresAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Avantages</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Réduction</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.DiscountPercentage > 0)
                                            {
                                                <span class="badge bg-success">@Model.PromoCode.DiscountPercentage%</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Récompense</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.RewardAmount > 0)
                                            {
                                                <span class="badge bg-info">@Model.PromoCode.RewardAmount.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                            <label class="form-check-label fw-bold" for="confirmDelete">
                                Je confirme vouloir supprimer définitivement ce code promo
                            </label>
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i> Cette action supprimera toutes les données associées à ce code promo.
                        </small>
                    </div>

                    <form method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="PromoCode.Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                <i class="bi bi-trash me-1"></i> Supprimer définitivement
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Activer le bouton de suppression seulement si la case est cochée
        document.getElementById('confirmDelete').addEventListener('change', function() {
            document.getElementById('deleteButton').disabled = !this.checked;
        });

        // Validation du formulaire
        (function () {
            'use strict'

            var forms = document.querySelectorAll('.needs-validation')

            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}
