@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCodes.DetailsModel
@{
    ViewData["Title"] = "Détails du Code Promo";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-percent me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="./Index" class="btn btn-sm btn-outline-light me-2">
                                <i class="bi bi-arrow-left me-1"></i> Retour
                            </a>
                            <a asp-page="./Edit" asp-route-id="@Model.PromoCode.Id" class="btn btn-sm btn-light">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 me-4">
                                    <div class="bg-primary text-white rounded-3 p-3 text-center" style="width: 80px;">
                                        <i class="bi bi-percent fs-2"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h2 class="mb-1">@Model.PromoCode.Code</h2>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (Model.PromoCode.IsActive)
                                        {
                                            <span class="badge bg-success">Actif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactif</span>
                                        }
                                        @if (Model.PromoCode.ExpiresAt.HasValue && Model.PromoCode.ExpiresAt.Value.ToUniversalTime() < DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-danger">Expiré</span>
                                        }
                                        @if (Model.PromoCode.UsageLimit > 0 && Model.PromoCode.UsageCount >= Model.PromoCode.UsageLimit)
                                        {
                                            <span class="badge bg-warning text-dark">Limite atteinte</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <small class="text-muted">Utilisations</small>
                                            <h5 class="mb-0">@Model.PromoCode.UsageCount/@(Model.PromoCode.UsageLimit == 0 ? "∞" : Model.PromoCode.UsageLimit.ToString())</h5>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted">Créé le</small>
                                            <h5 class="mb-0">@LocalTime.Format(Model.PromoCode.CreatedAt, "dd/MM/yyyy")</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations de base</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Campagne</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.PromoCampaign != null)
                                            {
                                                <a href="./PromoCampaigns/Details?id=@Model.PromoCode.PromoCampaign.Id" class="text-decoration-none">
                                                    @Model.PromoCode.PromoCampaign.Name
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Créé par</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.CreatedByUser != null)
                                            {
                                                <span>@Model.PromoCode.CreatedByUser.UserName</span>
                                                <small class="text-muted d-block">ID: @Model.PromoCode.CreatedByUser.Id</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Inconnu</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Date d'expiration</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.ExpiresAt.HasValue)
                                            {
                                                <span class="@(Model.PromoCode.ExpiresAt.Value.ToUniversalTime() < DateTimeOffset.UtcNow ? "text-danger" : "")">
                                                    @LocalTime.Format(Model.PromoCode.ExpiresAt.Value, "dd/MM/yyyy HH:mm")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Avantages</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Réduction</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.DiscountPercentage > 0)
                                            {
                                                <span class="badge bg-success">@Model.PromoCode.DiscountPercentage%</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>

                                        <dt class="col-sm-5">Récompense</dt>
                                        <dd class="col-sm-7">
                                            @if (Model.PromoCode.RewardAmount > 0)
                                            {
                                                <span class="badge bg-info">@Model.PromoCode.RewardAmount.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucune</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-check2-circle me-2"></i>Disponibilité</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="flex-shrink-0 me-3">
                                                    @if (Model.PromoCode.IsOrderAvailable)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-x-circle-fill text-secondary fs-4"></i>
                                                    }
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0">Commandes</h6>
                                                    <small class="text-muted">Applicable aux commandes</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="flex-shrink-0 me-3">
                                                    @if (Model.PromoCode.IsPlanAvailable)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-x-circle-fill text-secondary fs-4"></i>
                                                    }
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0">Plans</h6>
                                                    <small class="text-muted">Applicable aux plans</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="flex-shrink-0 me-3">
                                                    @if (Model.PromoCode.IsITServiceAvailable)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-x-circle-fill text-secondary fs-4"></i>
                                                    }
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h6 class="mb-0">Services IT</h6>
                                                    <small class="text-muted">Applicable aux services IT</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                            </a>
                        </div>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.PromoCode.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                            <a href="./PromoCodeUsages/Index?codeId=@Model.PromoCode.Id" class="btn btn-info">
                                <i class="bi bi-list-check me-1"></i> Voir les utilisations
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        dt {
            font-weight: 500;
            color: #6c757d;
        }
        
        dd {
            margin-bottom: 0.75rem;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }
        
        .flex-shrink-0 {
            flex-shrink: 0;
        }
        
        .flex-grow-1 {
            flex-grow: 1;
        }
    </style>
}
