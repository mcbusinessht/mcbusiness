@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCampaigns.EditModel
@{
    ViewData["Title"] = "Modifier la Campagne";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <form method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="PromoCampaign.Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-card-heading me-2"></i>Informations de base</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCampaign.Name" class="form-label">
                                            Nom <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="PromoCampaign.Name" class="form-control" required />
                                        <small class="text-muted">Donnez un nom clair à votre campagne</small>
                                        <span asp-validation-for="PromoCampaign.Name" class="text-danger small"></span>
                                    </div>

                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch" asp-for="PromoCampaign.IsActive" />
                                        <label class="form-check-label" asp-for="PromoCampaign.IsActive">Campagne active</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-4">
                                    <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-calendar-range me-2"></i>Période</h5>
                                    
                                    <div class="mb-3">
                                        <label asp-for="PromoCampaign.StartDate" class="form-label">Date de début</label>
                                        <input asp-for="PromoCampaign.StartDate" class="form-control" type="DateTimeOffset-local" 
                                               value="@Model.PromoCampaign.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                                        <span asp-validation-for="PromoCampaign.StartDate" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="PromoCampaign.EndDate" class="form-label">Date de fin</label>
                                        <input asp-for="PromoCampaign.EndDate" class="form-control" type="DateTimeOffset-local" 
                                               value="@Model.PromoCampaign.EndDate?.ToString("yyyy-MM-ddTHH:mm")" />
                                        <span asp-validation-for="PromoCampaign.EndDate" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (Model.PromoCampaign.PromoCodes?.Count > 0)
                        {
                            <div class="alert alert-warning">
                                <h5 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i>Attention</h5>
                                <p class="mb-0">
                                    Cette campagne contient @Model.PromoCampaign.PromoCodes.Count codes promo. 
                                    Les modifications que vous apportez affecteront tous ces codes.
                                </p>
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Activation du style de validation Bootstrap
        (function () {
            'use strict'

            // Fetch all the forms we want to apply custom Bootstrap validation styles to
            var forms = document.querySelectorAll('.needs-validation')

            // Loop over them and prevent submission
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }

                        form.classList.add('was-validated')
                    }, false)
                })
        })();

        // Validation des dates
        document.querySelector('form').addEventListener('submit', function(e) {
            const startDate = new Date(document.getElementById('PromoCampaign_StartDate').value);
            const endDate = new Date(document.getElementById('PromoCampaign_EndDate').value);
            
            if (startDate >= endDate) {
                alert('La date de fin doit être postérieure à la date de début');
                e.preventDefault();
            }
        });
    </script>
}