@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCampaigns.IndexModel
@{
    ViewData["Title"] = "Gestion des Campagnes Promotionnelles";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-megaphone me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Create" class="btn btn-sm btn-light">
                            <i class="bi bi-plus-circle me-1"></i> Nouvelle Campagne
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="d-flex mb-4">
                        <a asp-page="/Users/Admin/Promotions/PromoAnalytics" class="btn btn-success me-2">
                            <i class="bi bi-graph-up me-1"></i> Analyse des Coûts
                        </a>
                        <a asp-page="/Users/Admin/Promotions/PromoCodes/Index" class="btn btn-outline-secondary me-2">
                            <i class="bi bi-percent me-1"></i> Codes Promo
                        </a>
                        <a asp-page="/Users/Admin/Promotions/PromoCodeUsages/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-list-check me-1"></i> Utilisations
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Nom</th>
                                    <th>Date de début</th>
                                    <th>Date de fin</th>
                                    <th>Statut</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PromoCampaign)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Name</strong>
                                            @if (item.PromoCodes?.Count > 0)
                                            {
                                                <div class="small text-muted">
                                                    @item.PromoCodes.Count codes associés
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @item.StartDate.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            <span class="@(item.EndDate < DateTimeOffset.UtcNow ? "text-danger" : "")">
                                                @item.EndDate?.ToString("dd/MM/yyyy")
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                            <br>
                                            <small class="text-muted">
                                                @(item.StartDate > DateTimeOffset.UtcNow ? "À venir" : 
                                                  item.EndDate < DateTimeOffset.UtcNow ? "Terminée" : "En cours")
                                            </small>
                                        </td>
                                        <td class="text-end">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                                        type="button" id="dropdownMenu-@item.Id" 
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu-@item.Id">
                                                    <li>
                                                        <a class="dropdown-item" asp-page="./Details" asp-route-id="@item.Id">
                                                            <i class="bi bi-eye me-2"></i>Détails
                                                        </a>
                                                    </li>
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                    <li>
                                                        <a class="dropdown-item" asp-page="./Edit" asp-route-id="@item.Id">
                                                            <i class="bi bi-pencil me-2"></i>Modifier
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item text-danger" asp-page="./Delete" asp-route-id="@item.Id">
                                                            <i class="bi bi-trash me-2"></i>Supprimer
                                                        </a>
                                                    </li>
                                                    }
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item" href="./PromoCodes/Index?campaignId=@item.Id">
                                                            <i class="bi bi-percent me-2"></i>Voir les codes
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i> @Model.PromoCampaign.Count campagnes trouvées
                        </div>
                        <a asp-page="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Créer une campagne
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .dropdown-menu {
            min-width: 200px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }
        
        .dropdown-item {
            padding: 0.5rem 1.5rem;
            transition: all 0.2s ease;
        }
        
        .dropdown-item:hover {
            background-color: #f8f9fa;
            transform: translateX(3px);
        }
        
        .dropdown-item.text-danger:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .card-header {
            border-radius: 0.375rem 0.375rem 0 0 !important;
        }
    </style>
}