@page
@model MCBusiness.Pages_Users_Admin_Promotions_PromoCampaigns.DetailsModel
@{
    ViewData["Title"] = "Détails de la Campagne";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-megaphone me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="./Index" class="btn btn-sm btn-outline-light me-2">
                                <i class="bi bi-arrow-left me-1"></i> Retour
                            </a>
                            <a asp-page="./Edit" asp-route-id="@Model.PromoCampaign.Id" class="btn btn-sm btn-light">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 me-4">
                                    <div class="bg-primary text-white rounded-3 p-3 text-center" style="width: 80px;">
                                        <i class="bi bi-megaphone fs-2"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h2 class="mb-1">@Model.PromoCampaign.Name</h2>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (Model.PromoCampaign.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                        @if (Model.PromoCampaign.StartDate > DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-info">À venir</span>
                                        }
                                        else if (Model.PromoCampaign.EndDate < DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-warning text-dark">Terminée</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">En cours</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <small class="text-muted">Codes promo</small>
                                            <h5 class="mb-0">@Model.PromoCampaign.PromoCodes?.Count</h5>
                                        </div>
                                        <div class="text-end">
                                            <small class="text-muted">Période</small>
                                            <h5 class="mb-0">
                                                @Model.PromoCampaign.StartDate.ToString("dd/MM/yyyy") - @Model.PromoCampaign.EndDate?.ToString("dd/MM/yyyy")
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-calendar me-2"></i>Dates clés</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Début</dt>
                                        <dd class="col-sm-8">
                                            <span class="@(Model.PromoCampaign.StartDate > DateTimeOffset.UtcNow ? "text-info" : "")">
                                                @Model.PromoCampaign.StartDate.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </dd>

                                        <dt class="col-sm-4">Fin</dt>
                                        <dd class="col-sm-8">
                                            <span class="@(Model.PromoCampaign.EndDate < DateTimeOffset.UtcNow ? "text-warning" : "")">
                                                @Model.PromoCampaign.EndDate?.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </dd>

                                        <dt class="col-sm-4">Statut</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.PromoCampaign.StartDate > DateTimeOffset.UtcNow)
                                            {
                                                <span>Commence dans @(Model.PromoCampaign.StartDate - DateTimeOffset.UtcNow).Days jours</span>
                                            }
                                            else if (Model.PromoCampaign.EndDate < DateTimeOffset.UtcNow)
                                            {
                                                <span>Terminée depuis @(DateTimeOffset.UtcNow - Model.PromoCampaign.EndDate).Days jours</span>
                                            }
                                            else
                                            {
                                                <span>En cours (reste @(Model.PromoCampaign.EndDate - DateTimeOffset.UtcNow).Days jours)</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-percent me-2"></i>Statistiques</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4">Codes actifs</dt>
                                        <dd class="col-sm-8">
                                            @(Model.PromoCampaign.PromoCodes?.Count(c => c.IsActive) ?? 0)
                                        </dd>

                                        <dt class="col-sm-4">Utilisations totales</dt>
                                        <dd class="col-sm-8">
                                            @(Model.PromoCampaign.PromoCodes?.Sum(c => c.UsageCount) ?? 0)
                                        </dd>

                                        <dt class="col-sm-4">Taux d'utilisation</dt>
                                        <dd class="col-sm-8">
                                            @if (Model.PromoCampaign.PromoCodes?.Count > 0)
                                            {
                                                var totalCodes = Model.PromoCampaign.PromoCodes.Count;
                                                var usedCodes = Model.PromoCampaign.PromoCodes.Count(c => c.UsageCount > 0);
                                                var usageRate = (int)((double)usedCodes / totalCodes * 100);
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar bg-success" role="progressbar" style="width: @usageRate%" aria-valuenow="@usageRate" aria-valuemin="0" aria-valuemax="100">@usageRate%</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="bi bi-percent me-2"></i>Codes promo associés</h5>
                            <a href="../PromoCodes/Create?campaignId=@Model.PromoCampaign.Id" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus me-1"></i> Ajouter un code
                            </a>
                        </div>
                        <div class="card-body">
                            @if (Model.PromoCampaign.PromoCodes?.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead>
                                            <tr>
                                                <th>Code</th>
                                                <th>Statut</th>
                                                <th>Réduction</th>
                                                <th>Récompense</th>
                                                <th>Utilisations</th>
                                                <th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var code in Model.PromoCampaign.PromoCodes.OrderByDescending(c => c.IsActive))
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-primary">@code.Code</span>
                                                    </td>
                                                    <td>
                                                        @if (code.IsActive)
                                                        {
                                                            <span class="badge bg-success">Actif</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Inactif</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (code.DiscountPercentage > 0)
                                                        {
                                                            <span>@code.DiscountPercentage%</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (code.RewardAmount > 0)
                                                        {
                                                            <span>@code.RewardAmount.ToString("C")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @code.UsageCount/@(code.UsageLimit == 0 ? "∞" : code.UsageLimit.ToString())
                                                    </td>
                                                    <td class="text-end">
                                                        <a href="../PromoCodes/Details?id=@code.Id" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle me-2"></i>Aucun code promo associé à cette campagne.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-clock-history me-1"></i> Dernière mise à jour : @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy HH:mm")
                        </div>
                        <div>
                            <a asp-page="./Edit" asp-route-id="@Model.PromoCampaign.Id" class="btn btn-primary me-2">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                            <a href="../PromoCodes/Index?campaignId=@Model.PromoCampaign.Id" class="btn btn-info">
                                <i class="bi bi-list-check me-1"></i> Voir tous les codes
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }
        
        .progress {
            background-color: #e9ecef;
            border-radius: 0.25rem;
        }
        
        .table-sm td, .table-sm th {
            padding: 0.5rem;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            font-weight: 500;
        }
    </style>
}