@page "/admin/addresses"
@model MCBusiness.Pages.Admin.Addresses.IndexModel
@{
    ViewData["Title"] = "Gestion des Divisions Géographiques";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="bi bi-globe me-2 text-primary"></i>Divisions Géographiques
                </h2>
                <div class="d-flex">
                    <button class="btn btn-sm btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#helpModal">
                        <i class="bi bi-question-circle"></i> Aide
                    </button>
                </div>
            </div>

            <!-- Cards Grid -->
            <div class="row g-4">
                <!-- Country Card -->
                <div class="col-md-6 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-flag-fill me-2"></i>
                                <span class="fw-bold">Pays</span>
                            </div>
                            <div>
                                <a asp-page="/Users/Admin/Addresses/Countries/Create" class="text-dark me-2" title="Ajouter">
                                    <i class="bi bi-plus-circle"></i> 
                                </a>
                                <a asp-page="/Users/Admin/Addresses/Countries/Index" class="text-dark" title="Liste complète">
                                    <i class="bi bi-list-ul"></i>
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Rechercher..." 
                                       id="countrySearch" oninput="filterItems('countrySearch', 'countryList')">
                            </div>
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 250px;" id="countryList">
                                @foreach (var country in Model.Countries)
                                {
                                    <div class="list-group-item list-group-item-action">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">@country.Name</h6>
                                                <small class="text-muted">@country.CountryCode</small>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-page="/Users/Admin/Addresses/Countries/Edit" asp-route-id="@country.Id" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="/Users/Admin/Addresses/Countries/Delete" asp-route-id="@country.Id" 
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light text-end">
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> @Model.Countries.Count pays
                            </small>
                        </div>
                    </div>
                </div>

                <!-- State Card -->
                <div class="col-md-6 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" style="opacity: 0.9;">
                            <div>
                                <i class="bi bi-map-fill me-2"></i>
                                <span class="fw-bold">États/Régions</span>
                            </div>
                            <div>
                                <a asp-page="/Users/Admin/Addresses/States/Create" class="text-dark me-2" title="Ajouter">
                                    <i class="bi bi-plus-circle"></i>
                                </a>
                                <a asp-page="/Users/Admin/Addresses/States/Index" class="text-dark" title="Liste complète">
                                    <i class="bi bi-list-ul"></i>
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Rechercher..." 
                                       id="stateSearch" oninput="filterItems('stateSearch', 'stateList')">
                            </div>
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 250px;" id="stateList">
                                @foreach (var state in Model.States)
                                {
                                    <div class="list-group-item list-group-item-action">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">@state.Name</h6>
                                                <small class="text-muted">@state.Country.Name</small>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-page="/Users/Admin/Addresses/States/Edit" asp-route-id="@state.Id" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="/Users/Admin/Addresses/States/Delete" asp-route-id="@state.Id" 
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light text-end">
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> @Model.States.Count états
                            </small>
                        </div>
                    </div>
                </div>

                <!-- City Card -->
                <div class="col-md-6 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" style="opacity: 0.8;">
                            <div>
                                <i class="bi bi-building-fill me-2"></i>
                                <span class="fw-bold">Villes</span>
                            </div>
                            <div>
                                <a asp-page="/Users/Admin/Addresses/Cities/Create" class="text-dark me-2" title="Ajouter">
                                    <i class="bi bi-plus-circle"></i>
                                </a>
                                <a asp-page="/Users/Admin/Addresses/Cities/Index" class="text-dark" title="Liste complète">
                                    <i class="bi bi-list-ul"></i>
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Rechercher..." 
                                       id="citySearch" oninput="filterItems('citySearch', 'cityList')">
                            </div>
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 250px;" id="cityList">
                                @foreach (var city in Model.Cities)
                                {
                                    <div class="list-group-item list-group-item-action">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">@city.Name</h6>
                                                <small class="text-muted">@city.State.Name</small>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-page="/Users/Admin/Addresses/Cities/Edit" asp-route-id="@city.Id" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="/Users/Admin/Addresses/Cities/Delete" asp-route-id="@city.Id" 
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light text-end">
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> @Model.Cities.Count villes
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Neighborhood Card -->
                <div class="col-md-6 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" style="opacity: 0.7;">
                            <div>
                                <i class="bi bi-house-door-fill me-2"></i>
                                <span class="fw-bold">Quartiers</span>
                            </div>
                            <div>
                                <a asp-page="/Users/Admin/Addresses/Neighborhoods/Create" class="text-dark me-2" title="Ajouter">
                                    <i class="bi bi-plus-circle"></i>
                                </a>
                                <a asp-page="/Users/Admin/Addresses/Neighborhoods/Index" class="text-dark" title="Liste complète">
                                    <i class="bi bi-list-ul"></i>
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Rechercher..." 
                                       id="neighborhoodSearch" oninput="filterItems('neighborhoodSearch', 'neighborhoodList')">
                            </div>
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 250px;" id="neighborhoodList">
                                @foreach (var neighborhood in Model.Neighborhoods)
                                {
                                    <div class="list-group-item list-group-item-action">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="mb-1">@neighborhood.Name</h6>
                                                <small class="text-muted">@neighborhood.City.Name</small>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-page="/Users/Admin/Addresses/Neighborhoods/Edit" asp-route-id="@neighborhood.Id" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="/Users/Admin/Addresses/Neighborhoods/Delete" asp-route-id="@neighborhood.Id" 
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-light text-end">
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> @Model.Neighborhoods.Count quartiers
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Help Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="helpModalLabel">
                    <i class="bi bi-question-circle-fill me-2"></i>Aide - Gestion des Adresses
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Cette interface permet de gérer la hiérarchie géographique du système :</p>
                <ol>
                    <li><strong>Pays</strong> : Niveau supérieur (ex: Haïti)</li>
                    <li><strong>États/Régions</strong> : Subdivisions des pays (ex: Ouest)</li>
                    <li><strong>Villes</strong> : Villes principales (ex: Port-au-Prince)</li>
                    <li><strong>Quartiers</strong> : Zones urbaines (ex: Delmas)</li>
                </ol>
                <p class="mb-0">Cliquez sur les icônes <i class="bi bi-plus-circle text-primary"></i> pour ajouter ou <i class="bi bi-list-ul text-primary"></i> pour voir la liste complète.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Compris</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterItems(inputId, listId) {
            const input = document.getElementById(inputId);
            const filter = input.value.toUpperCase();
            const list = document.getElementById(listId);
            const items = list.getElementsByClassName('list-group-item');

            for (let i = 0; i < items.length; i++) {
                const text = items[i].textContent || items[i].innerText;
                if (text.toUpperCase().indexOf(filter) > -1) {
                    items[i].style.display = "";
                } else {
                    items[i].style.display = "none";
                }
            }
        }

        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }
        
        .list-group-item {
            transition: background-color 0.2s ease;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
        }
        
        .card-header {
            border-radius: 0 !important;
        }
        
        /* Custom scrollbar for lists */
        .list-group-flush {
            scrollbar-width: thin;
            scrollbar-color: #dee2e6 #f8f9fa;
        }
        
        .list-group-flush::-webkit-scrollbar {
            width: 6px;
        }
        
        .list-group-flush::-webkit-scrollbar-track {
            background: #f8f9fa;
        }
        
        .list-group-flush::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 6px;
        }
    </style>
}