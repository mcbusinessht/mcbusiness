@page
@model MCBusiness.Pages_Users_Admin_Addresses_Neighborhoods.CreateModel
@{
    ViewData["Title"] = "Ajout Multiple de Quartiers";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-geo-fill me-2"></i>Ajout Multiple de Quartiers
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <!-- Section Saisie des quartiers -->
                                <div class="card mb-4 border-primary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="bi bi-textarea-resize me-2"></i>Saisie des noms de quartiers</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label for="NeighborhoodNames" class="form-label fw-bold">Noms des quartiers</label>
                                            <textarea id="NeighborhoodNames" name="NeighborhoodNames" class="form-control" rows="8" 
                                                      placeholder="Saisissez les noms des quartiers, séparés par des virgules ou par lignes&#10;Exemple:&#10;Turgeau&#10;Bourdon&#10;Canapé-Vert&#10;Delmas 33"
                                                      required></textarea>
                                            <div class="form-text">
                                                Séparez les noms par des virgules ou en les écrivant sur des lignes différentes
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section Sélection de la ville -->
                                <div class="card mb-4 border-primary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="bi bi-building me-2"></i>Ville de rattachement</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="CityId" class="form-label fw-bold">Ville</label>
                                            <select asp-for="CityId" class="form-select" asp-items="ViewBag.CityId" required>
                                                <option value="" disabled selected>-- Sélectionnez une ville --</option>
                                            </select>
                                            <span asp-validation-for="CityId" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Boutons d'action -->
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                    <button type="submit" class="btn btn-primary me-md-2 px-4">
                                        <i class="bi bi-save-fill me-1"></i> Enregistrer les quartiers
                                    </button>
                                    <a asp-page="Index" class="btn btn-outline-secondary px-4">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .card-header {
            padding: 0.75rem 1.25rem;
        }

        textarea.form-control {
            min-height: 200px;
            font-family: monospace;
        }

        .form-select, .form-control {
            border-radius: 0.375rem;
        }

        .btn {
            transition: all 0.3s ease;
            border-radius: 0.375rem;
            min-width: 200px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }

        .needs-validation .form-control:invalid,
        .needs-validation .form-control.is-invalid,
        .needs-validation .form-select:invalid,
        .needs-validation .form-select.is-invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Validation des champs du formulaire
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Formatage automatique du texte
        document.querySelector('textarea[name="NeighborhoodNames"]').addEventListener('input', function (e) {
            this.value = this.value.replace(/,\s*,/g, ',')
                                   .replace(/\s+/g, ' ')
                                   .replace(/, /g, ',');
        });
    </script>
}
