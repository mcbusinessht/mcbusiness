@page
@model MCBusiness.Pages_Users_Admin_Addresses_Countries.DetailsModel

@{
    ViewData["Title"] = "Détails du pays";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Adresses -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-geo-alt me-2"></i>Menu Adresses
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="../Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-map me-2"></i>Gestion des adresses
                                        </a>
                                        <a asp-page="../Cities/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-building me-2"></i>Villes
                                        </a>
                                        <a asp-page="../States/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-globe me-2"></i>Régions/États
                                        </a>
                                        <a asp-page="./Index" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-flag me-2"></i>Pays
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Détails du pays -->
                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="text-center mb-4">
                                        <span class="fi fi-@(Model.Country.CountryCode?.ToLower() ?? "xx") fis" style="font-size: 3rem;"></span>
                                        <h3 class="mt-3">@Model.Country.Name</h3>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="card mb-4">
                                                <div class="card-header bg-light">
                                                    <h5 class="mb-0">
                                                        <i class="bi bi-info-square me-2"></i>Informations générales
                                                    </h5>
                                                </div>
                                                <div class="card-body">
                                                    <dl class="row">
                                                        <dt class="col-sm-4 fw-bold">Code ISO :</dt>
                                                        <dd class="col-sm-8">
                                                            <span class="badge bg-primary">@Model.Country.CountryCode</span>
                                                        </dd>

                                                        <dt class="col-sm-4 fw-bold">Nombre de régions :</dt>
                                                        <dd class="col-sm-8">
                                                            <span class="badge bg-info">@Model.Country.States.Count</span>
                                                        </dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header bg-light">
                                                    <h5 class="mb-0">
                                                        <i class="bi bi-clock-history me-2"></i>Statut
                                                    </h5>
                                                </div>
                                                <div class="card-body">
                                                    <dl class="row">
                                                        <dt class="col-sm-4 fw-bold">Statut :</dt>
                                                        <dd class="col-sm-8">
                                                            @if (Model.Country.IsDeleted)
                                                            {
                                                                <span class="badge bg-danger">Supprimé</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success">Actif</span>
                                                            }
                                                        </dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end mt-4">
                                        <a asp-page="./Edit" asp-route-id="@Model.Country.Id" class="btn btn-primary me-2">
                                            <i class="bi bi-pencil me-1"></i> Modifier
                                        </a>
                                        <a asp-page="./Index" class="btn btn-outline-secondary">
                                            <i class="bi bi-list-ul me-1"></i> Retour à la liste
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/6.6.6/css/flag-icons.min.css" />
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .list-group-item.active:hover {
            background-color: #0d6efd;
            transform: none;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.5em 0.75em;
        }
        
        .fi.fis {
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border: 1px solid #dee2e6;
        }
        
        .card {
            border-radius: 0.5rem;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        
        dt {
            color: #6c757d;
        }
        
        dd {
            padding: 8px 0;
            margin-bottom: 0.5rem;
            border-bottom: 1px dashed #eee;
        }
    </style>
}