@page
@model MCBusiness.Pages_Users_Admin_Addresses_Countries.EditModel

@{
    ViewData["Title"] = "Modifier un pays";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Adresses -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-geo-alt me-2"></i>Menu Adresses
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="../Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-map me-2"></i>Gestion des adresses
                                        </a>
                                        <a asp-page="../Cities/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-building me-2"></i>Villes
                                        </a>
                                        <a asp-page="../States/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-globe me-2"></i>Régions/États
                                        </a>
                                        <a asp-page="./Index" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-flag me-2"></i>Pays
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Formulaire d'édition -->
                        <div class="col-md-9">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                <input type="hidden" asp-for="Country.Id" />
                                
                                <div class="mb-4">
                                    <label asp-for="Country.Name" class="form-label fw-bold">
                                        <i class="bi bi-flag me-2"></i>Nom du pays <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Country.Name" class="form-control" placeholder="Entrez le nom du pays" required />
                                    <span asp-validation-for="Country.Name" class="text-danger small"></span>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="Country.CountryCode" class="form-label fw-bold">
                                        <i class="bi bi-code me-2"></i>Code pays (ISO) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text"><span class="fi fi-@(Model.Country.CountryCode?.ToLower() ?? "xx")"></span></span>
                                        <input asp-for="Country.CountryCode" class="form-control text-uppercase" 
                                               placeholder="Ex: FR, US, DE" maxlength="2" required />
                                    </div>
                                    <span asp-validation-for="Country.CountryCode" class="text-danger small"></span>
                                    <div class="form-text">Code ISO à 2 lettres (ex: FR pour France)</div>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center mt-4">
                                    <a asp-page="./Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-circle me-1"></i> Enregistrer
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Activation de la validation Bootstrap
        (function () {
            'use strict'
            
            var forms = document.querySelectorAll('.needs-validation')
            
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
        
        // Mise en majuscule automatique du code pays
        document.getElementById('Country_CountryCode').addEventListener('input', function() {
            this.value = this.value.toUpperCase();
        });
        
        // Prévisualisation du drapeau
        document.getElementById('Country_CountryCode').addEventListener('input', function() {
            const code = this.value.toLowerCase();
            const flagElement = document.querySelector('.input-group-text .fi');
            if (code.length === 2) {
                flagElement.className = 'fi fi-' + code;
            } else {
                flagElement.className = 'fi fi-xx';
            }
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/6.6.6/css/flag-icons.min.css" />
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .list-group-item.active:hover {
            background-color: #0d6efd;
            transform: none;
        }
        
        .form-control, .form-select {
            border-radius: 0.25rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        
        .btn {
            transition: all 0.2s ease;
        }
        
        .fi {
            width: 1.5em;
            height: 1.1em;
            border-radius: 2px;
            box-shadow: 0 0 0 1px rgba(0,0,0,0.1);
        }
        
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
}