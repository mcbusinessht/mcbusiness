@page
@model MCBusiness.Pages_Users_Admin_Addresses_Countries.CreateModel

@{
    ViewData["Title"] = "Ajouter plusieurs pays";
}

<div class="container-fluid px-4">
    <div class="row">
        <partial name="_AdminSidebarPartial" />

        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-globe-americas me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <form method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div id="countries-container">
                            @for (int i = 0; i < Model.Countries.Count; i++)
                            {
                                <div class="country-form mb-4 border rounded p-3 bg-light">
                                    <div class="mb-3">
                                        <label asp-for="@Model.Countries[i].Name" class="form-label fw-bold">
                                            <i class="bi bi-flag me-1"></i>Nom du pays
                                        </label>
                                        <input asp-for="@Model.Countries[i].Name" class="form-control" required />
                                        <span asp-validation-for="@Model.Countries[i].Name" class="text-danger small"></span>
                                    </div>

                                    <div>
                                        <label asp-for="@Model.Countries[i].CountryCode" class="form-label fw-bold">
                                            <i class="bi bi-upc me-1"></i>Code pays
                                        </label>
                                        <input asp-for="@Model.Countries[i].CountryCode" class="form-control" required />
                                        <span asp-validation-for="@Model.Countries[i].CountryCode" class="text-danger small"></span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" onclick="addCountry()">
                                <i class="bi bi-plus-circle me-1"></i> Ajouter un pays
                            </button>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');

            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();

        let index = @Model.Countries.Count;

        function addCountry() {
            const container = document.getElementById("countries-container");

            const template = `
                <div class="country-form mb-4 border rounded p-3 bg-light">
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-flag me-1"></i>Nom du pays
                        </label>
                        <input name="Countries[${index}].Name" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label fw-bold">
                            <i class="bi bi-upc me-1"></i>Code pays
                        </label>
                        <input name="Countries[${index}].CountryCode" class="form-control" required />
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', template);
            index++;
        }
    </script>
}