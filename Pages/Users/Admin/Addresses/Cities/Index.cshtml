@page
@model MCBusiness.Pages_Users_Admin_Addresses_Cities.IndexModel
@{
    ViewData["Title"] = "Gestion des Villes";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-buildings me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="Create" class="btn btn-sm btn-light">
                                <i class="bi bi-plus-circle me-1"></i> Nouvelle Ville
                            </a>
                            <a asp-page="BulkCreate" class="btn btn-sm btn-light ms-2" title="Importer des villes">
                                <i class="bi bi-upload me-1"></i> Importer
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Barre de recherche et filtres -->
                    <div class="row mb-3 g-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher une ville...">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" id="stateFilter">
                                <option value="">Toutes les régions</option>
                                @foreach (var city in Model.City)
                                {
                                    @if (city.State != null)
                                    {
                                        <option value="@city.State.Id">@city.State.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex justify-content-end">
                            <button class="btn btn-outline-secondary" id="resetFilters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="citiesTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="sortable" data-sort="name">
                                        <i class="bi bi-building me-1"></i>
                                        Ville
                                        <i class="bi bi-arrow-down-up sort-icon"></i>
                                    </th>
                                    <th class="sortable" data-sort="state">
                                        <i class="bi bi-map me-1"></i>
                                        Région/État
                                        <i class="bi bi-arrow-down-up sort-icon"></i>
                                    </th>
                                    <th class="sortable" data-sort="neighborhoods">
                                        <i class="bi bi-grid-3x3 me-1"></i>
                                        Quartiers
                                        <i class="bi bi-arrow-down-up sort-icon"></i>
                                    </th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.City)
                                {
                                    <tr data-state="@item.StateId">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-building me-2 text-primary"></i>
                                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.State != null)
                                            {
                                                <span class="badge bg-info">
                                                    <i class="bi bi-map me-1"></i>
                                                    @item.State.Name
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Non spécifié</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @(item.Neighborhoods?.Count ?? 0)
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détails">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" 
                                                            data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a class="dropdown-item" asp-page="../Neighborhoods/Index" asp-route-cityId="@item.Id">
                                                                <i class="bi bi-grid-3x3-gap me-2"></i>Quartiers
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" asp-page="../Neighborhoods/Create" asp-route-cityId="@item.Id">
                                                                <i class="bi bi-plus-circle me-2"></i>Ajouter quartier
                                                            </a>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <a class="dropdown-item text-danger" asp-page="./Delete" asp-route-id="@item.Id">
                                                                <i class="bi bi-trash me-2"></i>Supprimer
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i> 
                            <span id="totalCount">@Model.City.Count</span> villes trouvées
                        </div>
                        <nav aria-label="Pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" tabindex="-1">Précédent</a>
                                </li>
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#">Suivant</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filtrage par recherche
            $('#searchInput').keyup(function() {
                const searchText = $(this).val().toLowerCase();
                filterTable(searchText);
            });

            // Filtrage par région
            $('#stateFilter').change(function() {
                const stateId = $(this).val();
                filterTable('', stateId);
            });

            // Réinitialisation des filtres
            $('#resetFilters').click(function() {
                $('#searchInput').val('');
                $('#stateFilter').val('');
                filterTable('', '');
            });

            // Tri des colonnes
            $('.sortable').click(function() {
                const sortBy = $(this).data('sort');
                // Implémentez la logique de tri ici
                console.log('Tri par: ' + sortBy);
            });

            function filterTable(searchText = '', stateId = '') {
                let visibleCount = 0;
                
                $('#citiesTable tbody tr').each(function() {
                    const cityName = $(this).find('td:first strong').text().toLowerCase();
                    const rowStateId = $(this).data('state');
                    const matchSearch = searchText === '' || cityName.includes(searchText);
                    const matchState = stateId === '' || rowStateId === stateId;
                    
                    if (matchSearch && matchState) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                
                $('#totalCount').text(visibleCount);
            }
        });
    </script>
}

@section Styles {
    <style>
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            white-space: nowrap;
            cursor: pointer;
            position: relative;
        }
        
        .sort-icon {
            font-size: 0.8em;
            opacity: 0.5;
            margin-left: 5px;
        }
        
        .sortable:hover .sort-icon {
            opacity: 1;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
            display: inline-flex;
            align-items: center;
        }
        
        .dropdown-menu {
            min-width: 200px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            border: none;
        }
        
        .dropdown-item {
            padding: 0.5rem 1.5rem;
            transition: all 0.2s ease;
        }
        
        .dropdown-item:hover {
            background-color: #f8f9fa;
            transform: translateX(3px);
        }
        
        .dropdown-item.text-danger:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-group .btn {
            border-radius: 0.25rem !important;
        }
        
        .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .page-link {
            color: #0d6efd;
        }
        
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
}