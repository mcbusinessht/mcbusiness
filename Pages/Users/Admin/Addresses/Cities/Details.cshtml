@page
@model MCBusiness.Pages_Users_Admin_Addresses_Cities.DetailsModel

@{
    ViewData["Title"] = "Détails de la ville";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Adresses -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-geo-alt me-2"></i>Menu Adresses
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="../Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-map me-2"></i>Gestion des adresses
                                        </a>
                                        <a asp-page="./Index" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-building me-2"></i>Villes
                                        </a>
                                        <a asp-page="../States/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-globe me-2"></i>Régions/États
                                        </a>
                                        <a asp-page="../Countries/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-flag me-2"></i>Pays
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Détails de la ville -->
                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <dl class="row mb-4">
                                        <dt class="col-sm-4 text-end fw-bold">
                                            <i class="bi bi-building me-2"></i>Nom de la ville :
                                        </dt>
                                        <dd class="col-sm-8">
                                            @Html.DisplayFor(model => model.City.Name)
                                        </dd>

                                        <dt class="col-sm-4 text-end fw-bold">
                                            <i class="bi bi-globe me-2"></i>Région/État :
                                        </dt>
                                        <dd class="col-sm-8">
                                            @Html.DisplayFor(model => model.City.State.Name)
                                        </dd>

                                        <dt class="col-sm-4 text-end fw-bold">
                                            <i class="bi bi-flag me-2"></i>Pays :
                                        </dt>
                                        <dd class="col-sm-8">
                                            @Html.DisplayFor(model => model.City.State.Country.Name)
                                        </dd>
                                    </dl>

                                    <div class="d-flex justify-content-end mt-4">
                                        <a asp-page="./Edit" asp-route-id="@Model.City.Id" class="btn btn-primary me-2">
                                            <i class="bi bi-pencil me-1"></i> Modifier
                                        </a>
                                        <a asp-page="./Index" class="btn btn-outline-secondary">
                                            <i class="bi bi-list-ul me-1"></i> Retour à la liste
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .list-group-item.active:hover {
            background-color: #0d6efd;
            transform: none;
        }
        
        .btn {
            transition: all 0.2s ease;
        }
        
        dt {
            color: #6c757d;
        }
        
        dd {
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }
    </style>
}