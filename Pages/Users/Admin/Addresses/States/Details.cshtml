@page
@model MCBusiness.Pages_Users_Admin_Addresses_States.DetailsModel

@{
    ViewData["Title"] = "Détails de la région/état";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Adresses -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-geo-alt me-2"></i>Menu Adresses
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="../Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-map me-2"></i>Gestion des adresses
                                        </a>
                                        <a asp-page="../Cities/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-building me-2"></i>Villes
                                        </a>
                                        <a asp-page="./Index" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-globe me-2"></i>Régions/États
                                        </a>
                                        <a asp-page="../Countries/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-flag me-2"></i>Pays
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Détails de la région -->
                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h3 class="card-title text-primary mb-4">
                                        <i class="bi bi-pin-map me-2"></i>@Model.State.Name
                                    </h3>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="card mb-4">
                                                <div class="card-header bg-light">
                                                    <h5 class="mb-0">
                                                        <i class="bi bi-info-square me-2"></i>Informations générales
                                                    </h5>
                                                </div>
                                                <div class="card-body">
                                                    <dl class="row">
                                                        <dt class="col-sm-4 fw-bold">Nom :</dt>
                                                        <dd class="col-sm-8">
                                                            <span class="badge bg-primary">@Model.State.Name</span>
                                                        </dd>
                                                        
                                                        <dt class="col-sm-4 fw-bold">Pays :</dt>
                                                        <dd class="col-sm-8">
                                                            @if (Model.State.Country != null)
                                                            {
                                                                <span class="badge bg-info">
                                                                    <i class="bi bi-flag me-1"></i>
                                                                    @Model.State.Country.Name
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning">Non spécifié</span>
                                                            }
                                                        </dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="card">
                                                <div class="card-header bg-light">
                                                    <h5 class="mb-0">
                                                        <i class="bi bi-building me-2"></i>Villes associées
                                                    </h5>
                                                </div>
                                                <div class="card-body">
                                                    <dl class="row">
                                                        <dt class="col-sm-4 fw-bold">Nombre de villes :</dt>
                                                        <dd class="col-sm-8">
                                                            <span class="badge bg-secondary">@(Model.State.Cities?.Count ?? 0)</span>
                                                        </dd>
                                                    </dl>
                                                    <div class="mt-2">
                                                        <a asp-page="../Cities/Index" asp-route-stateId="@Model.State.Id" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-eye me-1"></i> Voir les villes
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end mt-4">
                                        <a asp-page="./Edit" asp-route-id="@Model.State.Id" class="btn btn-primary me-2">
                                            <i class="bi bi-pencil me-1"></i> Modifier
                                        </a>
                                        <a asp-page="./Index" class="btn btn-outline-secondary">
                                            <i class="bi bi-list-ul me-1"></i> Retour à la liste
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .list-group-item.active:hover {
            background-color: #0d6efd;
            transform: none;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.5em 0.75em;
            display: inline-flex;
            align-items: center;
        }
        
        .card {
            border-radius: 0.5rem;
        }
        
        .card-header {
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        
        dt {
            color: #6c757d;
        }
        
        dd {
            padding: 8px 0;
            margin-bottom: 0.5rem;
            border-bottom: 1px dashed #eee;
        }
        
        .btn {
            transition: all 0.2s ease;
        }
    </style>
}