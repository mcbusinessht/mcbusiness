@page
@model MCBusiness.Pages_Users_Admin_Addresses_States.EditModel

@{
    ViewData["Title"] = "Modifier une région/état";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral Adresses -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-geo-alt me-2"></i>Menu Adresses
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="../Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-map me-2"></i>Gestion des adresses
                                        </a>
                                        <a asp-page="../Cities/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-building me-2"></i>Villes
                                        </a>
                                        <a asp-page="./Index" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-globe me-2"></i>Régions/États
                                        </a>
                                        <a asp-page="../Countries/Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-flag me-2"></i>Pays
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Formulaire d'édition -->
                        <div class="col-md-9">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                <input type="hidden" asp-for="State.Id" />
                                
                                <div class="mb-4">
                                    <label asp-for="State.Name" class="form-label fw-bold">
                                        <i class="bi bi-pin-map me-2"></i>Nom de la région <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="State.Name" class="form-control" placeholder="Entrez le nom de la région" required />
                                    <span asp-validation-for="State.Name" class="text-danger small"></span>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="State.CountryId" class="form-label fw-bold">
                                        <i class="bi bi-flag me-2"></i>Pays <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="State.CountryId" class="form-select" asp-items="ViewBag.CountryId" required>
                                        <option value="">-- Sélectionner un pays --</option>
                                    </select>
                                    <span asp-validation-for="State.CountryId" class="text-danger small"></span>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center mt-4">
                                    <a asp-page="./Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-circle me-1"></i> Enregistrer
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Activation de la validation Bootstrap
        (function () {
            'use strict'
            
            var forms = document.querySelectorAll('.needs-validation')
            
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .list-group-item.active:hover {
            background-color: #0d6efd;
            transform: none;
        }
        
        .form-control, .form-select {
            border-radius: 0.25rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        
        .form-select {
            cursor: pointer;
        }
        
        .btn {
            transition: all 0.2s ease;
        }
        
        .alert-danger {
            border-left: 4px solid #dc3545;
        }
    </style>
}