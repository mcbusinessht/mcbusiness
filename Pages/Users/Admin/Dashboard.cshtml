@page
@model MCBusiness.Pages.Users.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard Administration";
}

@if (!Model.CurrentUser.EmailConfirmed && Model.CurrentUser.Email != null)
{
    Layout = "~/Pages/Shared/_MinimalLayout.cshtml";

    <div class="row position-absolute top-50 start-50 translate-middle w-100">
        <div class="col-md-6 col-sm-8 col-xs-10 mx-auto my-auto p-4 mt-4" id="boxSignUp" style="background: white; border-radius: var(--border-radius); box-shadow: var(--box-shadow);">
            <h2 class="text-center mb-4">Votre adresse mail n'est pas vérifiée</h2>
            <p class="text-center mb-4">Pour accéder à cette page, vous devez d'abord vérifier votre adresse email.</p>
            
            <div class="text-center"> 
                <a asp-page="/Account/VerifyEmail" class="btn btn-primary px-4 py-2" style="background: var(--primary-color); border: none; border-radius: 8px;">
                    Accéder à la page de vérification <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4">
        <div class="row">
            <!-- Sidebar -->
            <partial name="_AdminSidebarPartial" />

            <!-- Main Content -->
            <div class="col-lg-9">
                <!-- En-tête du Dashboard -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="h3 mb-1 text-primary fw-bold">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard Administration
                        </h1>
                        <p class="text-muted mb-0">Vue d'ensemble complète de la plateforme MCBusiness</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" onclick="refreshDashboard()">
                            <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-calendar me-1"></i>@LocalTime.Format(DateTimeOffset.UtcNow, "MMMM yyyy")
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" onclick="filterPeriod('today')">Aujourd'hui</a></li>
                                <li><a class="dropdown-item" href="#" onclick="filterPeriod('week')">Cette semaine</a></li>
                                <li><a class="dropdown-item" href="#" onclick="filterPeriod('month')">Ce mois</a></li>
                                <li><a class="dropdown-item" href="#" onclick="filterPeriod('year')">Cette année</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- KPI Financiers Principaux (ADMIN SEULEMENT) -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1">Revenus Plateforme</h6>
                                        <h3 class="text-success mb-0" id="totalRevenue">@Model.DashboardData.TotalRevenue.ToString("N2") HTG</h3>
                                        <small class="text-success">
                                            <i class="bi bi-wallet2"></i> Solde: @Model.Solde.ToString("N2") HTG
                                        </small>
                                    </div>
                                    <div class="text-success">
                                        <i class="bi bi-cash-coin fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1">Écritures Plateforme</h6>
                                        <h3 class="text-info mb-0">@Model.countTrans</h3>
                                        <small class="text-muted">
                                            En cours: @Model.countTransPend | Terminées: @Model.countTransEnd
                                        </small>
                                    </div>
                                    <div class="text-info">
                                        <i class="bi bi-credit-card fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1">Utilisateurs Actifs</h6>
                                        <h3 class="text-primary mb-0">@Model.countUser</h3>
                                        <small class="text-muted">
                                            Plans actifs: @Model.countActiveSub
                                        </small>
                                    </div>
                                    <div class="text-primary">
                                        <i class="bi bi-people fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted mb-1">Plans Disponibles</h6>
                                        <h3 class="text-warning mb-0">@Model.countPlan</h3>
                                        <small class="text-muted">
                                            Abonnements actifs: @Model.countActiveSub
                                        </small>
                                    </div>
                                    <div class="text-warning">
                                        <i class="bi bi-star fs-1"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistiques Détaillées -->
                <div class="row mb-4">
                    <div class="col-lg-8">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="bi bi-graph-up me-2"></i>Analytics Financiers
                                    <span class="badge bg-success ms-2">TEMPS RÉEL</span>
                                </h6>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary" onclick="toggleChart('revenue')">Revenus</button>
                                    <button class="btn btn-sm btn-outline-success" onclick="toggleChart('transactions')">Transactions</button>
                                    <button class="btn btn-sm btn-outline-warning" onclick="toggleChart('users')">Utilisateurs</button>
                                </div>
                            </div>
                            <div class="card-body">
                                <canvas id="analyticsChart" height="100"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-pie-chart me-2"></i>Répartition Abonnements
                                </h6>
                            </div>
                            <div class="card-body">
                                <canvas id="subscriptionsChart"></canvas>
                                <div class="mt-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="badge bg-success">Actifs</span>
                                        <strong>@Model.countActiveSub</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="badge bg-secondary">Terminés</span>
                                        <strong>@Model.countInactiveSub</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="badge bg-danger">Annulés</span>
                                        <strong>@Model.countCancelledSub</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transactions et Alertes -->
                <div class="row mb-4">
                    <div class="col-lg-7">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white d-flex justify-content-between">
                                <h6 class="mb-0">
                                    <i class="bi bi-clock-history me-2"></i>Activité Récente
                                </h6>
                                <a asp-page="./Transactions/Index" class="btn btn-sm btn-outline-primary">
                                    Voir tout
                                </a>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Type</th>
                                                <th>Description</th>
                                                <th>Montant</th>
                                                <th>Statut</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.RecentTransactions?.Any() == true)
                                            {
                                                @foreach (var transaction in Model.RecentTransactions)
                                                {
                                                    <tr>
                                                        <td>
                                                            <span class="badge @(transaction.Type == MCBusiness.Models.TransactionType.Deposit || transaction.Type == MCBusiness.Models.TransactionType.Bonus ? "bg-success" : transaction.Type == MCBusiness.Models.TransactionType.Withdrawal ? "bg-danger" : "bg-info")">
                                                                @transaction.Type
                                                            </span>
                                                        </td>
                                                        <td>@transaction.Description</td>
                                                        <td class="@(transaction.Type == MCBusiness.Models.TransactionType.Deposit || transaction.Type == MCBusiness.Models.TransactionType.Bonus ? "text-success" : transaction.Type == MCBusiness.Models.TransactionType.Withdrawal ? "text-danger" : "text-primary")">
                                                            @(transaction.Type == MCBusiness.Models.TransactionType.Deposit || transaction.Type == MCBusiness.Models.TransactionType.Bonus ? "+" : transaction.Type == MCBusiness.Models.TransactionType.Withdrawal ? "-" : "")@transaction.Amount.ToString("N2") HTG
                                                        </td>
                                                        <td>
                                                            <span class="badge @(transaction.Status == MCBusiness.Models.TransactionStatus.Completed ? "bg-success" : transaction.Status == MCBusiness.Models.TransactionStatus.Pending ? "bg-warning" : "bg-danger")">
                                                                @(transaction.Status == MCBusiness.Models.TransactionStatus.Completed ? "Validé" : transaction.Status == MCBusiness.Models.TransactionStatus.Pending ? "En attente" : "Échoué")
                                                            </span>
                                                        </td>
                                                        <td>@LocalTime.Format(transaction.CreatedAt, "dd/MM HH:mm")</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-4">
                                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                        Aucune transaction récente
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card shadow-sm">
                            <div class="card-header bg-warning text-dark">
                                <h6 class="mb-0">
                                    <i class="bi bi-exclamation-triangle me-2"></i>Alertes & Notifications
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-warning mb-2" role="alert">
                                    <i class="bi bi-clock me-1"></i>
                                    <strong>@Model.countTransPend</strong> transactions en attente de validation
                                </div>
                                <div class="alert alert-info mb-2" role="alert">
                                    <i class="bi bi-people me-1"></i>
                                    <strong>@Model.countUser</strong> utilisateurs inscrits
                                </div>
                                <div class="alert alert-success mb-2" role="alert">
                                    <i class="bi bi-star me-1"></i>
                                    <strong>@Model.countActiveSub</strong> abonnements actifs
                                </div>
                                @if (Model.countTransFailed > 0)
                                {
                                    <div class="alert alert-danger mb-0" role="alert">
                                        <i class="bi bi-exclamation-circle me-1"></i>
                                        <strong>@Model.countTransFailed</strong> transactions échouées à vérifier
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions Rapides Admin -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header bg-dark text-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-lightning-charge me-2"></i>Actions Administratives Rapides
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a asp-page="./Transactions/PlatformTransactions/Create" class="btn btn-outline-primary w-100">
                                            <i class="bi bi-plus-circle me-1"></i>Nouvelle Transaction
                                        </a>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a asp-page="./Users/Index" class="btn btn-outline-success w-100">
                                            <i class="bi bi-people me-1"></i>Gérer Utilisateurs
                                        </a>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a asp-page="./Services/ITServices/Index" class="btn btn-outline-info w-100">
                                            <i class="bi bi-gear me-1"></i>Services IT
                                        </a>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a asp-page="./Plans/Index" class="btn btn-outline-warning w-100">
                                            <i class="bi bi-star me-1"></i>Gérer Plans
                                        </a>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <button class="btn btn-outline-secondary w-100" type="button" disabled>
                                            <i class="bi bi-file-earmark-text me-1"></i>Rapport Mensuel
                                        </button>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <a asp-page="./Payouts/Payout" class="btn btn-outline-danger w-100">
                                            <i class="bi bi-cash-coin me-1"></i>Effectuer Retrait
                                        </a>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <button class="btn btn-outline-dark w-100" type="button" disabled>
                                            <i class="bi bi-shield-check me-1"></i>Sauvegarde Système
                                        </button>
                                    </div>
                                    <div class="col-lg-3 col-md-6 mb-3">
                                        <button class="btn btn-outline-primary w-100" type="button" disabled>
                                            <i class="bi bi-heart-pulse me-1"></i>État du Système
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Graphique Gains Détaillé -->
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header bg-white">
                                <h6 class="mb-0">
                                    <i class="bi bi-graph-up-arrow me-2"></i>Profit Net Plateforme
                                    <span class="badge bg-primary ms-2">DERNIERS 12 MOIS</span>
                                </h6>
                            </div>
                            <div class="card-body">
                                <canvas id="earningsChart" height="80"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeCharts();
            
            // Auto-refresh toutes les 5 minutes
            setInterval(refreshDashboard, 300000);
        });

        function initializeCharts() {
            // Graphique Analytics Principal - Données dynamiques
            const analyticsCtx = document.getElementById('analyticsChart').getContext('2d');
            window.analyticsChart = new Chart(analyticsCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyRevenueLabels ?? new List<string>())),
                    datasets: [{
                        label: 'Revenus Mensuels (HTG)',
                        data: @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyRevenueValues ?? new List<decimal>())),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString() + ' HTG';
                                }
                            }
                        }
                    }
                }
            });

            // Graphique des Abonnements
            const subscriptionsCtx = document.getElementById('subscriptionsChart').getContext('2d');
            new Chart(subscriptionsCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Actifs', 'Terminés', 'Annulés'],
                    datasets: [{
                        data: [@Model.countActiveSub, @Model.countInactiveSub, @Model.countCancelledSub],
                        backgroundColor: ['#198754', '#6c757d', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            });

            // Graphique du profit net plateforme - Données dynamiques
            const earningsCtx = document.getElementById('earningsChart').getContext('2d');
            new Chart(earningsCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyProfitLabels ?? new List<string>())),
                    datasets: [{
                        label: 'Profit net plateforme (HTG)',
                        data: @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyProfitValues ?? new List<decimal>())),
                        backgroundColor: 'rgba(25, 135, 84, 0.8)',
                        borderColor: '#198754',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString() + ' HTG';
                                }
                            }
                        }
                    }
                }
            });
        }

        function toggleChart(type) {
            const chart = window.analyticsChart;
            const datasets = {
                revenue: @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyRevenueValues ?? new List<decimal>())),
                transactions: @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyTransactionCountValues ?? new List<decimal>())),
                users: @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyUsersValues ?? new List<decimal>()))
            };
            
            chart.data.labels = @Html.Raw(Json.Serialize(Model.DashboardData?.MonthlyRevenueLabels ?? new List<string>()));
            chart.data.datasets[0].data = datasets[type];
            chart.data.datasets[0].label = type.charAt(0).toUpperCase() + type.slice(1);
            chart.update();
        }

        function refreshDashboard() {
            location.reload();
        }

        function filterPeriod(period) {
            console.log('Filtrage par:', period);
            // Implémenter le filtrage par période
        }

    </script>
}

@section Styles {
    <style>
        .card {
            transition: box-shadow 0.2s ease, border-color 0.2s ease;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 0.5rem;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
        }
        
        .card:hover {
            border-color: rgba(13, 110, 253, 0.2);
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.1);
        }
        
        .table-sm td {
            padding: 0.5rem;
            font-size: 0.875rem;
        }
        
        .alert {
            font-size: 0.8rem;
            padding: 0.5rem 0.75rem;
        }
        
        .badge {
            font-size: 0.75rem;
        }
        
        .btn-outline-primary:hover, .btn-outline-success:hover, 
        .btn-outline-warning:hover, .btn-outline-info:hover,
        .btn-outline-danger:hover, .btn-outline-secondary:hover,
        .btn-outline-dark:hover {
            transform: translateY(-1px);
            transition: all 0.2s ease;
        }
        
        canvas {
            max-height: 300px;
        }

        @@media (max-width: 767.98px) {
            .container-fluid.px-4 {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }

            .col-lg-9 > .d-flex.justify-content-between {
                align-items: flex-start !important;
                flex-direction: column;
                gap: .75rem;
            }

            .col-lg-9 > .d-flex.justify-content-between > .d-flex {
                flex-wrap: wrap;
                width: 100%;
            }

            .col-lg-9 > .d-flex.justify-content-between .btn,
            .col-lg-9 > .d-flex.justify-content-between .dropdown,
            .col-lg-9 > .d-flex.justify-content-between .dropdown-toggle {
                width: 100%;
            }

            .card-header {
                align-items: flex-start !important;
                flex-direction: column;
                gap: .6rem;
            }

            .card-header .d-flex {
                flex-wrap: wrap;
                width: 100%;
            }

            .card-header .btn {
                flex: 1 1 auto;
            }

            canvas {
                min-height: 240px;
            }
        }
    </style>
}
