@page
@model MCBusiness.Pages_Users_Admin_Notifications.IndexModel

@{
    ViewData["Title"] = "Gestion des Notifications";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-bell me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="Create" class="btn btn-sm btn-light me-2">
                                <i class="bi bi-plus-circle me-1"></i> Nouvelle Notification
                            </a>
                            <button class="btn btn-sm btn-light" id="markAllReadBtn">
                                <i class="bi bi-check-all me-1"></i> Tout marquer comme lu
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher...">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" id="statusFilter">
                                <option value="">Tous les statuts</option>
                                <option value="read">Lus</option>
                                <option value="unread">Non lus</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex justify-content-end">
                            <button class="btn btn-outline-secondary" id="resetFilters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="notificationsTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="sortable" data-sort="user">
                                        <i class="bi bi-person me-1"></i>Utilisateur
                                    </th>
                                    <th class="sortable" data-sort="message">
                                        <i class="bi bi-chat-left-text me-1"></i>Message
                                    </th>
                                    <th class="sortable" data-sort="date">
                                        <i class="bi bi-calendar me-1"></i>Date
                                    </th>
                                    <th class="sortable" data-sort="status">
                                        <i class="bi bi-eye me-1"></i>Statut
                                    </th>
                                    <th class="text-end">
                                        <i class="bi bi-gear me-1"></i>Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Notification) 
                                {
                                    <tr data-status="@(item.IsRead ? "read" : "unread")">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="fw-bold">@item.User?.UserName</span>
                                                <small class="text-muted d-block">@item.User?.Email</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="message-preview">
                                                @if (item.Message.Length > 50)
                                                {
                                                    @item.Message.Substring(0, 50)<text>...</text>
                                                }
                                                else
                                                {
                                                    @item.Message
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @LocalTime.Format(item.CreatedAt, "dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            @if (item.IsRead)
                                            {
                                                <span class="badge bg-success">Lu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Non lu</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détails">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <span id="totalCount">@Model.Notification.Count</span> notifications | 
                            <span id="unreadCount">@Model.Notification.Count(n => !n.IsRead)</span> non lues
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" id="prevPage">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" id="nextPage">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filtrage par recherche
            $('#searchInput').keyup(function() {
                const searchText = $(this).val().toLowerCase();
                filterTable(searchText);
            });

            // Filtrage par statut
            $('#statusFilter').change(function() {
                const status = $(this).val();
                filterTable('', status);
            });

            // Réinitialisation des filtres
            $('#resetFilters').click(function() {
                $('#searchInput').val('');
                $('#statusFilter').val('');
                filterTable('', '');
            });

            // Marquer toutes les notifications comme lues
            $('#markAllReadBtn').click(function() {
                if (confirm('Marquer toutes les notifications comme lues ?')) {
                    $.post('@Url.Page("", "MarkAllAsRead")', function(data) {
                        if (data.success) {
                            location.reload();
                        }
                    });
                }
            });

            // Tri des colonnes
            $('.sortable').click(function() {
                const sortBy = $(this).data('sort');
                // Implémentez la logique de tri ici
                console.log('Tri par: ' + sortBy);
            });

            function filterTable(searchText = '', status = '') {
                let visibleCount = 0;
                let unreadCount = 0;
                
                $('#notificationsTable tbody tr').each(function() {
                    const rowText = $(this).text().toLowerCase();
                    const rowStatus = $(this).data('status');
                    const matchSearch = searchText === '' || rowText.includes(searchText);
                    const matchStatus = status === '' || rowStatus === status;
                    
                    if (matchSearch && matchStatus) {
                        $(this).show();
                        visibleCount++;
                        if (rowStatus === 'unread') unreadCount++;
                    } else {
                        $(this).hide();
                    }
                });
                
                $('#totalCount').text(visibleCount);
                $('#unreadCount').text(unreadCount);
            }
        });
    </script>
}

@section Styles {
    <style>
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            white-space: nowrap;
            cursor: pointer;
            position: relative;
        }
        
        .sort-icon {
            font-size: 0.8em;
            opacity: 0.5;
            margin-left: 5px;
        }
        
        .sortable:hover .sort-icon {
            opacity: 1;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-group .btn {
            border-radius: 0.25rem !important;
        }
        
        .input-group-text {
            background-color: #f8f9fa;
        }
        
        .card-header {
            border-bottom: none;
        }
        
        .message-preview {
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        /* Style pour les statuts */
        .bg-success {
            background-color: #28a745 !important;
        }
        .bg-warning {
            background-color: #ffc107 !important;
        }
    </style>
}
