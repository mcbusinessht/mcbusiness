@page
@model MCBusiness.Pages_Users_Admin_Notifications.DeleteModel

@{
    ViewData["Title"] = "Supprimer la Notification";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash me-2"></i>Supprimer la Notification
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Attention !
                        </h5>
                        <p class="mb-0">Êtes-vous sûr de vouloir supprimer définitivement cette notification ? Cette action est irréversible.</p>
                    </div>

                    <div class="card mb-4 border-danger">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="bi bi-bell me-2"></i>Détails de la Notification</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4 text-muted">
                                    <i class="bi bi-person me-1"></i>Destinataire
                                </dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info">
                                        @Html.DisplayFor(model => model.Notification.User.UserName)
                                    </span>
                                    <small class="text-muted d-block mt-1">
                                        ID: @Html.DisplayFor(model => model.Notification.User.Id)
                                    </small>
                                </dd>

                                <dt class="col-sm-4 text-muted">
                                    <i class="bi bi-calendar me-1"></i>Date d'envoi
                                </dt>
                                <dd class="col-sm-8">
                                    @Html.DisplayFor(model => model.Notification.CreatedAt)
                                </dd>

                                <dt class="col-sm-4 text-muted">
                                    <i class="bi bi-eye me-1"></i>Statut
                                </dt>
                                <dd class="col-sm-8">
                                    @if (Model.Notification.IsRead)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i> Lu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-circle me-1"></i> Non lu
                                        </span>
                                    }
                                </dd>

                                <dt class="col-sm-4 text-muted">
                                    <i class="bi bi-chat-square-text me-1"></i>Message
                                </dt>
                                <dd class="col-sm-8">
                                    <div class="p-3 bg-light rounded mt-2">
                                        @if (!string.IsNullOrEmpty(Model.Notification.Title))
                                        {
                                            <h6 class="text-danger">@Html.DisplayFor(model => model.Notification.Title)</h6>
                                        }
                                        <p class="mb-0">@Html.DisplayFor(model => model.Notification.Message)</p>
                                    </div>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <form method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Notification.Id" />
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-danger me-md-2 px-4">
                                <i class="bi bi-trash-fill me-1"></i> Confirmer la suppression
                            </button>
                            <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-x-circle me-1"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            padding: 0.75rem 1.25rem;
        }
        
        .badge {
            font-size: 0.85em;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }
        
        .btn {
            transition: all 0.2s ease;
            border-radius: 0.375rem;
            min-width: 150px;
        }
        
        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.1);
        }
        
        .alert-warning {
            border-left: 4px solid #ffc107;
        }
        
        .bg-light {
            background-color: #f8f9fa!important;
        }
    </style>
}