@page
@model MCBusiness.Pages_Users_Admin_Notifications.CreateModel

@{
    ViewData["Title"] = "Créer une Notification";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-bell me-2"></i>Créer une Notification
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="fas fa-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <!-- Section Contenu de la Notification -->
                                <div class="card mb-4 border-primary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Contenu de la Notification</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="NotificationInput.Title" class="form-label fw-bold">Titre</label>
                                            <input asp-for="NotificationInput.Title" class="form-control" required />
                                            <span asp-validation-for="NotificationInput.Title" class="text-danger small"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="NotificationInput.Message" class="form-label fw-bold">Message</label>
                                            <textarea asp-for="NotificationInput.Message" class="form-control" rows="5" required></textarea>
                                            <span asp-validation-for="NotificationInput.Message" class="text-danger small"></span>
                                            <div class="form-text">Le message sera envoyé aux utilisateurs sélectionnés</div>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="NotificationInput.NotificationType" class="form-label fw-bold">Type de Notification</label>
                                            <select asp-for="NotificationInput.NotificationType" class="form-select" required>
                                                <option value="general">Général</option>
                                                <option value="order">Commande</option>
                                                <option value="payment">Paiement</option>
                                                <option value="commission">Commission</option>
                                                <option value="referral">Parrainage</option>
                                                <option value="system">Système</option>
                                                <option value="security">Sécurité</option>
                                                <option value="promotion">Promotion</option>
                                                <option value="message">Message</option>
                                            </select>
                                            <span asp-validation-for="NotificationInput.NotificationType" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section Destinataires -->
                                <div class="card mb-4 border-primary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="fas fa-users me-2"></i>Destinataires</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-check form-switch mb-3">
                                            <input class="form-check-input" type="checkbox" asp-for="NotificationInput.SendToAll" id="sendToAll" />
                                            <label class="form-check-label fw-bold" for="sendToAll">Envoyer à tous les utilisateurs</label>
                                        </div>
                                        
                                        <div class="mb-3" id="usersSelection">
                                            <label class="form-label fw-bold">Sélectionnez les destinataires</label>
                                            <select asp-for="NotificationInput.SelectedUserIds" class="form-control select2" multiple="multiple" asp-items="ViewBag.Users">
                                                <option value="">-- Sélectionnez les utilisateurs --</option>
                                            </select>
                                            <div class="form-text">Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs utilisateurs</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Boutons d'action -->
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-primary me-md-2 px-4">
                                        <i class="fas fa-paper-plane me-1"></i> Envoyer
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                        <i class="fas fa-times me-1"></i> Annuler
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            padding: 0.75rem 1.25rem;
        }
        
        .form-control, .form-select {
            border-radius: 0.375rem;
        }
        
        .btn {
            transition: all 0.3s ease;
            border-radius: 0.375rem;
            min-width: 150px;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        }
        
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .form-switch .form-check-input {
            width: 2.5em;
            height: 1.5em;
        }
        
        .select2-container--default .select2-selection--multiple {
            min-height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }
        
        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #e9ecef;
            border: 1px solid #dee2e6;
            border-radius: 0.25rem;
        }
        
        .needs-validation .form-control:invalid, 
        .needs-validation .form-control.is-invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // Initialisation de Select2
        $(document).ready(function() {
            $('.select2').select2({
                placeholder: "Sélectionnez les utilisateurs",
                allowClear: true,
                width: '100%'
            });
            
            // Gérer l'affichage de la sélection des utilisateurs
            $('#sendToAll').change(function() {
                if ($(this).is(':checked')) {
                    $('#usersSelection').slideUp();
                    $('.select2').val(null).trigger('change');
                } else {
                    $('#usersSelection').slideDown();
                }
            });
            
            // Initialiser l'état au chargement
            if ($('#sendToAll').is(':checked')) {
                $('#usersSelection').hide();
            }
            
            // Validation des champs du formulaire
            (function () {
                'use strict'
                
                var forms = document.querySelectorAll('.needs-validation')
                
                Array.prototype.slice.call(forms)
                    .forEach(function (form) {
                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault()
                                event.stopPropagation()
                            }
                            
                            form.classList.add('was-validated')
                        }, false)
                    })
            })()
        });
    </script>
}