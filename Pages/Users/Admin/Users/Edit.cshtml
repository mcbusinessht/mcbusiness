@page
@model             MCBusiness.Pages.Users.Admin.Users.EditModel

@{
    ViewData["Title"] = "Edit";
}
<a asp-page="./Index" class=" btn btn-primary "><i class="bi bi-arrow-return-left"></i> Liste</a>

<h4 class=" text-center ">Modifier l'utilisateur @Model.ApplicationUser.FirstName @Model.ApplicationUser.LastName</h4>

<div class="container-fluid px-4">
    
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial"/>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>Modifier l'utilisateur
                        </h5>
                        <span class="badge bg-light text-dark fs-6">
                            @Model.ApplicationUser.FirstName @Model.ApplicationUser.LastName
                        </span>
                    </div>  
                </div>
                
                <div class="card-body">
                    <form method="post" class="row g-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="ApplicationUser.Id" />
                        
                        <!-- Section 1: Informations personnelles -->
                        <div class="col-md-6">
                            <div class="card h-100 border-light shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-person-badge me-2"></i>Informations personnelles</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.FirstName" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.FirstName" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.FirstName" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.LastName" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.LastName" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.LastName" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.Gender" class="form-label fw-bold"></label>
                                        <select asp-for="ApplicationUser.Gender" class="form-select form-select-lg">
                                            <option value="">Sélectionner</option>
                                            <option value="Male">Masculin</option>
                                            <option value="Female">Féminin</option>
                                            <option value="Other">Autre</option>
                                        </select>
                                        <span asp-validation-for="ApplicationUser.Gender" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.ProfilePictureUrl" class="form-label fw-bold"></label>
                                        <div class="input-group">
                                            <input asp-for="ApplicationUser.ProfilePictureUrl" class="form-control form-control-lg" />
                                            <button class="btn btn-outline-secondary" type="button">
                                                <i class="bi bi-upload"></i>
                                            </button>
                                        </div>
                                        <span asp-validation-for="ApplicationUser.ProfilePictureUrl" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Section 2: Informations de compte -->
                        <div class="col-md-6">
                            <div class="card h-100 border-light shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Informations de compte</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.Email" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.Email" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.Email" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="ApplicationUser.EmailConfirmed" />
                                        <label class="form-check-label fw-bold" asp-for="ApplicationUser.EmailConfirmed"></label>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.PhoneNumber" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.PhoneNumber" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.PhoneNumber" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="ApplicationUser.PhoneNumberConfirmed" />
                                        <label class="form-check-label fw-bold" asp-for="ApplicationUser.PhoneNumberConfirmed"></label>
                                    </div>
                                    
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="ApplicationUser.TwoFactorEnabled" />
                                        <label class="form-check-label fw-bold" asp-for="ApplicationUser.TwoFactorEnabled"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Section 3: Finance & Référence -->
                        <div class="col-md-6">
                            <div class="card h-100 border-light shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Finance & Référence</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.Balance" class="form-label fw-bold"></label>
                                        <div class="input-group">
                                            <span class="input-group-text">HTG</span>
                                            <input asp-for="ApplicationUser.Balance" class="form-control form-control-lg" />
                                        </div>
                                        <span asp-validation-for="ApplicationUser.Balance" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.ReferralCode" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.ReferralCode" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.ReferralCode" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.ReferredBy" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.ReferredBy" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.ReferredBy" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Section 4: Sécurité -->
                        <div class="col-md-6">
                            <div class="card h-100 border-light shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-lock me-2"></i>Sécurité</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.LockoutEnd" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.LockoutEnd" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.LockoutEnd" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="mb-3 form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="ApplicationUser.LockoutEnabled" />
                                        <label class="form-check-label fw-bold" asp-for="ApplicationUser.LockoutEnabled"></label>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label asp-for="ApplicationUser.AccessFailedCount" class="form-label fw-bold"></label>
                                        <input asp-for="ApplicationUser.AccessFailedCount" class="form-control form-control-lg" />
                                        <span asp-validation-for="ApplicationUser.AccessFailedCount" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Boutons d'action -->
                        <div class="col-12 mt-4">
                            <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                                <a asp-page="./Index" class="btn btn-outline-secondary px-4 py-2">
                                    <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                                </a>
                                <button type="submit" class="btn btn-primary px-4 py-2">
                                    <i class="bi bi-save me-2"></i>Enregistrer les modifications
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
