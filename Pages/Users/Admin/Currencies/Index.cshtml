@page
@model MCBusiness.Pages.Users.Admin.Currencies.IndexModel

@{
    ViewData["Title"] = "Gestion des Devises";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-currency-exchange me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="Create" class="btn btn-sm btn-light">
                                <i class="bi bi-plus-circle me-1"></i> Nouvelle Devise
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher une devise...">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" id="currencyFilter">
                                <option value="">Toutes les devises</option>
                                @foreach (var currency in Model.Currency.Select(c => c.CurrencyBase).Distinct())
                                {
                                    <option value="@currency">@currency</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 d-flex justify-content-end">
                            <button class="btn btn-outline-secondary" id="resetFilters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="currenciesTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="sortable" data-sort="currency">
                                        <i class="bi bi-currency-bitcoin me-1"></i>
                                        Devise
                                        <i class="bi bi-arrow-down-up sort-icon"></i>
                                    </th>
                                    <th class="sortable" data-sort="rate">
                                        <i class="bi bi-percent me-1"></i>
                                        Taux de change
                                        <i class="bi bi-arrow-down-up sort-icon"></i>
                                    </th>
                                    <th class="sortable" data-sort="date">
                                        <i class="bi bi-calendar me-1"></i>
                                        Dernière mise à jour
                                        <i class="bi bi-arrow-down-up sort-icon"></i>
                                    </th>
                                    <th class="text-end">
                                        <i class="bi bi-gear me-1"></i>
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Currency)
                                {
                                    <tr data-currency="@item.CurrencyBase">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-primary me-2">@item.Symbol</span>
                                                @item.CurrencyBase
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-success">
                                                1 @Model.BaseCurrencySymbol = @item.RateToBase.ToString("N4") @item.CurrencyBase
                                            </span>
                                        </td>
                                        <td>
                                            @item.LastUpdated.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détails">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <span id="totalCount">@Model.Currency.Count</span> devises enregistrées
                            <span class="ms-2">(Devise de base : @Model.BaseCurrencySymbol)</span>
                        </div>
                        <a asp-page="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Ajouter une devise
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filtrage par recherche
            $('#searchInput').keyup(function() {
                const searchText = $(this).val().toLowerCase();
                filterTable(searchText);
            });

            // Filtrage par devise
            $('#currencyFilter').change(function() {
                const currency = $(this).val();
                filterTable('', currency);
            });

            // Réinitialisation des filtres
            $('#resetFilters').click(function() {
                $('#searchInput').val('');
                $('#currencyFilter').val('');
                filterTable('', '');
            });

            // Tri des colonnes
            $('.sortable').click(function() {
                const sortBy = $(this).data('sort');
                // Implémentez la logique de tri ici
                console.log('Tri par: ' + sortBy);
            });

            function filterTable(searchText = '', currency = '') {
                let visibleCount = 0;
                
                $('#currenciesTable tbody tr').each(function() {
                    const currencyName = $(this).find('td:first').text().toLowerCase();
                    const rowCurrency = $(this).data('currency');
                    const matchSearch = searchText === '' || currencyName.includes(searchText);
                    const matchCurrency = currency === '' || rowCurrency === currency;
                    
                    if (matchSearch && matchCurrency) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                
                $('#totalCount').text(visibleCount);
            }
        });
    </script>
}

@section Styles {
    <style>
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            white-space: nowrap;
            cursor: pointer;
            position: relative;
        }
        
        .sort-icon {
            font-size: 0.8em;
            opacity: 0.5;
            margin-left: 5px;
        }
        
        .sortable:hover .sort-icon {
            opacity: 1;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-group .btn {
            border-radius: 0.25rem !important;
        }
        
        .input-group-text {
            background-color: #f8f9fa;
        }
        
        .card-header {
            border-bottom: none;
        }
    </style>
}