@page
@model MCBusiness.Pages.Users.Admin.Currencies.CreateModel

@{
    ViewData["Title"] = "Ajouter une devise";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-plus-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Menu latéral -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-currency-exchange me-2"></i>Menu Devises
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="./Index" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-list-ul me-2"></i>Liste des devises
                                        </a>
                                        <a asp-page="./Create" class="list-group-item list-group-item-action">
                                            <i class="bi bi-plus-circle me-2"></i>Ajouter une devise
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Formulaire de création -->
                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <form method="post" class="needs-validation" novalidate>
                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                                        
                                        <div class="mb-4">
                                            <label asp-for="Currency.CurrencyBase" class="form-label fw-bold">
                                                <i class="bi bi-currency-bitcoin me-2"></i>Devise <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="Currency.CurrencyBase" class="form-select" asp-items="ViewBag.Currencies" required>
                                                <option value="">-- Sélectionner une devise --</option>
                                            </select>
                                            <span asp-validation-for="Currency.CurrencyBase" class="text-danger small"></span>
                                        </div>
                                        
                                        <div class="mb-4">
                                            <label asp-for="Currency.RateToBase" class="form-label fw-bold">
                                                <i class="bi bi-percent me-2"></i>Taux de change <span class="text-danger">*</span>
                                            </label>
                                            <div class="input-group">
                                                <input asp-for="Currency.RateToBase" class="form-control" placeholder="Entrez le taux de change" required />
                                                <span class="input-group-text">HTG</span>
                                            </div>
                                            <span asp-validation-for="Currency.RateToBase" class="text-danger small"></span>
                                            <div class="form-text">Exemple: Pour 1 USD = 120 HTG, entrez 120</div>
                                        </div>
                                        
                                        <div class="d-flex justify-content-between align-items-center mt-4">
                                            <a asp-page="Index" class="btn btn-outline-secondary">
                                                <i class="bi bi-x-circle me-1"></i> Annuler
                                            </a>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="bi bi-check-circle me-1"></i> Enregistrer
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Activation de la validation Bootstrap
        (function () {
            'use strict'
            
            var forms = document.querySelectorAll('.needs-validation')
            
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .list-group-item.active:hover {
            background-color: #0d6efd;
            transform: none;
        }
        
        .form-control, .form-select {
            border-radius: 0.25rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        
        .form-select {
            cursor: pointer;
        }
        
        .btn {
            transition: all 0.2s ease;
        }
        
        .alert-danger {
            border-left: 4px solid #dc3545;
        }
        
        .input-group-text {
            background-color: #f8f9fa;
        }
    </style>
}