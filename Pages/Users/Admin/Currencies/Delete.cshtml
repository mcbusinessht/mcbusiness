@page
@model MCBusiness.Pages.Users.Admin.Currencies.DeleteModel
@using MCBusiness.Models

@{
    ViewData["Title"] = "Supprimer une devise";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-trash me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-danger">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Attention !
                        </h5>
                        <p class="mb-0">
                            Vous êtes sur le point de supprimer définitivement cette devise. 
                            Cette action est irréversible et affectera toutes les transactions associées.
                        </p>
                    </div>

                    <div class="row">
                        <!-- Menu latéral -->
                        <div class="col-md-3 mb-4 mb-md-0">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-currency-exchange me-2"></i>Menu Devises
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <div class="list-group list-group-flush">
                                        <a asp-page="./Index" class="list-group-item list-group-item-action">
                                            <i class="bi bi-list-ul me-2"></i>Liste des devises
                                        </a>
                                        <a asp-page="./Create" class="list-group-item list-group-item-action">
                                            <i class="bi bi-plus-circle me-2"></i>Ajouter une devise
                                        </a>
                                        <a asp-page="./Delete" class="list-group-item list-group-item-action active">
                                            <i class="bi bi-trash me-2"></i>Supprimer devise
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Détails de la devise à supprimer -->
                        <div class="col-md-9">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="text-center mb-4">
                                        @{
                                            var symbol = Model.Currency.CurrencyBase switch
                                            {
                                                CurrencyCode.EUR => "€",
                                                CurrencyCode.USD => "$",
                                                CurrencyCode.HTG => "HTG",
                                                CurrencyCode.CAD => "CA$",
                                                CurrencyCode.DOP => "RD$",
                                                CurrencyCode.GBP => "£",
                                                _ => Model.Currency.CurrencyBase.ToString()
                                            };
                                        }
                                        <span class="badge bg-danger p-3 display-6">@symbol</span>
                                        <h3 class="mt-3 text-danger">@Model.Currency.CurrencyBase</h3>
                                    </div>

                                    <dl class="row mb-4">
                                        <dt class="col-sm-4 text-end fw-bold">
                                            <i class="bi bi-currency-bitcoin me-2"></i>Code :
                                        </dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-primary">@Model.Currency.CurrencyBase</span>
                                        </dd>

                                        <dt class="col-sm-4 text-end fw-bold">
                                            <i class="bi bi-percent me-2"></i>Taux de change :
                                        </dt>
                                        <dd class="col-sm-8">
                                            <span class="badge bg-success">1 HTG = @Model.Currency.RateToBase.ToString("N4") @Model.Currency.CurrencyBase</span>
                                        </dd>

                                        <dt class="col-sm-4 text-end fw-bold">
                                            <i class="bi bi-calendar me-2"></i>Dernière mise à jour :
                                        </dt>
                                        <dd class="col-sm-8">
                                            @Model.Currency.LastUpdated.ToString("dd/MM/yyyy HH:mm")
                                        </dd>
                                    </dl>

                                    <div class="alert alert-warning">
                                        <i class="bi bi-exclamation-circle me-2"></i>
                                        <strong>Attention :</strong> La suppression de cette devise affectera toutes les transactions qui l'utilisent.
                                    </div>

                                    <form method="post" class="mt-4">
                                        <input type="hidden" asp-for="Currency.Id" />
                                        <div class="d-flex justify-content-between align-items-center">
                                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                                <i class="bi bi-x-circle me-1"></i> Annuler
                                            </a>
                                            <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous certain de vouloir supprimer cette devise ? Cette action est irréversible.');">
                                                <i class="bi bi-trash me-1"></i> Confirmer la suppression
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .list-group-item {
            border-left: 0;
            border-right: 0;
            transition: all 0.3s ease;
        }
        
        .list-group-item:first-child {
            border-top: 0;
        }
        
        .list-group-item:last-child {
            border-bottom: 0;
        }
        
        .list-group-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }
        
        .list-group-item.active:hover {
            background-color: #0d6efd;
            transform: none;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.5em 0.75em;
        }
        
        .alert-danger {
            border-left: 4px solid #dc3545;
        }
        
        .alert-warning {
            border-left: 4px solid #ffc107;
        }
        
        dt {
            color: #6c757d;
        }
        
        dd {
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }
        
        .btn {
            transition: all 0.2s ease;
        }
        
        .display-6 {
            font-size: 2rem;
        }
    </style>
}