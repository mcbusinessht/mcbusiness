@page
@model MCBusiness.Pages.Users.Admin.Medias.Index
@{
    ViewData["Title"] = "Gestion des Médias";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-images me-2"></i>Gestion des Médias
                        </h4>
                        <a asp-page="./../Dashboard" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Dashboard
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Bouton d'ajout et statistiques -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <a asp-page="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-1"></i> Ajouter un média
                        </a>
                        <span class="badge bg-info">
                            <i class="bi bi-collection me-1"></i> @Model.media.Count médias au total
                        </span>
                    </div>

                    <!-- Tableau des médias -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="text-nowrap">
                                        <i class="bi bi-hash me-1"></i>ID
                                    </th>
                                    <th scope="col" class="text-nowrap">
                                        <i class="bi bi-file-earmark-text me-1"></i>Nom
                                    </th>
                                    <th scope="col" class="text-nowrap">
                                        <i class="bi bi-text-left me-1"></i>Texte alternatif
                                    </th>
                                    <th scope="col" class="text-nowrap">
                                        <i class="bi bi-file-arrow-down me-1"></i>Taille
                                    </th>
                                    <th scope="col" class="text-nowrap">
                                        <i class="bi bi-folder me-1"></i>Chemin
                                    </th>
                                    <th scope="col" class="text-nowrap">
                                        <i class="bi bi-calendar me-1"></i>Date
                                    </th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.media)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                        <td>
                                            <span class="d-inline-block text-truncate" style="max-width: 150px;">
                                                @Html.DisplayFor(modelItem => item.Name)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="d-inline-block text-truncate" style="max-width: 150px;">
                                                @Html.DisplayFor(modelItem => item.Alt)
                                            </span>
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.SizeInKb) KB</td>
                                        <td>
                                            <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                @Html.DisplayFor(modelItem => item.Path)
                                            </span>
                                        </td>
                                        <td>@item.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Détails">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Modifier">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination (optionnelle) -->
                    @if (Model.media.Count == 0)
                    {
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle me-2"></i>Aucun média trouvé
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            padding: 0.75rem 1.25rem;
        }
        
        .table th {
            font-weight: 500;
            background-color: #f8f9fa;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-group .btn {
            border-radius: 0.25rem !important;
        }
        
        .text-truncate {
            max-width: 0;
        }
        
        .badge {
            font-size: 0.85em;
            font-weight: 500;
            padding: 0.5em 0.75em;
        }
    </style>
}