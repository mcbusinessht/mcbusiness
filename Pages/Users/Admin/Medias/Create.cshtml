@page
@model MCBusiness.Pages.Users.Admin.Medias.CreateModel
@{
    ViewData["Title"] = "Ajouter un Média";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-cloud-upload me-2"></i>Ajouter un Média
                        </h4>
                        <a asp-page="./Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8 col-lg-6">
                            <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <!-- Section Informations -->
                                <div class="card mb-4 border-primary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations du fichier</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="NameM" class="form-label fw-bold">
                                                <i class="bi bi-file-earmark-text me-1"></i>Nom du fichier
                                            </label>
                                            <input asp-for="NameM" type="text" class="form-control" placeholder="mon-fichier" required>
                                            <div class="invalid-feedback">Veuillez saisir un nom de fichier valide</div>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="AltM" class="form-label fw-bold">
                                                <i class="bi bi-card-text me-1"></i>Texte alternatif
                                            </label>
                                            <input asp-for="AltM" type="text" class="form-control" placeholder="photo-de-profil" required>
                                            <div class="invalid-feedback">Veuillez saisir un texte alternatif</div>
                                            <small class="text-muted">Description pour l'accessibilité et le référencement</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section Upload -->
                                <div class="card mb-4 border-primary">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0"><i class="bi bi-image me-2"></i>Téléversement du fichier</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label for="fileUpload" class="form-label fw-bold">
                                                <i class="bi bi-file-arrow-up me-1"></i>Sélectionner le fichier
                                            </label>
                                            <input name="UploadedImage" id="fileUpload" type="file" accept="image/*" class="form-control" required>
                                            <div class="invalid-feedback">Veuillez sélectionner un fichier valide</div>
                                            <small class="text-muted">Formats acceptés: JPG, PNG, GIF (Max 5MB)</small>
                                        </div>
                                        <div class="text-center mt-3" id="imagePreviewContainer" style="display: none;">
                                            <img id="imagePreview" class="img-thumbnail" style="max-width: 200px; height: auto;" alt="Aperçu de l'image">
                                            <p class="small text-muted mt-2">Aperçu de l'image</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Boutons d'action -->
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-primary me-md-2 px-4">
                                        <i class="bi bi-save me-1"></i> Enregistrer
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                </div>

                                <!-- Affichage des erreurs -->
                                @if (ModelState.ContainsKey("UploadedErrorKey"))
                                {
                                    <div class="alert alert-danger mt-3">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        @ModelState["UploadedErrorKey"].Errors[0].ErrorMessage
                                    </div>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
            overflow: hidden;
        }
        
        .card-header {
            padding: 0.75rem 1.25rem;
        }
        
        .form-control, .form-select {
            border-radius: 0.375rem;
        }
        
        .btn {
            transition: all 0.2s ease;
            border-radius: 0.375rem;
            min-width: 150px;
        }
        
        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.1);
        }
        
        .img-thumbnail {
            border: 2px dashed #dee2e6;
            border-radius: 0.75rem;
            transition: all 0.3s ease;
        }
        
        .needs-validation .form-control:invalid, 
        .needs-validation .form-control.is-invalid {
            border-color: #dc3545;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Validation des champs du formulaire
        (function () {
            'use strict'
            
            var forms = document.querySelectorAll('.needs-validation')
            
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
        
        // Prévisualisation de l'image uploadée
        document.getElementById('fileUpload').addEventListener('change', function(e) {
            const previewContainer = document.getElementById('imagePreviewContainer');
            const preview = document.getElementById('imagePreview');
            
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                
                reader.onload = function(event) {
                    preview.src = event.target.result;
                    previewContainer.style.display = 'block';
                }
                
                reader.readAsDataURL(e.target.files[0]);
            } else {
                previewContainer.style.display = 'none';
            }
        });
    </script>
}