@page
@model MCBusiness.Pages_Users_Admin_SellerPayments.IndexModel
@using System.Globalization

@{
    ViewData["Title"] = "Gestion des Paiements Fournisseurs";
    var culture = new CultureInfo("fr-FR");
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-credit-card me-2"></i>@ViewData["Title"]
                        </h4>
                        <div>
                            <a asp-page="Create" class="btn btn-sm btn-light">
                                <i class="bi bi-plus-circle me-1"></i> Nouveau Paiement
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher...">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" id="statusFilter">
                                <option value="">Tous les statuts</option>
                                <option value="Pending">En attente</option>
                                <option value="Completed">Complété</option>
                                <option value="Failed">Échoué</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex justify-content-end">
                            <button class="btn btn-outline-secondary" id="resetFilters">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="paymentsTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="sortable" data-sort="company">
                                        <i class="bi bi-building me-1"></i>Fournisseur
                                    </th>
                                    <th class="sortable" data-sort="order">
                                        <i class="bi bi-cart me-1"></i>Commande
                                    </th>
                                    <th class="sortable" data-sort="amount">
                                        <i class="bi bi-cash-stack me-1"></i>Montant
                                    </th>
                                    <th class="sortable" data-sort="date">
                                        <i class="bi bi-calendar me-1"></i>Date Paiement
                                    </th>
                                    <th class="sortable" data-sort="status">
                                        <i class="bi bi-info-circle me-1"></i>Statut
                                    </th>
                                    <th class="sortable" data-sort="method">
                                        <i class="bi bi-credit-card me-1"></i>Méthode
                                    </th>
                                    <th class="text-end">
                                        <i class="bi bi-gear me-1"></i>Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SellerPayment) 
                                {
                                    <tr data-status="@item.Status">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <span class="fw-bold d-block">@item.Company?.Name</span>
                                                    <small class="text-muted">
                                                        <i class="bi bi-geo-alt me-1"></i>
                                                        @Model.GetCompanyCity(item.Company)
                                                    </small>
                                                    @if (!string.IsNullOrEmpty(item.Company?.Email))
                                                    {
                                                        <small class="text-muted d-block">
                                                            <i class="bi bi-envelope me-1"></i>
                                                            @item.Company.Email
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.Order != null)
                                            {
                                                <span class="badge bg-primary">#@item.Order.Id</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">N/A</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-bold text-success">
                                                @((item.ProductTotal + item.DeliveryFee - item.SalesCommission).ToString("C0", culture))
                                            </span>
                                            <small class="text-muted d-block">
                                                <span>Prod: @item.ProductTotal.ToString("C0", culture)</span> |
                                                <span>Liv: @item.DeliveryFee.ToString("C0", culture)</span> |
                                                <span>Com: @item.SalesCommission.ToString("C0", culture)</span>
                                            </small>
                                            <small class="text-muted">
                                                @item.Currency?.CurrencyBase
                                            </small>
                                        </td>
                                        <td>
                                            @LocalTime.Format(item.PaymentDate, "dd/MM/yyyy HH:mm", culture)
                                        </td>
                                        <td>
                                            @{
                                                @using MCBusiness.Models;
                                                var statusClass = item.Status switch
                                                {
                                                    PaymentStatus.Completed => "bg-success",
                                                    PaymentStatus.Failed => "bg-danger",
                                                    _ => "bg-warning text-dark"
                                                };
                                            }
                                            <span class="badge @statusClass">@item.Status</span>
                                            @if (item.IsPaidToSeller)
                                            {
                                                <small class="text-muted d-block">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Payé le @LocalTime.Format(item.PaidToSellerAt, "dd/MM/yyyy", culture)
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-muted d-block">En attente de paiement</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark">@item.PaymentMethod</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détails">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <span id="totalCount">@Model.SellerPayment.Count</span> paiements trouvés
                        </div>
                        <div>
                            <span class="badge bg-success me-2">
                                Complété: @Model.SellerPayment.Count(s => s.Status == PaymentStatus.Completed)
                            </span>
                            <span class="badge bg-warning text-dark me-2">
                                En attente: @Model.SellerPayment.Count(s => s.Status == PaymentStatus.Pending)
                            </span>
                            <span class="badge bg-danger">
                                Échoué: @Model.SellerPayment.Count(s => s.Status == PaymentStatus.Failed)
                            </span>
                        </div>
                        <a asp-page="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Ajouter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filtrage par recherche
            $('#searchInput').keyup(function() {
                const searchText = $(this).val().toLowerCase();
                filterTable(searchText);
            });

            // Filtrage par statut
            $('#statusFilter').change(function() {
                const status = $(this).val();
                filterTable('', status);
            });

            // Réinitialisation des filtres
            $('#resetFilters').click(function() {
                $('#searchInput').val('');
                $('#statusFilter').val('');
                filterTable('', '');
            });

            // Tri des colonnes
            $('.sortable').click(function() {
                const sortBy = $(this).data('sort');
                // Implémentez la logique de tri ici
                console.log('Tri par: ' + sortBy);
            });

            function filterTable(searchText = '', status = '') {
                let visibleCount = 0;
                
                $('#paymentsTable tbody tr').each(function() {
                    const rowText = $(this).text().toLowerCase();
                    const rowStatus = $(this).data('status');
                    const matchSearch = searchText === '' || rowText.includes(searchText);
                    const matchStatus = status === '' || rowStatus === status;
                    
                    if (matchSearch && matchStatus) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });
                
                $('#totalCount').text(visibleCount);
            }
        });
    </script>
}

@section Styles {
    <style>
        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            white-space: nowrap;
            cursor: pointer;
            position: relative;
        }
        
        .sort-icon {
            font-size: 0.8em;
            opacity: 0.5;
            margin-left: 5px;
        }
        
        .sortable:hover .sort-icon {
            opacity: 1;
        }
        
        .badge {
            font-size: 0.85em;
            padding: 0.35em 0.65em;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }
        
        .btn-group .btn {
            border-radius: 0.25rem !important;
        }
        
        .input-group-text {
            background-color: #f8f9fa;
        }
        
        .card-header {
            border-bottom: none;
        }
        
        /* Style pour les statuts */
        .bg-success {
            background-color: #28a745 !important;
        }
        .bg-danger {
            background-color: #dc3545 !important;
        }
        .bg-warning {
            background-color: #ffc107 !important;
        }
        .bg-info {
            background-color: #17a2b8 !important;
        }
        .bg-secondary {
            background-color: #6c757d !important;
        }
    </style>
}
