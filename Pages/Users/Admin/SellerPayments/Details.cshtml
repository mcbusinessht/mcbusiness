@page
@model MCBusiness.Pages_Users_Admin_SellerPayments.DetailsModel
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@attribute [Authorize(Roles = "Admin")]

@{
    ViewData["Title"] = "Détails du Paiement Fournisseur";
    var culture = new CultureInfo("fr-FR");
    var totalAmount = Model.SellerPayment.ProductTotal + Model.SellerPayment.DeliveryFee - Model.SellerPayment.SalesCommission;
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-credit-card me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Carte Informations principales -->
                        <div class="col-md-6">
                            <div class="card mb-4 border-primary">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-info-circle me-2"></i>Informations principales
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-building me-1"></i> Fournisseur
                                        </h6>
                                        <p class="fw-bold">
                                            @Model.SellerPayment.Company?.Name
                                            <!-- CORRECTION : Utilisation de la méthode utilitaire -->
                                            <small class="text-muted d-block">
                                                <i class="bi bi-geo-alt me-1"></i>
                                                @Model.GetCompanyCity(Model.SellerPayment.Company)
                                            </small>
                                            @if (!string.IsNullOrEmpty(Model.SellerPayment.Company?.Email))
                                            {
                                                <small class="text-muted d-block">
                                                    <i class="bi bi-envelope me-1"></i>
                                                    @Model.SellerPayment.Company.Email
                                                </small>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.SellerPayment.Company?.PhoneNumber))
                                            {
                                                <small class="text-muted d-block">
                                                    <i class="bi bi-telephone me-1"></i>
                                                    @Model.SellerPayment.Company.PhoneNumber
                                                </small>
                                            }
                                        </p>
                                    </div>

                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-cart me-1"></i> Commande
                                        </h6>
                                        <p class="fw-bold">
                                            @if (Model.SellerPayment.Order != null)
                                            {
                                                <span class="badge bg-primary">#@Model.SellerPayment.Order.Id</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">N/A</span>
                                            }
                                        </p>
                                    </div>

                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-calendar me-1"></i> Date de paiement
                                        </h6>
                                        <p class="fw-bold">
                                            @LocalTime.Format(Model.SellerPayment.PaymentDate, "dd/MM/yyyy HH:mm", culture)
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Carte Détails financiers -->
                        <div class="col-md-6">
                            <div class="card mb-4 border-primary">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-cash-stack me-2"></i>Détails financiers
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-currency-exchange me-1"></i> Montant total
                                        </h6>
                                        <p class="fs-4 fw-bold text-primary">
                                            @totalAmount.ToString("C0", culture)
                                            <small class="text-muted d-block">
                                                @Model.SellerPayment.Currency?.CurrencyBase
                                            </small>
                                        </p>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <h6 class="text-muted mb-1">
                                                    <i class="bi bi-box-seam me-1"></i> Produits
                                                </h6>
                                                <p class="fw-bold">
                                                    @Model.SellerPayment.ProductTotal.ToString("C0", culture)
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <h6 class="text-muted mb-1">
                                                    <i class="bi bi-truck me-1"></i> Livraison
                                                </h6>
                                                <p class="fw-bold">
                                                    @Model.SellerPayment.DeliveryFee.ToString("C0", culture)
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <h6 class="text-muted mb-1">
                                                    <i class="bi bi-percent me-1"></i> Commission
                                                </h6>
                                                <p class="fw-bold">
                                                    -@Model.SellerPayment.SalesCommission.ToString("C0", culture)
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Carte Statut de paiement -->
                        <div class="col-md-6">
                            <div class="card mb-4 border-primary">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-credit-card me-2"></i>Statut de paiement
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-info-circle me-1"></i> Statut
                                        </h6>
                                        @{
                                            @using MCBusiness.Models;
                                            var statusClass = Model.SellerPayment.Status switch
                                            {
                                                PaymentStatus.Completed => "bg-success",
                                                PaymentStatus.Failed => "bg-danger",
                                                _ => "bg-warning text-dark"
                                            };
                                        }
                                        <p>
                                            <span class="badge @statusClass">@Model.SellerPayment.Status</span>
                                        </p>
                                    </div>

                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-credit-card me-1"></i> Méthode
                                        </h6>
                                        <p class="fw-bold">
                                            @Model.SellerPayment.PaymentMethod
                                        </p>
                                    </div>

                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-receipt me-1"></i> Référence
                                        </h6>
                                        <p class="fw-bold">
                                            @(string.IsNullOrEmpty(Model.SellerPayment.ExternalTransactionId) 
                                                ? "Non renseignée" 
                                                : Model.SellerPayment.ExternalTransactionId)
                                        </p>
                                    </div>

                                    @if (Model.SellerPayment.IsPaidToSeller)
                                    {
                                        <div class="mb-3">
                                            <h6 class="text-muted mb-1">
                                                <i class="bi bi-check-circle me-1"></i> Paiement effectué
                                            </h6>
                                            <p class="fw-bold">
                                                @LocalTime.Format(Model.SellerPayment.PaidToSellerAt, "dd/MM/yyyy HH:mm", culture)
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Carte Métadonnées -->
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-gear me-2"></i>Métadonnées
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-calendar-plus me-1"></i> Date de création
                                        </h6>
                                        <p class="fw-bold">
                                            @LocalTime.Format(Model.SellerPayment.CreatedAt, "dd/MM/yyyy HH:mm", culture)
                                        </p>
                                    </div>

                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-clock-history me-1"></i> Dernière modification
                                        </h6>
                                        <p class="fw-bold">
                                            @(Model.SellerPayment.ModifiedAt != default(DateTimeOffset) ? LocalTime.Format(Model.SellerPayment.ModifiedAt, "dd/MM/yyyy HH:mm", culture) : "Non modifié")
                                        </p>
                                    </div>

                                    @if (Model.SellerPayment.IsDeleted)
                                    {
                                        <div class="mb-3">
                                            <h6 class="text-muted mb-1">
                                                <i class="bi bi-trash me-1"></i> Supprimé le
                                            </h6>
                                            <p class="fw-bold">
                                                @(Model.SellerPayment.IsDeleted ? "Supprimé" : "Actif")
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                        <div class="btn-group" role="group">
                            <a asp-page="./Edit" asp-route-id="@Model.SellerPayment.Id" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                            <a asp-page="./Delete" asp-route-id="@Model.SellerPayment.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-1"></i> Supprimer
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        ID Paiement: @Model.SellerPayment.Id | 
                        Consulté le: @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy HH:mm", culture)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
        }
        
        .border-primary {
            border-left: 4px solid #0d6efd !important;
        }
        
        .btn {
            border-radius: 0.25rem;
        }
        
        .badge {
            font-size: 0.9em;
            padding: 0.35em 0.65em;
        }
        
        .bg-success {
            background-color: #198754 !important;
        }
        
        .bg-warning {
            background-color: #ffc107 !important;
        }
        
        .bg-danger {
            background-color: #dc3545 !important;
        }
    </style>
}
