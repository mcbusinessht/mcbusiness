@page
@model MCBusiness.Pages_Users_Admin_ManageEmployees_Employees.DeleteModel
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@attribute [Authorize(Roles = "Admin")]
@using MCBusiness.Models;
@{
    ViewData["Title"] = "Supprimer un employé";
    var culture = new CultureInfo("fr-FR");
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Annuler
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-danger" role="alert">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i>Attention : Action irréversible !
                        </h5>
                        <p>
                            Vous êtes sur le point de supprimer définitivement cet employé. Cette action ne peut pas être annulée.
                            Toutes les données associées à cet employé seront perdues.
                        </p>
                    </div>

                    <div class="card mb-4 border-danger">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="bi bi-person-badge me-2"></i>Identité de l'employé
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-person me-1"></i> Utilisateur
                                        </h6>
                                        <p class="fw-bold">
                                            @Model.Employee.User?.UserName
                                            <small class="text-muted d-block">ID: @Model.Employee.User?.Id</small>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-briefcase me-1"></i> Poste
                                        </h6>
                                        <p class="fw-bold">
                                            @Model.Employee.Post?.Name
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4 border-danger">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-file-earmark-text me-2"></i>Informations contractuelles
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-calendar-plus me-1"></i> Date d'embauche
                                        </h6>
                                        <p class="fw-bold">
                                            @Model.Employee.HiredAt.ToString("dd/MM/yyyy")
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-calendar-minus me-1"></i> Fin de contrat
                                        </h6>
                                        <p class="fw-bold">
                                            @(Model.Employee.ContractEndDate.HasValue ? Model.Employee.ContractEndDate.Value.ToString("dd/MM/yyyy") : "Indéterminée")
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-info-circle me-1"></i> Statut
                                        </h6>
                                        <p>
                                            <span class="badge @(Model.Employee.IsDeleted ? "bg-secondary" : Model.Employee.Status == EmployeeStatus.Active ? "bg-success" : "bg-warning text-dark")">
                                                @(Model.Employee.IsDeleted ? "Supprimé" : Model.Employee.Status.ToString())
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-danger">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="bi bi-cash-stack me-2"></i>Informations salariales
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-currency-dollar me-1"></i> Salaire actuel
                                        </h6>
                                        <p class="fw-bold">
                                            @Model.Employee.Salary.ToString("C", culture)
                                            <small class="text-muted d-block">@Model.Employee.Currency?.CurrencyBase</small>
                                        </p>
                                    </div>
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-1">
                                            <i class="bi bi-clock-history me-1"></i> Dernière mise à jour
                                        </h6>
                                        <p class="fw-bold">
                                            @Model.Employee.UpdatedAt
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form method="post" class="mt-4">
                        <input type="hidden" asp-for="Employee.Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash3 me-1"></i> Confirmer la suppression
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light">
                    <div class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        ID employé: @Model.Employee.Id | 
                        Dernière consultation: @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy HH:mm")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
        }
        
        .border-danger {
            border-left: 4px solid #dc3545 !important;
        }
        
        .btn {
            border-radius: 0.25rem;
        }
        
        .badge {
            font-size: 0.9em;
            padding: 0.35em 0.65em;
        }
        
        .bg-success {
            background-color: #198754 !important;
        }
        
        .bg-warning {
            background-color: #ffc107 !important;
        }
        
        .bg-secondary {
            background-color: #6c757d !important;
        }
        
        .alert-danger {
            border-left: 4px solid #dc3545;
        }
    </style>
}