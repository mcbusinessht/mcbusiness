@page
@model MCBusiness.Pages_Users_Admin_ManageEmployees_Posts.DetailsModel

@{
    ViewData["Title"] = "Détails du poste";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title text-primary mb-4">
                                        <i class="bi bi-briefcase me-2"></i>Informations du poste
                                    </h5>
                                    
                                    <div class="row mb-3">
                                        <div class="col-md-4 fw-bold text-muted">
                                            <i class="bi bi-tag me-1"></i>Nom du poste:
                                        </div>
                                        <div class="col-md-8">
                                            <span class="fs-5">@Html.DisplayFor(model => model.Post.Name)</span>
                                        </div>
                                    </div>

                                    <!-- Vous pouvez ajouter d'autres informations ici si votre modèle s'étend -->
                                    <!--
                                    <div class="row mb-3">
                                        <div class="col-md-4 fw-bold text-muted">
                                            <i class="bi bi-people me-1"></i>Nombre d'employés:
                                        </div>
                                        <div class="col-md-8">
                                            <span class="badge bg-primary">12 employés</span>
                                        </div>
                                    </div>
                                    -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                        </a>
                        <div class="btn-group" role="group">
                            <a asp-page="./Edit" asp-route-id="@Model.Post.Id" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i> Modifier
                            </a>
                            <a asp-page="./Delete" asp-route-id="@Model.Post.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-1"></i> Supprimer
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="small text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Dernière mise à jour: @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy HH:mm")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 0.5rem;
        }
        
        .btn {
            border-radius: 0.25rem;
        }
        
        .bg-light {
            background-color: #f8f9fa !important;
        }
        
        .text-muted {
            color: #6c757d !important;
        }
        
        .card-title {
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 0.75rem;
        }
    </style>
}