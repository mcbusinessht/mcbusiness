@page
@model MCBusiness.Pages_Users_Admin_ManageEmployees_Posts.IndexModel
@{
    ViewData["Title"] = "Gestion des Postes";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-briefcase-fill me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Create" class="btn btn-sm btn-light">
                            <i class="bi bi-plus-circle me-1"></i> Nouveau Poste
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        <i class="bi bi-tag me-1"></i> Nom du Poste
                                    </th>
                                    <th class="text-end">
                                        <i class="bi bi-gear me-1"></i> Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Post)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@item.Name</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group" role="group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détails">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i> @Model.Post.Count poste(s) disponible(s)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
