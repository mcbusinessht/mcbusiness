@page
@model MCBusiness.Pages_Users_Admin_Categories.CreateModel
@using MCBusiness.Models

@{
    ViewData["Title"] = "Nouvelle Catégorie";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-plus-circle me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                                
                                <div class="mb-4">
                                    <label asp-for="Name" class="form-label fw-bold">
                                        <i class="bi bi-tag me-2"></i>Nom de la catégorie <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" class="form-control" placeholder="Entrez le nom de la catégorie" required />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                    <div class="form-text">Le nom doit être unique et descriptif</div>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="Type" class="form-label fw-bold">
                                        <i class="bi bi-grid me-2"></i>Type de catégorie <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<CategoryType>()" required>
                                        <option value="">-- Sélectionnez un type --</option>
                                    </select>
                                    <span asp-validation-for="Type" class="text-danger small"></span>
                                    <div class="form-text">Définit le type d'éléments que contiendra cette catégorie</div>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="ParentCategoryId" class="form-label fw-bold">
                                        <i class="bi bi-diagram-2 me-2"></i>Catégorie parente
                                    </label>
                                    <select asp-for="ParentCategoryId" class="form-select" asp-items="ViewBag.ParentCategoryId">
                                        <option value="">-- Aucune (catégorie racine) --</option>
                                    </select>
                                    <div class="form-text">Laissez vide pour créer une catégorie principale</div>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="UrlLogo" class="form-label fw-bold">
                                        <i class="bi bi-image me-2"></i>URL du logo
                                    </label>
                                    <input asp-for="UrlLogo" class="form-control" placeholder="https://exemple.com/logo.png" />
                                    <span asp-validation-for="UrlLogo" class="text-danger small"></span>
                                    <div class="form-text">URL vers l'image du logo de la catégorie</div>
                                </div>
                                
                                <div class="mb-4 form-check form-switch">
                                    <input name="IsActive" class="form-check-input" type="checkbox" role="switch" checked />
                                    <label class="form-check-label fw-bold">
                                        <i class="bi bi-toggle-on me-2"></i>Catégorie active
                                    </label>
                                    <div class="form-text">Décochez pour désactiver la catégorie (grâce au champ IsActive)</div>
                                </div>
                                
                                <div class="d-flex justify-content-between mt-4">
                                    <a asp-page="Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-circle me-1"></i> Créer la catégorie
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Activation de la validation Bootstrap
        (function () {
            'use strict'
            
            var forms = document.querySelectorAll('.needs-validation')
            
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
}

@section Styles {
    <style>
        .form-control, .form-select {
            border-radius: 0.375rem;
            transition: all 0.2s ease;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
            transform: translateY(-1px);
        }
        
        .btn {
            border-radius: 0.375rem;
            transition: all 0.2s ease;
            font-weight: 500;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }
        
        .form-text {
            font-size: 0.85em;
            color: #6c757d;
        }
        
        .card {
            border-radius: 0.75rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        
        .card-header {
            border-radius: 0.75rem 0.75rem 0 0 !important;
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        }
        
        .form-label {
            color: #495057;
            margin-bottom: 0.5rem;
        }
        
        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .alert {
            border-radius: 0.5rem;
            border: none;
        }
    </style>
}