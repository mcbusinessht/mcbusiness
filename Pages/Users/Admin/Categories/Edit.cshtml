@page "{id:int}"
@model MCBusiness.Pages_Users_Admin_Categories.EditModel
@using MCBusiness.Models

@{
    ViewData["Title"] = "Modifier la Catégorie";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-warning text-dark py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Index" class="btn btn-sm btn-light">
                            <i class="bi bi-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <form method="post" class="needs-validation" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
                                <input type="hidden" asp-for="Id" />
                                <!-- DateAdded géré par BaseEntity -->
                                
                                <div class="mb-4">
                                    <label asp-for="Name" class="form-label fw-bold">
                                        <i class="bi bi-tag me-2"></i>Nom de la catégorie <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" class="form-control" placeholder="Entrez le nom de la catégorie" required />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                    <div class="form-text">Le nom doit être unique et descriptif</div>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="Type" class="form-label fw-bold">
                                        <i class="bi bi-grid me-2"></i>Type de catégorie <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<CategoryType>()" required>
                                        <option value="">-- Sélectionnez un type --</option>
                                    </select>
                                    <span asp-validation-for="Type" class="text-danger small"></span>
                                    <div class="form-text">Définit le type d'éléments que contiendra cette catégorie</div>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="ParentCategoryId" class="form-label fw-bold">
                                        <i class="bi bi-diagram-2 me-2"></i>Catégorie parente
                                    </label>
                                    <select asp-for="ParentCategoryId" class="form-select" asp-items="ViewBag.ParentCategoryId">
                                        <option value="">-- Aucune (catégorie racine) --</option>
                                    </select>
                                    <div class="form-text">Laissez vide pour une catégorie principale</div>
                                </div>
                                
                                <div class="mb-4">
                                    <label asp-for="UrlLogo" class="form-label fw-bold">
                                        <i class="bi bi-image me-2"></i>URL du logo
                                    </label>
                                    <input asp-for="UrlLogo" class="form-control" placeholder="https://exemple.com/logo.png" />
                                    <span asp-validation-for="UrlLogo" class="text-danger small"></span>
                                    <div class="form-text">URL vers l'image du logo de la catégorie</div>
                                </div>
                                
                                <div class="mb-4 form-check form-switch">
                                    <input asp-for="IsDeleted" class="form-check-input" type="checkbox" role="switch" />
                                    <label asp-for="IsDeleted" class="form-check-label fw-bold">
                                        <i class="bi bi-archive me-2"></i>Catégorie désactivée
                                    </label>
                                    <div class="form-text">Si coché, la catégorie sera masquée dans l'interface</div>
                                </div>
                                
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>Informations</h6>
                                                <p class="card-text small mb-1">
                                                    <strong>ID:</strong> @Model.Id
                                                </p>
                                                <p class="card-text small mb-1">
                                                    <strong>Créée le:</strong> @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy HH:mm") <!-- Date gérée par BaseEntity -->
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between mt-4">
                                    <a asp-page="Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-1"></i> Annuler
                                    </a>
                                    <div>
                                        <button type="submit" class="btn btn-warning me-2">
                                            <i class="bi bi-check-circle me-1"></i> Modifier
                                        </button>
                                        <a asp-page="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                            <i class="bi bi-trash me-1"></i> Supprimer
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Activation de la validation Bootstrap
        (function () {
            'use strict'
            
            var forms = document.querySelectorAll('.needs-validation')
            
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
        
        // Amélioration de l'UX
        document.addEventListener('DOMContentLoaded', function() {
            // Focus sur le premier champ
            document.querySelector('form input:not([type="hidden"])').focus();
            
            // Confirmation avant suppression
            const deleteBtn = document.querySelector('.btn-outline-danger');
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function(e) {
                    if (!confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est irréversible.')) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}