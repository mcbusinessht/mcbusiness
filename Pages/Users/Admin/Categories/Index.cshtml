@page
@model MCBusiness.Pages_Users_Admin_Categories.IndexModel
@using MCBusiness.Models

@{
    ViewData["Title"] = "Gestion des Catégories";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial" />

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="bi bi-grid me-2"></i>@ViewData["Title"]
                        </h4>
                        <a asp-page="Create" class="btn btn-sm btn-light">
                            <i class="bi bi-plus-circle me-1"></i> Nouvelle Catégorie
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Statistiques -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Total</h6>
                                            <h4 class="mb-0">@Model.Category.Count</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-grid-3x3-gap fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Actives</h6>
                                            <h4 class="mb-0">@Model.Category.Count(c => !c.IsDeleted)</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-check-circle fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Désactivées</h6>
                                            <h4 class="mb-0">@Model.Category.Count(c => c.IsDeleted)</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-archive fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Principales</h6>
                                            <h4 class="mb-0">@Model.Category.Count(c => c.ParentCategoryId == null)</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="bi bi-diagram-2 fs-1 opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tableau -->
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>
                                        <i class="bi bi-tag me-1"></i>Nom
                                    </th>
                                    <th>
                                        <i class="bi bi-grid me-1"></i>Type
                                    </th>
                                    <th>
                                        <i class="bi bi-image me-1"></i>Logo
                                    </th>
                                    <th>
                                        <i class="bi bi-diagram-2 me-1"></i>Catégorie Parente
                                    </th>
                                    <th>
                                        <i class="bi bi-circle me-1"></i>Statut
                                    </th>
                                    <th>
                                        <i class="bi bi-calendar me-1"></i>Date de Création
                                    </th>
                                    <th class="text-center">
                                        <i class="bi bi-gear me-1"></i>Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Category)
                                {
                                    <tr class="@(item.IsDeleted ? "table-danger" : "")">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.UrlLogo))
                                                {
                                                    <img src="@item.UrlLogo" alt="Logo" class="rounded me-2" style="width: 30px; height: 30px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-secondary rounded me-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                                        <i class="bi bi-folder text-white"></i>
                                                    </div>
                                                }
                                                <strong>@item.Name</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@item.Type</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.UrlLogo))
                                            {
                                                <span class="badge bg-success">Avec logo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Sans logo</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.ParentCategory != null)
                                            {
                                                <span class="text-muted">@item.ParentCategory.Name</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Catégorie principale</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsDeleted)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i>Désactivée
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Active
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">@LocalTime.Format(item.CreatedAt, "dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Détails">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Message si vide -->
                    @if (!Model.Category.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <h4 class="text-muted mt-3">Aucune catégorie trouvée</h4>
                            <p class="text-muted">Commencez par créer votre première catégorie</p>
                            <a asp-page="Create" class="btn btn-primary mt-2">
                                <i class="bi bi-plus-circle me-1"></i> Créer une catégorie
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animation des lignes au survol
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'all 0.2s ease';
                    this.style.boxShadow = '0 4px 8px rgba(0,0,0,0.1)';
                });
                
                row.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = 'none';
                });
            });

            // Tooltips pour les boutons d'action
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}

@section Styles {
    <style>
        .card {
            border-radius: 1rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            border: none;
            margin-bottom: 1.5rem;
        }
        
        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border-bottom: none;
        }
        
        .table {
            border-radius: 0.75rem;
            overflow: hidden;
            margin-bottom: 0;
        }
        
        .table thead th {
            border-bottom: none;
            font-weight: 600;
            padding: 1rem 0.75rem;
        }
        
        .table tbody td {
            padding: 1rem 0.75rem;
            vertical-align: middle;
            border-color: #f8f9fa;
        }
        
        .table tbody tr:hover {
            background-color: #f8f9fa;
        }
        
        .btn {
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }
        
        .badge {
            border-radius: 0.375rem;
            font-weight: 500;
            padding: 0.35em 0.65em;
        }
        
        .table-responsive {
            border-radius: 0.75rem;
        }
        
        .bg-primary, .bg-success, .bg-warning, .bg-info {
            border: none;
        }
        
        @* .bg-primary { background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%) !important; } *@
        .bg-success { background: linear-gradient(135deg, #198754 0%, #146c43 100%) !important; }
        .bg-warning { background: linear-gradient(135deg, #ffc107 0%, #e6a400 100%) !important; }
        .bg-info { background: linear-gradient(135deg, #0dcaf0 0%, #0ba8c7 100%) !important; }
        
        .bi {
            font-size: 1.1em;
        }
        
        /* Responsive */
        @@media (max-width: 768px) {
            .card-body {
                padding: 1rem;
            }
            
            .table-responsive {
                font-size: 0.875rem;
            }
            
            .btn-group {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
            }
            
            .btn-group .btn {
                border-radius: 0.25rem;
            }
        }
    </style>
}
