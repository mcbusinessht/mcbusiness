@page
@model MCBusiness.Pages.Users.Admin.GestionRoles.IndexModel
@{
    ViewData["Title"] = "Gestion des Rôles SecondAdmin/Seller";
}

<div class="container-fluid ">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial"/>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title">
                        <i class="fas fa-user-tag me-2"></i>@ViewData["Title"]
                    </h3>
                </div>                                                 
                
                <div class="card-body">
                    <form method="post" class="mb-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Input.UserId" class="form-label"></label>
                                <select asp-for="Input.UserId" class="form-select">
                                    <option value="">-- Sélectionner un utilisateur --</option>
                                    @foreach (var user in Model.UsersWithRoles.OrderBy(c=>c.UserName))
                                    {
                                        <option value="@user.UserId">@user.UserName</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.UserId" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-3">
                                <label asp-for="Input.RoleName" class="form-label"></label>
                                <select asp-for="Input.RoleName" class="form-select">
                                    <option value="">-- Sélectionner un rôle --</option>
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <option value="@role.Value">@role.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.RoleName" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-3">
                                <label asp-for="Input.Action" class="form-label"></label>
                                <select asp-for="Input.Action" class="form-select">
                                    <option value="add">Ajouter le rôle</option>
                                    <option value="remove">Retirer le rôle</option>
                                </select>
                                <span asp-validation-for="Input.Action" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-save me-1"></i> Appliquer
                                </button>
                            </div>
                        </div>
                    </form>
                    
                    <hr>
                    
                    <h4 class="mb-3"><i class="fas fa-list me-2"></i>Assignations actuelles</h4>
                    
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Utilisateur</th>
                                    <th>Rôles</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.UsersWithRoles)
                                {
                                    <tr>
                                        <td>@user.UserName</td>
                                        <td>
                                            @if (user.Roles.Any())
                                            {
                                                @foreach (var role in user.Roles)
                                                {
                                                    <span class="badge bg-primary me-1">@role</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Aucun rôle</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>  
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('form').on('submit', function() {
                $('button[type="submit"]').prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Traitement...');
            });
        });
    </script>
}