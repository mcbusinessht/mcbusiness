@page
@model MCBusiness.Pages.Users.Admin.BankTransferPayments.ApproveModel
@using MCBusiness.Models;
@{
    ViewData["Title"] = "Approbation de virement";
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar -->
        <partial name="_AdminSidebarPartial"/>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-check-circle-fill me-2"></i>@ViewData["Title"]
                    </h4>
                </div>
                
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Détails du virement</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Utilisateur:</dt>
                                <dd class="col-sm-8">@Model.Transfer.User.FullName</dd>
                                
                                <dt class="col-sm-4">Montant:</dt>
                                <dd class="col-sm-8">@Model.Transfer.Amount.ToString("N2") @Model.Transfer.Currency?.Symbol</dd>
                                
                                <dt class="col-sm-4">Devise:</dt>
                                <dd class="col-sm-8">@Model.Transfer.Currency?.CurrencyBase</dd>
                                
                                <dt class="col-sm-4">Methode:</dt>
                                <dd class="col-sm-8">@Model.Transfer.TransferMethod</dd>
                                
                                <dt class="col-sm-4">Type:</dt>
                                <dd class="col-sm-8">@Model.Transfer.Direction</dd>

                                <dt class="col-sm-4">Date soumission:</dt>
                                <dd class="col-sm-8">@Model.Transfer.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                                
                                @if (!string.IsNullOrEmpty(Model.Transfer.ProofFilePath))
                                {
                                    <dt class="col-sm-4">Preuve de paiement:</dt>
                                    <dd class="col-sm-8">
                                        <a href="@Model.Transfer.ProofFilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-text"></i> Voir le document
                                        </a>
                                    </dd>
                                }
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <form method="post" enctype="multipart/form-data" data-critical="true">
                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label">Confirmez votre mot de passe</label>
                                    <input type="password" asp-for="Password" class="form-control" required>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                
                                <!-- Champ conditionnel pour la preuve d'adresse -->
                                @if (Model.Transfer.Direction == BankTransferDirection.Withdrawal)
                                {
                                    <div class="mb-3">
                                        <label asp-for="ProofFilePath" class="form-label">Preuve d'adresse (PDF ou image)</label>
                                        <input asp-for="ProofFilePath" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
                                        <small class="text-muted">Format acceptés: PDF, JPG, PNG (max 5MB)</small>
                                        <span asp-validation-for="ProofFilePath" class="text-danger"></span>
                                    </div>
                                }
                                
                                <div class="mb-3">
                                    <label asp-for="AdminComment" class="form-label">Commentaire (optionnel)</label>
                                    <textarea asp-for="AdminComment" class="form-control" rows="3"></textarea>
                                </div>
                                
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <span class="button-text"><i class="bi bi-check-circle-fill me-2"></i>Confirmer l'approbation</span>
                                        <span class="spinner-border spinner-border-sm d-none ms-2" role="status" aria-hidden="true"></span>
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle-fill me-2"></i>Annuler
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/anti-double-submit.js"></script>
}