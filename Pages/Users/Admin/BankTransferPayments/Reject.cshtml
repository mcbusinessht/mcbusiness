@page
@model MCBusiness.Pages.Users.Admin.BankTransferPayments.RejectModel
@{
    ViewData["Title"] = "Rejet de virement";
}

<div class="container-fluid px-4">
    <div class="row">
        <partial name="_AdminSidebarPartial" />

        <div class="col-lg-9">
            <div class="card mb-4">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-x-circle-fill me-2"></i>@ViewData["Title"]
                    </h4>
                </div>
                
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Détails du virement</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Utilisateur:</dt>
                                <dd class="col-sm-8">@Model.Transfer.User.FullName</dd>
                                <dt class="col-sm-4">Montant:</dt>
                                <dd class="col-sm-8 fw-bold">@Model.Transfer.Amount.ToString("N2") @Model.Transfer.Currency?.Symbol</dd>
                                <dt class="col-sm-4">Devise:</dt>
                                <dd class="col-sm-8">@Model.Transfer.Currency?.CurrencyBase</dd>
                                <dt class="col-sm-4">Type:</dt>
                                <dd class="col-sm-8">@Model.Transfer.TransferMethod</dd>
                            </dl>
                        </div>
                        
                        <div class="col-md-6">
                            <form method="post" data-critical="true">
                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label">Confirmez votre mot de passe</label>
                                    <input type="password" asp-for="Password" class="form-control" required>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="AdminComment" class="form-label">Commentaire</label>
                                    <textarea asp-for="AdminComment" class="form-control" rows="3" required></textarea>
                                    <span asp-validation-for="AdminComment" class="text-danger"></span>
                                </div>
                                
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-danger">
                                        <span class="button-text"><i class="bi bi-x-circle-fill me-2"></i>Confirmer le rejet</span>
                                        <span class="spinner-border spinner-border-sm d-none ms-2" role="status" aria-hidden="true"></span>
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left me-2"></i>Annuler
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Section Preuve -->
                    @if (!string.IsNullOrEmpty(Model.Transfer.ProofFilePath))
                    {
                        <div class="mt-4">
                            <h5>Preuve de transaction</h5>
                            <div class="border p-3 rounded">
                                <!-- Code d'affichage de la preuve identique à la page Details -->
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-header { padding: 1.5rem; }
        .form-label { font-weight: 500; }
        textarea { resize: vertical; }
    </style>
}

@section Scripts {
    <script src="~/js/anti-double-submit.js"></script>
}