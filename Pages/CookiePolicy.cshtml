@page
@model CookiePolicyModel
@using MCBusiness.Models
@{
    ViewData["Title"] = "Politique des Cookies";
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="bg-white rounded-lg shadow-lg p-8">
        <!-- En-tête -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">🍪 Politique des Cookies</h1>
            <p class="text-lg text-gray-600">
                Comprendre comment nous utilisons les cookies pour améliorer votre expérience sur MCBusiness
            </p>
            <p class="text-sm text-gray-500 mt-2">
                Dernière mise à jour : @LocalTime.Format(DateTimeOffset.UtcNow, "dd/MM/yyyy")
            </p>
        </div>

        <!-- Navigation rapide -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8">
            <h3 class="font-semibold text-blue-800 mb-2">Navigation rapide :</h3>
            <ul class="text-sm text-blue-600 space-y-1">
                <li><a href="#what-are-cookies" class="hover:underline">• Qu'est-ce que les cookies ?</a></li>
                <li><a href="#cookie-categories" class="hover:underline">• Types de cookies que nous utilisons</a></li>
                <li><a href="#cookie-list" class="hover:underline">• Liste détaillée des cookies</a></li>
                <li><a href="#manage-cookies" class="hover:underline">• Comment gérer vos préférences</a></li>
                <li><a href="#your-rights" class="hover:underline">• Vos droits</a></li>
            </ul>
        </div>

        <!-- Qu'est-ce que les cookies -->
        <section id="what-are-cookies" class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b-2 border-blue-500 pb-2">
                Qu'est-ce que les cookies ?
            </h2>
            <div class="prose text-gray-600">
                <p class="mb-4">
                    Les cookies sont de petits fichiers texte qui sont stockés sur votre ordinateur, tablette ou smartphone 
                    lorsque vous visitez un site web. Ils permettent au site de se souvenir de vos actions et préférences 
                    (comme la langue, la taille de police et d'autres préférences d'affichage) pendant une certaine période.
                </p>
                <p class="mb-4">
                    Chez <strong>MCBusiness</strong>, nous utilisons les cookies pour :
                </p>
                <ul class="list-disc list-inside ml-4 space-y-2">
                    <li>Maintenir votre session de connexion</li>
                    <li>Mémoriser le contenu de votre panier</li>
                    <li>Personnaliser votre expérience</li>
                    <li>Analyser l'utilisation du site pour l'améliorer</li>
                    <li>Afficher des contenus pertinents</li>
                </ul>
            </div>
        </section>

        <!-- Types de cookies -->
        <section id="cookie-categories" class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b-2 border-blue-500 pb-2">
                Types de cookies que nous utilisons
            </h2>
            
            <div class="grid gap-6 md:grid-cols-2">
                <!-- Cookies essentiels -->
                <div class="border border-green-200 rounded-lg p-4 bg-green-50">
                    <div class="flex items-center mb-2">
                        <span class="text-2xl mr-2">🔒</span>
                        <h3 class="text-lg font-semibold text-green-800">Cookies Essentiels</h3>
                    </div>
                    <p class="text-sm text-green-700 mb-2">
                        <strong>Toujours activés</strong> - Nécessaires au fonctionnement du site
                    </p>
                    <ul class="text-xs text-green-600 space-y-1">
                        <li>• Authentification et sécurité</li>
                        <li>• Maintien de session</li>
                        <li>• Fonctionnalités de base du panier</li>
                        <li>• Prévention des attaques CSRF</li>
                    </ul>
                </div>

                <!-- Cookies fonctionnels -->
                <div class="border border-blue-200 rounded-lg p-4 bg-blue-50">
                    <div class="flex items-center mb-2">
                        <span class="text-2xl mr-2">⚙️</span>
                        <h3 class="text-lg font-semibold text-blue-800">Cookies Fonctionnels</h3>
                    </div>
                    <p class="text-sm text-blue-700 mb-2">
                        <strong>Optionnels</strong> - Améliorent votre expérience
                    </p>
                    <ul class="text-xs text-blue-600 space-y-1">
                        <li>• Préférences de langue</li>
                        <li>• Thème sombre/clair</li>
                        <li>• Sauvegarde du panier étendue</li>
                        <li>• Préférences de navigation</li>
                    </ul>
                </div>

                <!-- Cookies analytiques -->
                <div class="border border-orange-200 rounded-lg p-4 bg-orange-50">
                    <div class="flex items-center mb-2">
                        <span class="text-2xl mr-2">📊</span>
                        <h3 class="text-lg font-semibold text-orange-800">Cookies Analytiques</h3>
                    </div>
                    <p class="text-sm text-orange-700 mb-2">
                        <strong>Optionnels</strong> - Nous aident à améliorer le site
                    </p>
                    <ul class="text-xs text-orange-600 space-y-1">
                        <li>• Statistiques de visite (anonymisées)</li>
                        <li>• Pages les plus visitées</li>
                        <li>• Temps passé sur le site</li>
                        <li>• Taux de rebond</li>
                    </ul>
                </div>

                <!-- Cookies performance -->
                <div class="border border-purple-200 rounded-lg p-4 bg-purple-50">
                    <div class="flex items-center mb-2">
                        <span class="text-2xl mr-2">⚡</span>
                        <h3 class="text-lg font-semibold text-purple-800">Cookies Performance</h3>
                    </div>
                    <p class="text-sm text-purple-700 mb-2">
                        <strong>Optionnels</strong> - Optimisent la vitesse du site
                    </p>
                    <ul class="text-xs text-purple-600 space-y-1">
                        <li>• Cache des ressources</li>
                        <li>• Optimisation du chargement</li>
                        <li>• Mesure des performances</li>
                        <li>• Réduction des temps de réponse</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Liste détaillée des cookies -->
        <section id="cookie-list" class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b-2 border-blue-500 pb-2">
                Liste détaillée des cookies
            </h2>
            
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white border border-gray-300 rounded-lg overflow-hidden">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Nom du Cookie</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Objectif</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Durée</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Catégorie</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Fournisseur</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cookie in Model.CookieInformation)
                        {
                            <tr class="border-b border-gray-200 hover:bg-gray-50">
                                <td class="px-4 py-2 font-mono text-sm">@cookie.Name</td>
                                <td class="px-4 py-2 text-sm">@cookie.Purpose</td>
                                <td class="px-4 py-2 text-sm">@cookie.Duration</td>
                                <td class="px-4 py-2">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                        @(cookie.Category switch {
                                            CookieCategory.Essential => "bg-green-100 text-green-800",
                                            CookieCategory.Functional => "bg-blue-100 text-blue-800", 
                                            CookieCategory.Analytics => "bg-orange-100 text-orange-800",
                                            CookieCategory.Performance => "bg-purple-100 text-purple-800",
                                            CookieCategory.Marketing => "bg-red-100 text-red-800",
                                            _ => "bg-gray-100 text-gray-800"
                                        })">
                                        @cookie.Category.ToString()
                                    </span>
                                </td>
                                <td class="px-4 py-2 text-sm">
                                    @cookie.Provider
                                    @if (cookie.IsThirdParty)
                                    {
                                        <span class="text-xs text-red-600">(Tiers)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Gérer les préférences -->
        <section id="manage-cookies" class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b-2 border-blue-500 pb-2">
                Comment gérer vos préférences
            </h2>
            
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
                <h3 class="font-semibold text-blue-800 mb-3">🎛️ Centre de préférences MCBusiness</h3>
                <p class="text-blue-700 mb-4">
                    Vous pouvez modifier vos préférences de cookies à tout moment en utilisant notre centre de préférences.
                </p>
                <button id="openCookieSettings" 
                        class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    🍪 Gérer mes préférences
                </button>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
                <div class="border border-gray-200 rounded-lg p-4">
                    <h3 class="font-semibold text-gray-800 mb-2">Via votre navigateur</h3>
                    <p class="text-sm text-gray-600 mb-2">
                        Vous pouvez également gérer les cookies directement depuis votre navigateur :
                    </p>
                    <ul class="text-sm text-gray-600 space-y-1">
                        <li>• <strong>Chrome :</strong> Paramètres > Confidentialité et sécurité > Cookies</li>
                        <li>• <strong>Firefox :</strong> Options > Vie privée et sécurité</li>
                        <li>• <strong>Safari :</strong> Préférences > Confidentialité</li>
                        <li>• <strong>Edge :</strong> Paramètres > Cookies et autorisations de site</li>
                    </ul>
                </div>

                <div class="border border-gray-200 rounded-lg p-4">
                    <h3 class="font-semibold text-gray-800 mb-2">Conséquences de la désactivation</h3>
                    <p class="text-sm text-gray-600 mb-2">
                        Si vous désactivez certains cookies :
                    </p>
                    <ul class="text-sm text-gray-600 space-y-1">
                        <li>• Vous devrez vous reconnecter à chaque visite</li>
                        <li>• Votre panier pourra être vidé</li>
                        <li>• Vos préférences ne seront pas sauvegardées</li>
                        <li>• Certaines fonctionnalités peuvent être limitées</li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- Vos droits -->
        <section id="your-rights" class="mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b-2 border-blue-500 pb-2">
                Vos droits selon le RGPD
            </h2>
            
            <div class="bg-green-50 border border-green-200 rounded-lg p-6">
                <div class="grid gap-4 md:grid-cols-2">
                    <div>
                        <h3 class="font-semibold text-green-800 mb-2">✅ Droit à l'information</h3>
                        <p class="text-sm text-green-700">
                            Vous avez le droit de savoir quels cookies sont utilisés et pourquoi.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-semibold text-green-800 mb-2">🎯 Droit au choix</h3>
                        <p class="text-sm text-green-700">
                            Vous pouvez accepter ou refuser les cookies non-essentiels.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-semibold text-green-800 mb-2">🔄 Droit de retrait</h3>
                        <p class="text-sm text-green-700">
                            Vous pouvez retirer votre consentement à tout moment.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-semibold text-green-800 mb-2">📧 Droit de contact</h3>
                        <p class="text-sm text-green-700">
                            Contactez-nous pour toute question sur les cookies.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section class="bg-gray-50 rounded-lg p-6 text-center">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">❓ Questions sur notre politique cookies ?</h3>
            <p class="text-gray-600 mb-4">
                Notre équipe est à votre disposition pour répondre à vos questions.
            </p>
            <a href="/Contact" 
               class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                📧 Nous contacter
            </a>
        </section>
    </div>
</div>

<style>
    .prose p { margin-bottom: 1rem; }
    .prose ul { margin-bottom: 1rem; }
    html { scroll-behavior: smooth; }
</style>

<script>
    document.getElementById('openCookieSettings').addEventListener('click', function() {
        // Ouvrir le gestionnaire de cookies
        if (window.cookieManager) {
            window.cookieManager.showSettings();
        } else {
            window.location.href = '/CookieSettings';
        }
    });
</script>