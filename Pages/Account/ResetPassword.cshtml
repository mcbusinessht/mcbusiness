@page
@model MCBusiness.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Réinitialisation du mot de passe";
}

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-60 mb-5">
    <div class="col-xl-4 col-lg-5 col-md-7 col-sm-10 col-12">
        <div class="card border-0 shadow-lg overflow-hidden" id="resetPasswordCard">
            <!-- Card Header with Gradient Background -->
            <div class="card-header bg-primary text-white py-4 position-relative overflow-hidden">
                <div class="position-absolute w-100 h-100 top-0 start-0" style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 50%);"></div>
                <h4 class="text-center mb-0 position-relative">Réinitialiser votre mot de passe</h4>
            </div>
            
            <!-- Card Body -->
            <div class="card-body p-4">
                <form method="post" id="resetPasswordForm" onsubmit="return validateForm()">
                    <input type="hidden" name="Input.Token" value="@Model.Input.Token" />
                    
                    <!-- Email Field (readonly) -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-bold">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope-fill text-primary"></i></span>
                            <input type="email" name="Input.Email" class="form-control" value="@Model.Input.Email" required readonly />
                        </div>
                    </div>
                    
                    <!-- New Password Field -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-bold">Nouveau mot de passe</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-primary"></i></span>
                            <input type="password" name="Input.Password" class="form-control" id="password" 
                                   required placeholder="Entrez votre nouveau mot de passe" onkeyup="validatePassword()" />
                            <button class="btn btn-outline-secondary toggle-password" type="button">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small d-block mt-1"></span>
                        <div id="passwordError" class="text-danger small"></div>
                        
                        <!-- Password Indicators -->
                        <div class="row mt-2 g-2" id="passwordIndicators">
                            <div class="col-6">
                                <span id="length" class="badge d-flex align-items-center">
                                    <span class="indicator-icon me-1">🔴</span>
                                    <span class="indicator-text">8 caractères</span>
                                </span>
                            </div>
                            <div class="col-6">
                                <span id="uppercase" class="badge d-flex align-items-center">
                                    <span class="indicator-icon me-1">🔴</span>
                                    <span class="indicator-text">Majuscule</span>
                                </span>
                            </div>
                            <div class="col-6">
                                <span id="lowercase" class="badge d-flex align-items-center">
                                    <span class="indicator-icon me-1">🔴</span>
                                    <span class="indicator-text">Minuscule</span>
                                </span>
                            </div>
                            <div class="col-6">
                                <span id="number" class="badge d-flex align-items-center">
                                    <span class="indicator-icon me-1">🔴</span>
                                    <span class="indicator-text">Chiffre</span>
                                </span>
                            </div>
                            <div class="col-6">
                                <span id="specialChar" class="badge d-flex align-items-center">
                                    <span class="indicator-icon me-1">🔴</span>
                                    <span class="indicator-text">Spécial</span>
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Confirm Password Field -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-bold">Confirmer le mot de passe</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-primary"></i></span>
                            <input type="password" name="Input.ConfirmPassword" class="form-control" 
                                   required placeholder="Confirmez votre mot de passe" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>
                    
                    <!-- Submit Button -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill py-2 fw-bold" id="resetButton">
                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            Réinitialiser <i class="bi bi-arrow-repeat ms-2"></i>
                        </button>
                    </div>
                    
                    <!-- Success Message -->
                    @if(ModelState.ContainsKey("PasswordSuccessKey")) {
                        <div class="alert alert-success animate__animated animate__fadeIn">
                            <i class="bi bi-check2-circle me-2"></i> 
                            @ModelState["PasswordSuccessKey"].Errors[0].ErrorMessage
                            <div id="countdown" class="fw-bold mt-2">
                                Redirection dans <span id="seconds">5</span> secondes...
                            </div>
                        </div>
                    }
                    
                    <!-- Error Messages -->
                    @if (ModelState.ErrorCount > 0 && !ModelState.ContainsKey("PasswordSuccessKey")) {
                        <div class="alert alert-danger mt-3 animate__animated animate__shakeX">
                            @foreach (var error in ModelState
                             .Where(m => m.Key != "PasswordSuccessKey")
                             .SelectMany(m => m.Value.Errors)) {
                                <p class="mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>@error.ErrorMessage</p>
                            }
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        #resetPasswordCard {
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        #resetPasswordCard:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
        }
        
        .card-header {
            border-radius: 0 !important;
        }
        
        .toggle-password {
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .toggle-password:hover {
            background-color: #f8f9fa;
        }
        
        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
            transform: translateY(-2px);
        }
        
        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        
        .input-group-text {
            transition: all 0.3s ease;
        }
        
        .input-group:focus-within .input-group-text {
            background-color: #e9ecef;
        }
        
        .badge {
            padding: 0.35em 0.65em;
            font-size: 0.75em;
            font-weight: 500;
            background-color: #f8f9fa;
        }
        
        .indicator-icon {
            font-size: 0.9em;
        }
        
        .indicator-text {
            font-size: 0.8em;
        }
        
        .text-success .indicator-icon {
            content: "🟢";
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle password visibility
            const togglePassword = document.querySelector('.toggle-password');
            const password = document.querySelector('#password');
            
            if (togglePassword && password) {
                togglePassword.addEventListener('click', function() {
                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                    password.setAttribute('type', type);
                    this.querySelector('i').classList.toggle('bi-eye-fill');
                    this.querySelector('i').classList.toggle('bi-eye-slash-fill');
                });
            }
            
            // Countdown for success message
            if (document.getElementById('countdown')) {
                let seconds = 5;
                const countdownElement = document.getElementById('seconds');
                
                const interval = setInterval(() => {
                    seconds--;
                    countdownElement.textContent = seconds;
                    
                    if (seconds <= 0) {
                        clearInterval(interval);
                        window.location.href = "../Users/User/Dashboard";
                    }
                }, 1000);
            }
        });
        
        function validateForm() {
            let isValid = true;
            document.getElementById('passwordError').innerText = '';
            const password = document.getElementById('password').value;
            
            if (!isPasswordStrong(password)) {
                document.getElementById('passwordError').innerText = 'Le mot de passe ne respecte pas les critères requis';
                isValid = false;
            }
            
            if (isValid) {
                const button = document.getElementById('resetButton');
                const spinner = button.querySelector('.spinner-border');
                spinner.classList.remove('d-none');
                button.disabled = true;
            }
            
            return isValid;
        }
        
        function validatePassword() {
            const password = document.getElementById('password').value;
            
            // Check criteria
            const checks = {
                length: password.length >= 8,
                uppercase: /[A-Z]/.test(password),
                lowercase: /[a-z]/.test(password),
                number: /[0-9]/.test(password),
                specialChar: /[^a-zA-Z0-9]/.test(password)
            };
            
            // Update indicators
            Object.keys(checks).forEach(key => {
                updateIndicator(key, checks[key]);
            });
        }
        
        function updateIndicator(id, isValid) {
            const element = document.getElementById(id);
            if (!element) return;
            
            const icon = element.querySelector('.indicator-icon');
            if (isValid) {
                element.classList.add('text-success');
                element.classList.remove('text-danger');
                icon.textContent = '🟢';
            } else {
                element.classList.add('text-danger');
                element.classList.remove('text-success');
                icon.textContent = '🔴';
            }
        }
        
        function isPasswordStrong(password) {
            return password.length >= 8 &&
                   /[A-Z]/.test(password) &&
                   /[a-z]/.test(password) &&
                   /[0-9]/.test(password) &&
                   /[^a-zA-Z0-9]/.test(password);
        }
    </script>
} 