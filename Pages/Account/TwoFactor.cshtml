@page
@model MCBusiness.Pages.Account.TwoFactorModel
@{
    ViewData["Title"] = "Vérification 2FA";
    Layout = "~/Pages/Shared/_MinimalLayout.cshtml";
}

<div class="row position-absolute top-50 start-50 translate-middle w-100 ">
    <div class="col-md-6 col-sm-8 col-xs-10 mx-auto my-auto p-4 mt-4" id=boxSignUp>       
        <h4 class="text-center mb-3">Vérification à deux facteurs</h4>
        <p>Un code d'authentification a été envoyé à votre adresse email</p>
        <form method="post" asp-page="/Account/TwoFactor">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-group">
                <label for="Code" class="form-label">Code de vérification</label>
                <input asp-for="Code" class="form-control" required
                       placeholder="Saisissez le code ici" maxlength="6"
                       inputmode="numeric" autocomplete="one-time-code"
                       pattern="[0-9]{6}" />
                <small class="text-muted">Le code est valide pendant une durée limitée.</small>
            </div>
            <div class="text-center mt-3">
                <button type="submit" class="btn btn-primary w-50">Vérifier</button>
            </div>
        </form>

        <div class="text-center mt-3">
            <form method="post" asp-page="/Account/TwoFactor" asp-page-handler="Resend"
                  id="resendForm" style="display: inline;">
                <input type="hidden" asp-for="ReturnUrl" />
                <button type="submit" class="btn btn-outline-secondary btn-sm" id="resendBtn" 
                        @(!Model.CanResend ? "disabled" : "")>
                    Renvoyer le code
                </button>
            </form>
            <div id="cooldownMessage" class="text-muted small mt-2" style="display: @(!Model.CanResend ? "block" : "none");">
                Nouveau code disponible dans <span id="countdown">@Model.RetryAfterSeconds</span> secondes
            </div>
        </div>

        <script>
            let cooldownActive = @(!Model.CanResend ? "true" : "false");
            let countdown = @Model.RetryAfterSeconds;
            
            if (cooldownActive) {
                startCooldown();
            }
            
            function startCooldown() {
                const resendBtn = document.getElementById('resendBtn');
                const cooldownDiv = document.getElementById('cooldownMessage');
                const countdownSpan = document.getElementById('countdown');
                
                resendBtn.disabled = true;
                cooldownDiv.style.display = 'block';
                
                const timer = setInterval(() => {
                    countdown--;
                    countdownSpan.textContent = countdown;
                    
                    if (countdown <= 0) {
                        clearInterval(timer);
                        resendBtn.disabled = false;
                        cooldownDiv.style.display = 'none';
                        countdown = 0;
                    }
                }, 1000);
            }
            
            // Start cooldown after resend button click
            document.getElementById('resendForm').addEventListener('submit', function() {
                setTimeout(() => {
                    if (!document.querySelector('.alert-danger')) { // Only if no error
                        cooldownActive = true;
                        countdown = 30;
                        startCooldown();
                    }
                }, 100);
            });
        </script>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mt-3">
                @Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success mt-3">
                @Model.SuccessMessage
            </div>
        }

        @if (ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger mt-3">
                @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }
    </div>
</div>
