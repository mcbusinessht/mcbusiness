@page
@model MCBusiness.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Réinitialisation du mot de passe";
}

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-60 mb-5">
    <div class="col-xl-4 col-lg-5 col-md-7 col-sm-10 col-12">
        <div class="card border-0 shadow-lg overflow-hidden" id="loginCard">
            <!-- Card Header with Gradient Background -->
            <div class="card-header bg-primary text-white py-4 position-relative overflow-hidden">
                <div class="position-absolute w-100 h-100 top-0 start-0" style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 50%);"></div>
                <h4 class="text-center mb-0 position-relative">Réinitialisation du mot de passe</h4>
            </div>
            
            <!-- Card Body -->
            <div class="card-body p-4">
                <form method="post" id="forgotPasswordForm">
                    @if (ModelState.ContainsKey("CustomSuccessKey"))
                    {
                        <div class="alert alert-success mb-4 animate__animated animate__fadeIn">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @ModelState["CustomSuccessKey"].Errors[0].ErrorMessage
                        </div>
                    }
                    
                    <div class="form-group mb-4">
                        <label asp-for="Input.Email" class="form-label fw-bold">Adresse email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope-fill text-primary"></i></span>
                            <input asp-for="Input.Email" class="form-control" 
                                   placeholder="Entrez votre adresse email" required />
                        </div>
                        @if (ModelState.ContainsKey("CustomErrorKey"))
                        {
                            <div class="invalid-feedback d-block">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @ModelState["CustomErrorKey"].Errors[0].ErrorMessage
                            </div>
                        }
                        <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
                    </div>
                    
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Un lien de réinitialisation vous sera envoyé par email.
                    </div>
                    
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill py-2 fw-bold">
                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            Envoyer le lien <i class="bi bi-send-fill ms-2"></i>
                        </button>
                    </div>
                    
                    <div class="text-center">
                        <a asp-page="../Account/Login" class="text-decoration-none text-muted">
                            <i class="bi bi-arrow-left me-2"></i>Retour à la connexion
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Reuse the same styles from login page */
    #loginCard {
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    #loginCard:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
    }
    
    .card-header {
        border-radius: 0 !important;
    }
    
    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
        transition: all 0.3s ease;
    }
    
    .btn-primary:hover {
        background-color: #0b5ed7;
        border-color: #0a58ca;
        transform: translateY(-2px);
    }
    
    .form-control:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    .input-group-text {
        transition: all 0.3s ease;
    }
    
    .input-group:focus-within .input-group-text {
        background-color: #e9ecef;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('forgotPasswordForm');
            if (form) {
                form.addEventListener('submit', function() {
                    // Show loading spinner
                    const button = this.querySelector('button[type="submit"]');
                    const spinner = button.querySelector('.spinner-border');
                    spinner.classList.remove('d-none');
                    button.disabled = true;
                });
            }
        });
    </script> 
}