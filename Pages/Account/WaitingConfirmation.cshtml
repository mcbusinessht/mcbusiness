@page
@model MCBusiness.Pages.Account.WaitingConfirmation
@{
    ViewData["Title"] = "Confirmation en cours";
    Layout = "~/Pages/Shared/_MinimalLayout.cshtml";

}

<div class="min-h-screen flex items-center justify-center bg-[#005fac] px-4 py-12">
    <div class="max-w-sm  col-md-6 mx-auto text-center ">
        <!-- Enveloppe animée -->
        <div class="text-[#005fac] text-5xl animate-bounce">
            <i class="bi bi-envelope fs-3"></i>
        </div>

        <h1 class=" text-primary">Confirmation requise</h1>
        
        <p class="text-gray-600">
            Un email de confirmation a été envoyé à 
            <strong class="text-[#005fac]">@Model.Email</strong>.
        </p>
        
        <div class="text-left">
            <h3 class="text-lg font-semibold mb-2 text-gray-700">Instructions :</h3>
            <ol class=" col-sm-7 col-md-6 col-lg-6 mx-auto text-start  ">   
                <li>Ouvrez votre boîte email</li>        
                <li>Recherchez l'email de <strong>MC Business</strong></li>
                <li>Cliquez sur le lien "Confirmer mon email"</li>
            </ol>
            <p class="text-sm text-[#005fac] mt-2">
                <i class="fas fa-exclamation-circle mr-1"></i> Vérifiez vos spams si vous ne trouvez pas l'email
            </p>
        </div>

        <!-- Compte à rebours -->
        <div id="countdown" class="bg-blue-50 rounded-lg p-3 text-center">
            <p class="text-sm text-gray-600">
                <i class="fas fa-clock mr-2 text-[#005fac]"></i>
                Lien valide 24h - Renvoi possible dans <span id="timer" class="font-bold text-[#005fac]">60</span>s
            </p>
        </div>

        <!-- Bouton de renvoi -->
        <button id="resendBtn" class="hidden w-full bg-[#005fac] hover:bg-[#16365c] text-white font-medium py-2 px-4 rounded-lg transition duration-200 btn-primary">
            <i class="fas fa-redo mr-2"></i>Renvoyer l'email
        </button>

        <!-- Barre de progression -->
        <div id="progressBar" class="h-1.5 bg-gray-200 rounded-full overflow-hidden">
            <div id="progress" class="h-full bg-[#005fac] rounded-full" style="width: 100%"></div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row justify-center gap-3 pt-4">
            
            <a href="/Account/Login" class=" btn flex-1 px-4 py-2 border border-[#005fac] text-[#005fac] rounded-lg hover:bg-blue-50 transition flex items-center justify-center">
                <i class="fas fa-sign-in-alt mr-2"></i> Se connecter <i class="bi bi-box-arrow-right"></i>  
            </a>
        </div>

        <!-- Support -->
        <p class="text-xs text-gray-500 mt-4">
            Vous rencontrez un problème ? <a href="mailto:support@mcbusinessht.com" class="text-[#005fac] hover:underline">Contactez-nous</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        // Countdown avec barre de progression
        let timeLeft = 60;
        const timerElement = document.getElementById('timer');
        const resendBtn = document.getElementById('resendBtn');
        const progressBar = document.getElementById('progress');

        const updateProgress = () => {
            const progress = (timeLeft / 60) * 100;
            progressBar.style.width = `${progress}%`;
        };

        const countdown = setInterval(() => {
            timeLeft--;
            timerElement.textContent = timeLeft;
            updateProgress();

            if (timeLeft <= 0) {
                clearInterval(countdown);
                document.getElementById('countdown').classList.add('hidden');
                resendBtn.classList.remove('hidden');
            }
        }, 1000);

        // Gestion du renvoi
        resendBtn.addEventListener('click', function() {
            fetch('/Account/ResendConfirmation?email=@Model.Email')
                .then(response => {
                    if (response.ok) {
                        // Notification
                        const alert = document.createElement('div');
                        alert.className = 'fixed top-4 right-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-lg';
                        alert.innerHTML = `
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-2"></i>
                                <span>Email renvoyé avec succès !</span>
                            </div>
                        `;
                        document.body.appendChild(alert);
                        setTimeout(() => alert.remove(), 5000);

                        // Réinitialisation
                        timeLeft = 60;
                        timerElement.textContent = timeLeft;
                        document.getElementById('countdown').classList.remove('hidden');
                        resendBtn.classList.add('hidden');
                        updateProgress();
                        
                        const newCountdown = setInterval(() => {
                            timeLeft--;
                            timerElement.textContent = timeLeft;
                            updateProgress();

                            if (timeLeft <= 0) {
                                clearInterval(newCountdown);
                                document.getElementById('countdown').classList.add('hidden');
                                resendBtn.classList.remove('hidden');
                            }
                        }, 1000);
                    }
                });
        });
    </script>
}  