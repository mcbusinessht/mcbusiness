@page "{id:int?}"
@model MCBusiness.Pages.Companies.DetailsModel

@{
    ViewData["Title"] = Model.Company.Name;
}

<div class="container py-5 company-detail">
    <div class="row">
        <!-- En-tête -->
        <div class="col-12 mb-4">
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(Model.Company.UrlLogo))
                {
                    <img src="@Model.Company.UrlLogo" alt="@Model.Company.Name logo" 
                         class="rounded-circle me-4" style="width: 80px; height: 80px; object-fit: contain;">
                }
                <div>
                    <h1 class="h3 mb-1">@Model.Company.Name</h1>
                    
                    <!-- Correction : Affichage des secteurs -->
                    <div class="mb-2">
                        @{
                            var primarySector = Model.GetPrimarySector();
                            var allSectors = Model.GetAllSectors();
                        }
                        
                        @if (primarySector != null)
                        {
                            <span class="badge bg-primary">@primarySector.Name</span>
                        }
                        
                        @if (allSectors.Count > 1)
                        {
                            <span class="badge bg-secondary">+ @(allSectors.Count - 1) autre(s)</span>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.Company.WebSite))
                    {
                        <a href="@Model.Company.WebSite" target="_blank" class="btn btn-sm btn-outline-primary me-2">
                            <i class="bi bi-box-arrow-up-right"></i> Site officiel
                        </a>
                    }
                    
                    <!-- Affichage de l'adresse -->
                    @if (Model.Company.PrimaryAddress != null)
                    {
                        <span class="text-muted">
                            <i class="bi bi-geo-alt"></i>
                            @Model.Company.PrimaryAddress.City?.Name, @Model.Company.PrimaryAddress.Country?.Name
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Description et secteurs -->
        <div class="col-lg-8 mb-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">À propos</h2>
                    <p>@(string.IsNullOrEmpty(Model.Company.Description) ? "Aucune description disponible." : Model.Company.Description)</p>
                    
                    <!-- Affichage détaillé des secteurs -->
                    @if (Model.GetAllSectors().Any())
                    {
                        <div class="mt-4">
                            <h3 class="h6 mb-2">Secteurs d'activité</h3>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var sector in Model.GetAllSectors())
                                {
                                    <span class="badge bg-light text-dark border">
                                        @sector.Name
                                        @if (sector.Id == Model.GetPrimarySector()?.Id)
                                        {
                                            <i class="bi bi-star-fill text-warning ms-1"></i>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Informations de contact -->
        <div class="col-lg-4 mb-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="h6 mb-3">Informations</h3>
                    
                    @if (Model.Company.PrimaryAddress != null)
                    {
                        <div class="mb-3">
                            <strong><i class="bi bi-geo-alt text-primary me-2"></i>Adresse</strong>
                            <p class="mb-0 small">@Model.Company.PrimaryAddress.Line1</p>
                            @if (!string.IsNullOrEmpty(Model.Company.PrimaryAddress.Line2))
                            {
                                <p class="mb-0 small">@Model.Company.PrimaryAddress.Line2</p>
                            }
                            <p class="mb-0 small">
                                @Model.Company.PrimaryAddress.City?.Name, 
                                @Model.Company.PrimaryAddress.State?.Name
                                @Model.Company.PrimaryAddress.ZipCode
                            </p>
                        </div>
                    }
                    
                    <div class="mb-3">
                        <strong><i class="bi bi-telephone text-primary me-2"></i>Téléphone</strong>
                        <p class="mb-0 small">@Model.Company.PhoneNumber</p>
                    </div>
                    
                    <div class="mb-3">
                        <strong><i class="bi bi-envelope text-primary me-2"></i>Email</strong>
                        <p class="mb-0 small">@Model.Company.Email</p>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.Company.WebSite))
                    {
                        <div>
                            <strong><i class="bi bi-globe text-primary me-2"></i>Site web</strong>
                            <p class="mb-0 small">
                                <a href="@Model.Company.WebSite" target="_blank">@Model.Company.WebSite</a>
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sous-catégories -->
        @if (Model.SubCategories.Any())
        {
            <div class="col-12 mb-4">
                <h2 class="h4 mb-3">Catégories de produits</h2>
                <div class="row g-3">
                    @foreach (var category in Model.SubCategories)
                    {
                        <div class="col-md-3 col-6">
                            <div class="card h-100 border-0 shadow-sm hover-effect">
                                <div class="card-body text-center">
                                    <i class="bi bi-tag" style="font-size: 2rem; color: #0d6efd;"></i>
                                    <h3 class="h6 mt-2 mb-0">@category.Name</h3>
                                    <small class="text-muted">@category.Products.Count produits</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Produits -->
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h4 mb-0">Produits récents</h2>
                @if (Model.FeaturedProducts.Count >= 8)
                {
                    <a asp-page="/Shop/Categories/Index" asp-route-companyId="@Model.Company.Id" 
                       class="btn btn-outline-primary btn-sm">
                        Voir tous les produits
                    </a>
                }
            </div>
            
            @if (Model.FeaturedProducts.Any())
            {
                <div class="row g-4">
                    @foreach (var product in Model.FeaturedProducts)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="card h-100 border-0 shadow-sm hover-effect">
                                <div class="card-body">
                                    <h3 class="h6 card-title">@product.Name</h3>
                                    <div class="text-muted small mb-2">
                                        @product.Category?.Name
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="text-primary fw-bold">
                                            @if (product.Variants?.Any(v => !v.IsDeleted) == true)
                                            {
                                                var minPrice = product.Variants.Where(v => !v.IsDeleted).Min(v => v.Price);
                                                @minPrice.ToString("C0") <span>HTG</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Prix non disponible</span>
                                            }
                                        </div>
                                        <a asp-page="/Shop/Categories/Products/Details/Index" 
                                           asp-route-id="@product.Id" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-info-circle"></i>
                                        </a> 
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #6c757d;"></i>
                    <h4 class="mt-3">Aucun produit disponible</h4>
                    <p class="text-muted">Cette entreprise n'a pas encore publié de produits.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hover-effect {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-effect:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1)!important;
        }
        .company-detail .badge {
            font-weight: normal;
        }
        .card-title {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}